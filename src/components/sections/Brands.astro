---
/** Restored original Brand Worlds design with dynamic API brand data. */
import type { Locale, PublicBrand } from '../../lib/api/types';
import { localePath } from '../../lib/content';
import { toVisualBrands } from '../../lib/visual/legacy-view';
import { dictionary, formatMessage } from '../../i18n';

interface Props { locale: Locale; brands: PublicBrand[]; }
const { locale, brands: sourceBrands = [] } = Astro.props;
const brands = toVisualBrands(sourceBrands, locale);
const copy = dictionary(locale);
const labels = copy.home.brands;
const brandIcons: Record<string, string> = {
  cnc: 'M12 3 5 6v5c0 5 3 8.5 7 10 4-1.5 7-5 7-10V6l-7-3Zm0 6v6m0 3h.01',
  liper: 'M9 21h6m-5-4h4m-7-6a5 5 0 1 1 10 0c0 2-1.5 3.2-2.7 4.2-.8.7-1.3 1.3-1.3 2.3h-2c0-1-.5-1.6-1.3-2.3C8.5 14.2 7 13 7 11Z',
};
const brandSteps: Record<string, string> = { cnc: '01', liper: '02' };
---
<section class="section bw-section theme-inverse" id="brands">
  <!-- Ambient background -->
  <div class="bw-bg" aria-hidden="true">
    <div class="bw-bg__gradient"></div>
    <div class="bw-bg__grid"></div>
    <div class="bw-bg__glow bw-bg__glow--1"></div>
    <div class="bw-bg__glow bw-bg__glow--2"></div>
    <!-- Floating energy particles -->
    <span class="bw-particle" style="--px:12%;--py:25%;--dx:40px;--dy:-50px;--dur:6s;--del:0s;"></span>
    <span class="bw-particle" style="--px:85%;--py:40%;--dx:-30px;--dy:60px;--dur:7s;--del:1.5s;"></span>
    <span class="bw-particle" style="--px:55%;--py:80%;--dx:50px;--dy:-30px;--dur:5.5s;--del:3s;"></span>
    <span class="bw-particle" style="--px:30%;--py:65%;--dx:-60px;--dy:-40px;--dur:8s;--del:0.8s;"></span>
  </div>

  <div class="container bw-container">
    <!-- Section Header -->
    <div class="bw-header" data-reveal>
      <div class="bw-header__eyebrow">
        <span class="bw-header__line"></span>
        <span class="bw-header__tag">{labels.eyebrow}</span>
        <span class="bw-header__line"></span>
      </div>
      <h2 class="bw-header__title">
        {labels.title}
        <span class="bw-header__accent">{labels.accent}</span>
      </h2>
      <p class="bw-header__desc">
        {labels.description}
      </p>
    </div>

    <!-- Energy Flow Connector SVG -->
    <svg class="bw-flow-svg" viewBox="0 0 40 800" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <linearGradient id="flow-grad" x1="20" y1="0" x2="20" y2="800" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#1e99d3" stop-opacity="0.6" />
          <stop offset="40%" stop-color="#159647" stop-opacity="0.5" />
          <stop offset="100%" stop-color="#ff8c00" stop-opacity="0.6" />
        </linearGradient>
      </defs>
      <line x1="20" y1="0" x2="20" y2="800" stroke="url(#flow-grad)" stroke-width="2" stroke-dasharray="6 10" class="bw-flow-line" />
    </svg>

    <!-- Brand Worlds -->
    <div class="bw-worlds">
      {brands.map((brand) => (
        <article class={`bw-world bw-world--${brand.id}`} data-brand-world>
          <!-- Decorative corner accent -->
          <div class="bw-world__corner-glow"></div>

          <!-- Top row: step number + logo + role title -->
          <div class="bw-world__header">
            <div class="bw-world__step">
              <span class="bw-world__step-num">{brandSteps[brand.id]}</span>
              <span class="bw-world__step-line"></span>
            </div>
            <div class="bw-world__brand-identity">
              <div class="bw-world__logo-wrap">
                <img src={brand.logo} alt={formatMessage(labels.logoAlt, { brand: brand.displayName })} width="140" height="60" loading="lazy" />
              </div>
              <div class="bw-world__role">
                <span class="bw-world__role-tag">{brand.focus}</span>
                <h3 class="bw-world__name">
                  {brand.displayName}
                  <span class="bw-world__name-ar"> — {brand.title.split(' ').slice(0, 3).join(' ')}</span>
                </h3>
              </div>
            </div>
          </div>

          <!-- Main content row -->
          <div class="bw-world__body">
            <!-- Left: icon + description -->
            <div class="bw-world__content">
              <div class="bw-world__icon-orb">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={brandIcons[brand.id]} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <p class="bw-world__desc">{brand.description}</p>
              <div class="bw-world__story">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="bw-world__story-icon">
                  <path d="m13 2-2 7h7l-8 13 2-8H5l8-12Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{brand.story}</span>
              </div>
              <a href={localePath(locale, `/brands/${brand.slug}`)} class="bw-world__cta">
                <span>{labels.discover}</span>
                <svg class="directional-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
              </a>
            </div>

            <!-- Right: categories grid -->
            <div class="bw-world__categories">
              <span class="bw-world__cat-label">{labels.specialties}</span>
              <div class="bw-world__cat-grid">
                {brand.categories.map((cat: string) => (
                  <span class="bw-world__cat">{cat}</span>
                ))}
              </div>
            </div>
          </div>

          <!-- Bottom energy bar -->
          <div class="bw-world__energy-bar">
            <div class="bw-world__energy-fill"></div>
          </div>
        </article>
      ))}
    </div>

    <div class="bw-mobile-indicator" aria-hidden="true">
      <span>01 / 02</span>
      <div class="bw-mobile-indicator__dots">
        {brands.map((brand, index) => (
          <i class={index === 0 ? 'is-active' : ''} style={`--dot-color: ${brand.id === 'cnc' ? '#e63946' : 'var(--tj-orange)'}`}></i>
        ))}
      </div>
    </div>

    <!-- Bottom connector statement -->
    <div class="bw-connector" data-reveal>
      <div class="bw-connector__orb">
        <img src="/logos/tajaddod-icon.svg" alt={copy.brand} width="40" height="40" loading="lazy" />
      </div>
      <p class="bw-connector__text">
        {labels.connectorLead} <strong>{labels.connectorAccent}</strong> {labels.connectorTail}
      </p>
    </div>
  </div>
</section>

<style>
/* ═══════════════════════════════════════════════════════════════════════
   Brand Worlds Section — ثلاث عوالم
   Immersive cinematic brand showcase
   ═══════════════════════════════════════════════════════════════════════ */

.bw-section {
  position: relative;
  overflow: hidden;
  padding: clamp(80px, 10vw, 140px) 0;
  background: linear-gradient(
    170deg,
    #081d28 0%,
    #0c2b36 30%,
    #0b3429 60%,
    #091f2b 100%
  );
  color: var(--tj-text-inverse);
}

/* ─── Background ────────────────────────────────────────────────────── */

.bw-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.bw-bg__gradient {
  position: absolute;
  inset: 0;
}

.bw-bg__grid {
  position: absolute;
  inset: 0;
  opacity: 0.04;
  background-image:
    linear-gradient(var(--tj-inverse-alpha-10) 1px, transparent 1px),
    linear-gradient(90deg, var(--tj-inverse-alpha-10) 1px, transparent 1px);
  background-size: 72px 72px;
  mask-image: radial-gradient(ellipse at 50% 50%, var(--tj-neutral-950) 10%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 50%, var(--tj-neutral-950) 10%, transparent 75%);
}

.bw-bg__glow {
  position: absolute;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  filter: blur(130px);
  opacity: 0.12;
}

.bw-bg__glow--1 {
  top: 5%;
  right: -8%;
  background: color-mix(in srgb, var(--tj-blue) 60%, transparent);
  animation: bwGlowFloat 15s ease-in-out infinite alternate;
}

.bw-bg__glow--2 {
  bottom: 5%;
  left: -6%;
  background: color-mix(in srgb, var(--tj-orange) 50%, transparent);
  animation: bwGlowFloat 18s ease-in-out infinite alternate-reverse;
}

@keyframes bwGlowFloat {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(25px, -15px) scale(1.1); }
}

/* Particles */
.bw-particle {
  position: absolute;
  left: var(--px);
  top: var(--py);
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: rgba(155, 232, 255, 0.5);
  box-shadow: 0 0 8px rgba(155, 232, 255, 0.3);
  animation: bwParticle var(--dur) ease-in-out var(--del) infinite;
  z-index: 0;
}

@keyframes bwParticle {
  0%, 100% { transform: translate(0,0); opacity: 0; }
  15% { opacity: 0.7; }
  50% { transform: translate(var(--dx), var(--dy)); opacity: 0.35; }
  85% { opacity: 0.1; }
}

/* ─── Container ─────────────────────────────────────────────────────── */

.bw-container {
  position: relative;
  z-index: 1;
}

/* ─── Header ────────────────────────────────────────────────────────── */

.bw-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto clamp(48px, 6vw, 72px);
}

.bw-header__eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 20px;
}

.bw-header__line {
  width: 44px;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(155,232,255,0.45));
}

.bw-header__line:last-child {
  background: linear-gradient(90deg, rgba(155,232,255,0.45), transparent);
}

.bw-header__tag {
  color: var(--tj-blue-light);
  font-size: var(--tj-text-small);
  font-weight: var(--tj-font-semibold);
  letter-spacing: 0.06em;
}

.bw-header__title {
  color: var(--tj-text-inverse);
  font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  font-weight: var(--tj-font-bold);
  line-height: 1.3;
  margin-bottom: 18px;
}

.bw-header__accent {
  display: block;
  margin-top: 4px;
  background: linear-gradient(135deg, var(--tj-blue-light), var(--tj-green-light) 60%, var(--tj-blue));
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: bwGradText 5s ease-in-out infinite;
}

@keyframes bwGradText {
  0%, 100% { background-position: 0% center; }
  50% { background-position: 100% center; }
}

.bw-header__desc {
  color: var(--tj-inverse-alpha-55);
  font-size: var(--tj-text-body);
  line-height: 1.9;
  max-width: 600px;
  margin: 0 auto;
}

/* ─── Energy Flow SVG ───────────────────────────────────────────────── */

.bw-flow-svg {
  position: absolute;
  top: 220px;
  left: 50%;
  transform: translateX(-50%);
  width: 40px;
  height: calc(100% - 380px);
  z-index: 0;
  opacity: 0.45;
}

.bw-flow-line {
  animation: bwFlowDash 3s linear infinite;
}

@keyframes bwFlowDash {
  from { stroke-dashoffset: 0; }
  to { stroke-dashoffset: -32; }
}

/* ─── Brand Worlds ──────────────────────────────────────────────────── */

.bw-worlds {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  position: relative;
  z-index: 1;
}

.bw-mobile-indicator {
  display: none;
}

.bw-world {
  --world-accent: var(--tj-blue);
  --world-accent-rgb: 30, 153, 211;
  position: relative;
  overflow: hidden;
  border: 1px solid var(--tj-inverse-alpha-07);
  border-radius: 32px;
  padding: 0;
  background: var(--tj-inverse-alpha-03);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  transition:
    transform 0.45s var(--tj-ease-smooth),
    border-color 0.45s var(--tj-ease-smooth),
    box-shadow 0.45s var(--tj-ease-smooth);
}

.bw-world:hover {
  transform: translateY(-5px);
  border-color: rgba(var(--world-accent-rgb), 0.25);
  box-shadow:
    0 28px 70px color-mix(in srgb, var(--tj-neutral-950) 25%, transparent),
    0 0 40px rgba(var(--world-accent-rgb), 0.08);
}

.bw-world--cnc {
  --world-accent: var(--tj-cnc-red);
  --world-accent-rgb: 230, 57, 70;
}

.bw-world--liper {
  --world-accent: var(--tj-orange);
  --world-accent-rgb: 255, 140, 0;
}

/* Corner glow */
.bw-world__corner-glow {
  position: absolute;
  top: -80px;
  right: -80px;
  width: 240px;
  height: 240px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--world-accent-rgb), 0.2), transparent 70%);
  opacity: 0.5;
  transition: opacity 0.5s ease;
  pointer-events: none;
}

.bw-world:hover .bw-world__corner-glow {
  opacity: 0.9;
}

/* ─── World Header ──────────────────────────────────────────────────── */

.bw-world__header {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 28px 32px 0;
}

.bw-world__step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.bw-world__step-num {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: rgba(var(--world-accent-rgb), 0.12);
  border: 1px solid rgba(var(--world-accent-rgb), 0.2);
  color: var(--world-accent);
  font-size: var(--tj-text-body);
  font-weight: var(--tj-font-bold);
}

.bw-world__step-line {
  width: 2px;
  height: 24px;
  background: linear-gradient(180deg, rgba(var(--world-accent-rgb), 0.3), transparent);
  border-radius: 2px;
}

.bw-world__brand-identity {
  display: flex;
  align-items: center;
  gap: 20px;
  flex: 1;
  min-width: 0;
}

.bw-world__logo-wrap {
  display: grid;
  place-items: center;
  width: 130px;
  height: 72px;
  flex-shrink: 0;
  border-radius: 20px;
  background: var(--tj-inverse-alpha-06);
  border: 1px solid var(--tj-inverse-alpha-08);
  transition: background 0.3s ease, border-color 0.3s ease;
}

.bw-world:hover .bw-world__logo-wrap {
  background: var(--tj-inverse-alpha-10);
  border-color: var(--tj-inverse-alpha-15);
}

.bw-world__logo-wrap img {
  max-width: 100px;
  max-height: 48px;
  object-fit: contain;
  filter: brightness(0) invert(1);
  opacity: 0.85;
  transition: opacity 0.3s ease;
}

.bw-world:hover .bw-world__logo-wrap img {
  opacity: 1;
}

.bw-world__role {
  flex: 1;
  min-width: 0;
}

.bw-world__role-tag {
  display: inline-block;
  margin-bottom: 6px;
  padding: 5px 12px;
  border-radius: 999px;
  background: rgba(var(--world-accent-rgb), 0.1);
  border: 1px solid rgba(var(--world-accent-rgb), 0.15);
  color: var(--world-accent);
  font-size: var(--tj-text-nano);
  font-weight: var(--tj-font-semibold);
}

.bw-world__name {
  color: var(--tj-text-inverse);
  font-size: var(--tj-text-h3);
  font-weight: var(--tj-font-bold);
  margin: 0;
  line-height: 1.3;
}

.bw-world__name-ar {
  color: var(--tj-inverse-alpha-50);
  font-weight: var(--tj-font-regular);
  font-size: 0.9em;
}

/* ─── World Body ────────────────────────────────────────────────────── */

.bw-world__body {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  padding: 24px 32px 28px;
}

.bw-world__content {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.bw-world__icon-orb {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 13px;
  background: linear-gradient(135deg, rgba(var(--world-accent-rgb), 0.15), rgba(var(--world-accent-rgb), 0.05));
  border: 1px solid rgba(var(--world-accent-rgb), 0.12);
  color: var(--world-accent);
}

.bw-world__icon-orb svg {
  width: 22px;
  height: 22px;
}

.bw-world__desc {
  color: var(--tj-inverse-alpha-60);
  font-size: var(--tj-text-body);
  line-height: 1.85;
  margin: 0;
}

.bw-world__story {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 14px 16px;
  border-radius: 18px;
  background: rgba(var(--world-accent-rgb), 0.05);
  border: 1px solid rgba(var(--world-accent-rgb), 0.08);
}

.bw-world__story-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  margin-top: 2px;
  color: var(--world-accent);
  opacity: 0.7;
}

.bw-world__story span {
  color: var(--tj-inverse-alpha-50);
  font-size: var(--tj-text-small);
  line-height: 1.7;
}

.bw-world__cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: auto;
  margin-bottom: 8px;
  padding: 10px 20px;
  border-radius: 12px;
  background: rgba(var(--world-accent-rgb), 0.1);
  border: 1px solid rgba(var(--world-accent-rgb), 0.2);
  color: var(--tj-text-inverse);
  font-size: 0.95rem;
  font-weight: var(--tj-font-semibold);
  text-decoration: none;
  width: fit-content;
  transition: all 0.3s ease;
}

.bw-world__cta svg {
  width: 18px;
  height: 18px;
  color: var(--world-accent);
  transition: transform 0.3s ease;
}

.bw-world__cta:hover {
  background: rgba(var(--world-accent-rgb), 0.18);
  border-color: rgba(var(--world-accent-rgb), 0.35);
  transform: translateY(-2px);
}

.bw-world__cta:hover svg {
  transform: translateX(calc(var(--tj-inline-direction) * 4px)) scaleX(calc(var(--tj-inline-direction) * -1));
}

/* ─── Categories ────────────────────────────────────────────────────── */

.bw-world__categories {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.bw-world__cat-label {
  color: var(--tj-inverse-alpha-30);
  font-size: var(--tj-text-nano);
  font-weight: var(--tj-font-semibold);
  letter-spacing: 0.04em;
}

.bw-world__cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.bw-world__cat {
  display: inline-flex;
  align-items: center;
  padding: 7px 14px;
  border-radius: 999px;
  background: var(--tj-inverse-alpha-05);
  border: 1px solid var(--tj-inverse-alpha-08);
  color: var(--tj-inverse-alpha-60);
  font-size: var(--tj-text-micro);
  font-weight: var(--tj-font-regular);
  transition:
    background 0.25s ease,
    border-color 0.25s ease,
    color 0.25s ease;
}

.bw-world__cat:hover {
  background: rgba(var(--world-accent-rgb), 0.12);
  border-color: rgba(var(--world-accent-rgb), 0.25);
  color: var(--world-accent);
}

/* ─── Energy Bar ────────────────────────────────────────────────────── */

.bw-world__energy-bar {
  height: 3px;
  background: var(--tj-inverse-alpha-04);
  overflow: hidden;
}

.bw-world__energy-fill {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, transparent, var(--world-accent), transparent);
  transition: width 0.8s var(--tj-ease-energy);
}

.bw-world:hover .bw-world__energy-fill {
  width: 100%;
}

/* ─── Bottom Connector ──────────────────────────────────────────────── */

.bw-connector {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
  margin-top: clamp(40px, 5vw, 64px);
  text-align: center;
}

.bw-connector__orb {
  display: grid;
  place-items: center;
  width: 68px;
  height: 68px;
  border-radius: 50%;
  background: var(--tj-inverse-alpha-06);
  border: 1px solid var(--tj-inverse-alpha-10);
  box-shadow:
    0 0 30px color-mix(in srgb, var(--tj-blue) 15%, transparent),
    0 12px 40px color-mix(in srgb, var(--tj-neutral-950) 20%, transparent);
}

.bw-connector__orb img {
  width: 36px;
  height: 36px;
  object-fit: contain;
  filter: drop-shadow(0 0 12px color-mix(in srgb, var(--tj-blue) 30%, transparent));
}

.bw-connector__text {
  color: var(--tj-inverse-alpha-50);
  font-size: var(--tj-text-body);
  line-height: 1.8;
  max-width: 520px;
  margin: 0;
}

.bw-connector__text strong {
  color: var(--tj-text-inverse);
}

/* ═══════════════════════════════════════════════════════════════════════
   Responsive
   ═══════════════════════════════════════════════════════════════════════ */

@media (max-width: 1100px) {
  .bw-worlds {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 767px) {
  .bw-section {
    padding: clamp(60px, 8vw, 100px) 0;
  }

  .bw-flow-svg {
    display: none;
  }

  .bw-header {
    margin-bottom: 28px;
  }

  .bw-header__title {
    font-size: clamp(2rem, 8vw, 3rem);
  }

  .bw-header__desc {
    font-size: .95rem;
    line-height: 1.8;
  }

  .bw-worlds {
    display: flex;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding: 4px 20px 12px;
