---
/**
 * Philosophy Section — فلسفة تجدد
 * Premium cinematic brand philosophy manifesto with
 * horizontal scroll pillars, animated energy circuit, and glassmorphism.
 */
---

<section class="section philosophy-section" id="about">
  <!-- Background layers -->
  <div class="ph-bg" aria-hidden="true">
    <div class="ph-bg__grid"></div>
    <div class="ph-bg__aurora ph-bg__aurora--1"></div>
    <div class="ph-bg__aurora ph-bg__aurora--2"></div>
    <div class="ph-bg__aurora ph-bg__aurora--3"></div>
    <div class="ph-bg__noise"></div>
    <!-- Floating energy lines -->
    <div class="ph-bg__lines">
      <span class="ph-line" style="--top:18%;--delay:0s;"></span>
      <span class="ph-line" style="--top:42%;--delay:-2.5s;"></span>
      <span class="ph-line" style="--top:67%;--delay:-5s;"></span>
      <span class="ph-line" style="--top:85%;--delay:-7s;"></span>
    </div>
  </div>

  <div class="container ph-container">

    <!-- ─── Hero Manifesto Block ─────────────────────────── -->
    <div class="ph-hero" data-ph-hero>
      <div class="ph-eyebrow">
        <span class="ph-eyebrow__icon">
          <svg viewBox="0 0 24 24" fill="none" width="16" height="16">
            <path d="m13 2-2 7h7l-8 13 2-8H5l8-12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="ph-eyebrow__text">فلسفة تجدد</span>
        <span class="ph-eyebrow__line"></span>
      </div>

      <h2 class="ph-title">
        <span class="ph-title__line">ليست مجرد وكالة…</span>
        <span class="ph-title__accent">بل فلسفة في بناء المنظومة</span>
      </h2>

      <p class="ph-lead">
        تجدد لا تبيع منتجات، بل تبني جسرًا بين العلامات المتخصصة واحتياج السوق الحقيقي.
        نؤمن أن كل قاطع وكل كشاف هو جزء من رحلة طاقة واحدة متكاملة؛ من الحماية إلى الإضاءة والطاقة.
      </p>
    </div>

    <!-- ─── Energy Circuit Visualization ──────────────────── -->
    <div class="ph-circuit" data-ph-circuit>
      <div class="ph-circuit__visual">
        <!-- SVG Energy Circuit -->
        <svg class="ph-circuit__svg" viewBox="0 0 800 280" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="circuitGrad" x1="0%" y1="50%" x2="100%" y2="50%">
              <stop offset="0%" stop-color="#1e99d3" stop-opacity="0.6"/>
              <stop offset="50%" stop-color="#159647" stop-opacity="0.6"/>
              <stop offset="100%" stop-color="#ff8c00" stop-opacity="0.6"/>
            </linearGradient>
            <filter id="circuitGlow">
              <feGaussianBlur stdDeviation="4" result="blur"/>
              <feComposite in="SourceGraphic" in2="blur" operator="over"/>
            </filter>
          </defs>
          <!-- Main horizontal path -->
          <path class="ph-circuit__path-bg" d="M0 140 Q100 140 150 80 Q200 20 300 60 Q400 100 400 140 Q400 180 500 220 Q600 260 650 200 Q700 140 800 140" stroke="rgba(255,255,255,0.05)" stroke-width="2" fill="none"/>
          <path class="ph-circuit__path" d="M0 140 Q100 140 150 80 Q200 20 300 60 Q400 100 400 140 Q400 180 500 220 Q600 260 650 200 Q700 140 800 140" stroke="url(#circuitGrad)" stroke-width="2.5" fill="none" filter="url(#circuitGlow)" data-ph-path/>
          <!-- Junction dots -->
          <circle class="ph-circuit__dot ph-circuit__dot--cnc" cx="300" cy="60" r="5" fill="#e63946"/>
          <circle class="ph-circuit__dot ph-circuit__dot--2" cx="400" cy="140" r="6" fill="#fff"/>
          <circle class="ph-circuit__dot ph-circuit__dot--3" cx="650" cy="200" r="5" fill="#ff8c00"/>
        </svg>

        <!-- Brand nodes positioned along the circuit -->
        <div class="ph-circuit__node ph-circuit__node--cnc" data-ph-node>
          <div class="ph-node__beacon ph-node__beacon--cnc"></div>
          <div class="ph-node__card">
            <img src="/logos/cnc-logo-white.svg" alt="CNC" loading="lazy"/>
            <span>الحماية والتحكم</span>
          </div>
        </div>

        <div class="ph-circuit__node ph-circuit__node--tajaddod" data-ph-node>
          <div class="ph-node__beacon ph-node__beacon--white"></div>
          <div class="ph-node__card ph-node__card--center">
            <img src="/logos/tajaddod-icon.svg" alt="تجدد" loading="lazy"/>
            <span>المنظومة</span>
          </div>
        </div>

        <div class="ph-circuit__node ph-circuit__node--liper" data-ph-node>
          <div class="ph-node__beacon"></div>
          <div class="ph-node__card">
            <img src="/logos/liper-logo-white.svg" alt="Liper" loading="lazy"/>
            <span>الأثر المرئي</span>
          </div>
        </div>
      </div>
    </div>

    <div class="ph-mobile-path" aria-label="مسار الطاقة بين علامات تجدد">
      {[
        { name: 'CNC', logo: '/logos/cnc-logo-white.svg', text: 'حماية وتحكم وتوزيع', color: 'var(--tj-green)' },
        { name: 'تجدد', logo: '/logos/tajaddod-icon.svg', text: 'تحويل التعدد إلى منظومة', color: '#fff', hub: true },
        { name: 'Liper', logo: '/logos/liper-logo-white.svg', text: 'ضوء وطاقة يكتمل بها المشروع', color: 'var(--tj-orange)' },
      ].map((node) => (
        <div class={`ph-mobile-node ${node.hub ? 'ph-mobile-node--hub' : ''}`} style={`--node-color: ${node.color};`}>
          <span class="ph-mobile-node__dot"></span>
          <div class="ph-mobile-node__card">
            <img src={node.logo} alt={node.name} loading="lazy" />
            <div>
              <strong>{node.name}</strong>
              <span>{node.text}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- ─── Philosophy Pillars ───────────────────────────── -->
    <div class="ph-pillars" data-ph-pillars>

      <div class="ph-pillar" data-ph-pillar data-brand="cnc">
        <div class="ph-pillar__accent" style="--pillar-color: var(--tj-green);"></div>
        <div class="ph-pillar__head">
          <div class="ph-pillar__icon" style="--pillar-color: var(--tj-green);">
            <svg viewBox="0 0 24 24" fill="none" width="24" height="24">
              <path d="M12 3 5 6v5c0 5 3 8.5 7 10 4-1.5 7-5 7-10V6l-7-3Zm0 6v6m0 3h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="ph-pillar__num">01</span>
        </div>
        <h3 class="ph-pillar__title">الحماية</h3>
        <p class="ph-pillar__text">
          الطاقة بدون حماية مخاطرة. نربط المشاريع بأنظمة قواطع وتحكم تضمن استمرارية آمنة وموثوقة.
        </p>
        <div class="ph-pillar__brand">
          <img src="/logos/cnc-logo-white.svg" alt="CNC" loading="lazy"/>
        </div>
        <div class="ph-pillar__glow" style="--pillar-color: var(--tj-green);"></div>
      </div>

      <div class="ph-pillar" data-ph-pillar data-brand="tajaddod">
        <div class="ph-pillar__accent" style="--pillar-color: var(--tj-blue);"></div>
        <div class="ph-pillar__head">
          <div class="ph-pillar__icon" style="--pillar-color: var(--tj-blue);">
            <svg viewBox="0 0 24 24" fill="none" width="24" height="24">
              <path d="m13 2-2 7h7l-8 13 2-8H5l8-12Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="ph-pillar__num">02</span>
        </div>
        <h3 class="ph-pillar__title">المنظومة</h3>
        <p class="ph-pillar__text">
          تجدد هي المظلة التي تجمع العلامات المتخصصة لتوفير مسار طاقة متكامل وموثوق يخدم احتياج السوق.
        </p>
        <div class="ph-pillar__brand">
          <img src="/logos/tajaddod-icon.svg" alt="تجدد" loading="lazy" style="height: 18px;"/>
        </div>
        <div class="ph-pillar__glow" style="--pillar-color: var(--tj-blue);"></div>
      </div>

      <div class="ph-pillar" data-ph-pillar data-brand="liper">
        <div class="ph-pillar__accent" style="--pillar-color: var(--tj-orange);"></div>
        <div class="ph-pillar__head">
          <div class="ph-pillar__icon" style="--pillar-color: var(--tj-orange);">
            <svg viewBox="0 0 24 24" fill="none" width="24" height="24">
              <path d="M9 21h6m-5-4h4m-7-6a5 5 0 1 1 10 0c0 2-1.5 3.2-2.7 4.2-.8.7-1.3 1.3-1.3 2.3h-2c0-1-.5-1.6-1.3-2.3C8.5 14.2 7 13 7 11Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="ph-pillar__num">03</span>
        </div>
        <h3 class="ph-pillar__title">الأثر</h3>
        <p class="ph-pillar__text">
          حين تتحول الطاقة إلى ضوء وأمان وحضور بصري — هناك يظهر أثر المنظومة المتكاملة.
        </p>
        <div class="ph-pillar__brand">
          <img src="/logos/liper-logo-white.svg" alt="Liper" loading="lazy"/>
        </div>
        <div class="ph-pillar__glow" style="--pillar-color: var(--tj-orange);"></div>
      </div>

    </div>

    <!-- ─── Closing Statement ────────────────────────────── -->
    <div class="ph-closing" data-ph-closing>
      <div class="ph-closing__connector">
        <div class="ph-closing__dot"></div>
        <div class="ph-closing__line"></div>
        <div class="ph-closing__dot"></div>
      </div>
      <blockquote class="ph-quote">
        <span class="ph-quote__mark">"</span>
        <p>نمثل علامات متخصصة في الكهرباء والطاقة، ونربطها باحتياج السوق عبر منظومة توريد موثوقة.</p>
        <span class="ph-quote__mark">"</span>
      </blockquote>
      <div class="ph-closing__brands">
        <img src="/logos/cnc-logo-white.svg" alt="CNC" loading="lazy"/>
        <span class="ph-closing__divider"></span>
        <img src="/logos/liper-logo-white.svg" alt="Liper" loading="lazy"/>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.philosophy-section') as HTMLElement;
    if (!section) return;
    const isMobile = window.matchMedia('(max-width: 820px)').matches;

    // ─── Hero Manifesto Animation ──────────────────────────
    const hero = section.querySelector('[data-ph-hero]');
    if (hero) {
      const heroTl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top 80%',
          toggleActions: 'play none none reverse',
        }
      });

      heroTl
        .from(hero.querySelector('.ph-eyebrow'), {
          y: 30, opacity: 0, duration: 0.7, ease: 'power3.out'
        })
        .from(hero.querySelector('.ph-title__line'), {
          y: 50, opacity: 0, duration: 0.8, ease: 'power3.out'
        }, '-=0.3')
        .from(hero.querySelector('.ph-title__accent'), {
          y: 50, opacity: 0, duration: 0.8, ease: 'power3.out'
        }, '-=0.5')
        .from(hero.querySelector('.ph-lead'), {
          y: 30, opacity: 0, duration: 0.7, ease: 'power2.out'
        }, '-=0.4');
    }

    // ─── Circuit Animation ─────────────────────────────────
    const circuit = section.querySelector('[data-ph-circuit]');
    const svgPath = section.querySelector('[data-ph-path]') as SVGPathElement | null;

    if (circuit && svgPath && !isMobile) {
      const pathLength = svgPath.getTotalLength();
      gsap.set(svgPath, {
        strokeDasharray: pathLength,
        strokeDashoffset: pathLength
      });

      const circuitTl = gsap.timeline({
        scrollTrigger: {
          trigger: circuit,
          start: 'top 70%',
          end: 'bottom 40%',
          scrub: 1.5,
        }
      });

      circuitTl.to(svgPath, {
        strokeDashoffset: 0,
        ease: 'none'
      });

      // Dots appear as path reaches them
      const dots = section.querySelectorAll('.ph-circuit__dot');
      dots.forEach((dot, i) => {
        gsap.from(dot, {
          scale: 0,
          opacity: 0,
          duration: 0.5,
          ease: 'back.out(2)',
          scrollTrigger: {
            trigger: circuit,
            start: `top ${65 - i * 10}%`,
            toggleActions: 'play none none reverse',
          }
        });
      });

      // Nodes appear sequentially
      const nodes = section.querySelectorAll('[data-ph-node]');
      nodes.forEach((node, i) => {
        gsap.from(node, {
          y: 40,
          opacity: 0,
          scale: 0.8,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: circuit,
            start: `top ${60 - i * 12}%`,
            toggleActions: 'play none none reverse',
          }
        });
      });
    }

    // ─── Pillars Stagger Animation ─────────────────────────
    const pillars = section.querySelectorAll('[data-ph-pillar]');
    if (pillars.length > 0) {
      pillars.forEach((pillar, i) => {
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: pillar,
            start: 'top 80%',
            toggleActions: 'play none none reverse',
          }
        });

        tl.from(pillar, {
          y: 60,
          opacity: 0,
          scale: 0.95,
          duration: 0.7,
          delay: i * 0.12,
          ease: 'power3.out'
        })
        .from(pillar.querySelector('.ph-pillar__icon'), {
          scale: 0,
          rotation: -90,
          duration: 0.5,
          ease: 'back.out(2)'
        }, '-=0.3')
        .from(pillar.querySelector('.ph-pillar__brand'), {
          x: -20,
          opacity: 0,
          duration: 0.4,
          ease: 'power2.out'
        }, '-=0.2');
      });
    }

    // ─── Closing Quote Animation ───────────────────────────
    const closing = section.querySelector('[data-ph-closing]');
    if (closing) {
      gsap.from(closing, {
        y: 40,
        opacity: 0,
        duration: 0.8,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: closing,
          start: 'top 85%',
          toggleActions: 'play none none reverse',
        }
      });
    }

    // ─── Pillar Hover Parallax ─────────────────────────────
    if (!isMobile) {
      pillars.forEach(pillar => {
        const glow = pillar.querySelector('.ph-pillar__glow') as HTMLElement;
        if (!glow) return;

        pillar.addEventListener('mousemove', (e: Event) => {
          const me = e as MouseEvent;
          const rect = (pillar as HTMLElement).getBoundingClientRect();
          const x = ((me.clientX - rect.left) / rect.width - 0.5) * 2;
          const y = ((me.clientY - rect.top) / rect.height - 0.5) * 2;
          gsap.to(glow, {
            x: x * 30,
            y: y * 30,
            duration: 0.4,
            ease: 'power2.out'
          });
        });

        pillar.addEventListener('mouseleave', () => {
          gsap.to(glow, { x: 0, y: 0, duration: 0.6, ease: 'power2.out' });
        });
      });
    }
  });
</script>

<style>
/* ═══════════════════════════════════════════════════════════════════════
   Philosophy Section — فلسفة تجدد
   Premium cinematic design with circuit visualization
   ═══════════════════════════════════════════════════════════════════════ */

.philosophy-section {
  position: relative;
  overflow: hidden;
  padding: clamp(100px, 12vw, 180px) 0 !important;
  background: linear-gradient(
    160deg,
    #040c14 0%,
    #071e2a 20%,
    #0a3020 45%,
    #082838 70%,
    #040c14 100%
  ) !important;
  color: #fff;
}

/* ─── Background Effects ───────────────────────────────────── */

.ph-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.ph-bg__grid {
  position: absolute;
  inset: 0;
  opacity: 0.025;
  background-image:
    linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
  background-size: 80px 80px;
  mask-image: radial-gradient(ellipse at 50% 30%, #000 10%, transparent 65%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 30%, #000 10%, transparent 65%);
}

.ph-bg__aurora {
  position: absolute;
  border-radius: 50%;
  filter: blur(140px);
  opacity: 0.08;
  animation: phAurora 14s ease-in-out infinite alternate;
}

.ph-bg__aurora--1 {
  width: 700px;
  height: 500px;
  top: -10%;
  right: -5%;
  background: var(--tj-blue);
}

.ph-bg__aurora--2 {
  width: 500px;
  height: 600px;
  bottom: -5%;
  left: -8%;
  background: var(--tj-green);
  animation-delay: -5s;
}

.ph-bg__aurora--3 {
  width: 400px;
  height: 350px;
  top: 50%;
  left: 40%;
  background: var(--tj-orange);
  animation-delay: -9s;
  opacity: 0.04;
}

@keyframes phAurora {
  0% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(25px, -15px) scale(1.12); }
  100% { transform: translate(-15px, 10px) scale(0.95); }
}

.ph-bg__noise {
  position: absolute;
  inset: 0;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}

/* Energy lines */
.ph-bg__lines {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.ph-line {
  position: absolute;
  top: var(--top);
  right: -20%;
  height: 1.5px;
  width: 35vw;
  background: linear-gradient(90deg, transparent, rgba(255,140,0,0.25), rgba(30,153,211,0.2), transparent);
  filter: drop-shadow(0 0 8px rgba(255,140,0,0.3));
  animation: phLineFlow 9s linear var(--delay) infinite;
  opacity: 0.4;
}

@keyframes phLineFlow {
  0% { transform: translateX(0); opacity: 0; }
  10% { opacity: 0.4; }
  90% { opacity: 0.4; }
  100% { transform: translateX(-120vw); opacity: 0; }
}

/* ─── Container ────────────────────────────────────────────── */

.ph-container {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(60px, 8vw, 100px);
}

/* ─── Hero Manifesto ───────────────────────────────────────── */

.ph-hero {
  text-align: center;
  max-width: 780px;
}

.ph-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 28px;
  padding: 8px 20px 8px 14px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 999px;
}

.ph-eyebrow__icon {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(30,153,211,0.2), rgba(255,140,0,0.2));
  color: var(--tj-blue-light);
}

.ph-eyebrow__text {
  color: var(--tj-blue-light);
  font-size: var(--tj-text-small);
  font-weight: var(--tj-font-semibold);
  letter-spacing: 0.06em;
}

.ph-eyebrow__line {
  width: 40px;
  height: 1px;
  background: linear-gradient(90deg, rgba(155,232,255,0.4), transparent);
}

.ph-title {
  color: #fff;
  font-size: clamp(1.7rem, 4vw, 2.7rem);
  font-weight: var(--tj-font-extrabold);
  line-height: 1.25;
  margin-bottom: 28px;
}

.ph-title__line {
  display: block;
  margin-bottom: 6px;
}

.ph-title__accent {
  display: block;
  background: linear-gradient(135deg, #9be8ff 0%, #1e99d3 30%, #8bc543 70%, #9be8ff 100%);
  background-size: 250% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: phGradientShift 8s ease-in-out infinite;
}

@keyframes phGradientShift {
  0%, 100% { background-position: 0% center; }
  50% { background-position: 100% center; }
}

.ph-lead {
  color: rgba(255, 255, 255, 0.55);
  font-size: var(--tj-text-body-lg);
  line-height: 1.95;
  max-width: 660px;
  margin: 0 auto;
}

/* ─── Circuit Visualization ────────────────────────────────── */

.ph-circuit {
  width: 100%;
  max-width: 800px;
  position: relative;
}

.ph-mobile-path {
  display: none;
}

.ph-circuit__visual {
  position: relative;
  width: 100%;
  padding-bottom: 35%;
}

.ph-circuit__svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.ph-circuit__path-bg {
  opacity: 0.5;
}

.ph-circuit__path {
  transition: stroke 0.4s ease;
}

.ph-circuit__dot {
  filter: drop-shadow(0 0 8px currentColor);
}

.ph-circuit__dot--2 {
  filter: drop-shadow(0 0 12px rgba(255,255,255,0.6));
}

/* Circuit Nodes */
.ph-circuit__node {
  position: absolute;
  z-index: 3;
}

.ph-circuit__node--cnc {
  top: -15%;
  left: 31%;
}

.ph-circuit__node--tajaddod {
  top: 15%;
  left: 50%;
  transform: translateX(-50%);
}

.ph-circuit__node--liper {
  bottom: -15%;
  right: 12%;
}

.ph-node__beacon {
  position: absolute;
  inset: -8px;
  border-radius: 50%;
  background: var(--tj-blue);
  opacity: 0;
  animation: phBeacon 2.5s ease-out infinite;
  z-index: 0;
}

