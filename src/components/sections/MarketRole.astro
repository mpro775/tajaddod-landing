---
/**
 * Market Role Section — دور تجدد في السوق
 * Premium hub-and-spoke visualization showing Tajaddod as the bridge
 * between specialized brands and market segments.
 */
import { marketSteps } from '../../data/journey';

const marketSegments = [
  {
    id: 'retailers',
    icon: 'M4 10h16l-1-5H5l-1 5Zm2 0v9h12v-9M9 19v-5h6v5',
    title: 'التجار والموزعون',
    desc: 'تشكيلة واضحة قابلة للتسويق والتوريد.',
    accent: 'blue',
    sources: 'cnc,liper',
  },
  {
    id: 'contractors',
    icon: 'M4 15a8 8 0 0 1 16 0v2H4v-2Zm4-1V8m8 6V8M3 17h18v3H3v-3Z',
    title: 'المقاولون',
    desc: 'حلول متكاملة من المفتاح إلى الطاقة الشمسية.',
    accent: 'green',
    sources: 'cnc,liper',
  },
  {
    id: 'technicians',
    icon: 'M14 6a4 4 0 0 0 5 5l-8 8a3 3 0 0 1-4-4l8-8Zm-8 12 3 3',
    title: 'الفنيون',
    desc: 'منتجات موثوقة مرتبة حسب التخصص.',
    accent: 'lime',
    sources: 'cnc',
  },
  {
    id: 'owners',
    icon: 'M5 21V4h9v17M14 9h5v12M8 8h3m-3 4h3m-3 4h3m8-3h-2m2 4h-2',
    title: 'أصحاب المشاريع',
    desc: 'منظومة كهرباء متكاملة وواضحة.',
    accent: 'blue',
    sources: 'cnc,liper',
  },
];

const brandSources = [
  { id: 'cnc', logo: '/logos/cnc-logo.svg', name: 'CNC', role: 'الحماية والتحكم', targets: 'contractors,technicians,owners' },
  { id: 'liper', logo: '/logos/liper-logo.svg', name: 'Liper', role: 'الإضاءة والطاقة', targets: 'retailers,contractors,owners' },
];
---
<section class="section mr-section layer-cinematic" id="market-role">
  <!-- Background layers -->
  <div class="mr-bg" aria-hidden="true">
    <div class="mr-bg__grid"></div>
    <div class="mr-bg__glow mr-bg__glow--1"></div>
    <div class="mr-bg__glow mr-bg__glow--2"></div>
    <div class="mr-bg__glow mr-bg__glow--3"></div>
    <span class="mr-particle" style="--px:10%;--py:30%;--dx:50px;--dy:-40px;--dur:6s;--del:0s;"></span>
    <span class="mr-particle" style="--px:88%;--py:25%;--dx:-35px;--dy:55px;--dur:7s;--del:1.8s;"></span>
    <span class="mr-particle" style="--px:50%;--py:85%;--dx:40px;--dy:-60px;--dur:5.5s;--del:2.5s;"></span>
  </div>

  <div class="container mr-container">
    <!-- Header -->
    <div class="mr-header" data-reveal>
      <div class="mr-eyebrow">
        <span class="mr-eyebrow__line"></span>
        <span class="mr-eyebrow__text">دور تجدد في السوق</span>
        <span class="mr-eyebrow__line"></span>
      </div>
      <h2 class="mr-title">
        من العلامة إلى السوق…
        <span class="mr-title__accent">تجدد تصنع الرابط</span>
      </h2>
      <p class="mr-subtitle">
        عبر تجدد، تصل العلامات المتخصصة إلى التجار والمقاولين والفنيين وأصحاب المشاريع ضمن منظومة واضحة تجمع التنوع، الثقة، وفهم السوق.
      </p>
    </div>

    <!-- Flow Visualization -->
    <div class="mr-flow" data-reveal>
      
      <!-- Destination: Market Segments -->
      <div class="mr-flow__market">
        <span class="mr-flow__col-label">السوق</span>
        <div class="mr-flow__segment-stack">
          {marketSegments.map((seg) => (
            <div class="mr-segment" data-mr-segment data-id={seg.id} data-sources={seg.sources}>
              <div class="mr-segment__icon">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={seg.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <div class="mr-segment__text">
                <strong>{seg.title}</strong>
                <span>{seg.desc}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Center: Hub -->
      <div class="mr-flow__hub-zone">
        <!-- Connection lines (left to Market) -->
        <div class="mr-flow__lines mr-flow__lines--market" aria-hidden="true">
          <svg viewBox="0 0 120 260" fill="none" preserveAspectRatio="none" class="mr-svg-lines">
            <!-- Background Static paths -->
            <path d="M110 130 Q60 40 0 20" stroke="rgba(255,255,255,0.06)" stroke-width="2" class="mr-path-bg" />
            <path d="M110 130 Q60 100 0 90" stroke="rgba(255,255,255,0.06)" stroke-width="2" class="mr-path-bg" />
            <path d="M110 130 Q60 160 0 170" stroke="rgba(255,255,255,0.06)" stroke-width="2" class="mr-path-bg" />
            <path d="M110 130 Q60 220 0 240" stroke="rgba(255,255,255,0.06)" stroke-width="2" class="mr-path-bg" />
            
            <!-- Glowing Laser path overlays -->
            <path d="M110 130 Q60 40 0 20" stroke="var(--tj-blue)" stroke-width="2.5" class="mr-path-glow mr-path-glow--retailers" data-path-market="retailers" />
            <path d="M110 130 Q60 100 0 90" stroke="var(--tj-green)" stroke-width="2.5" class="mr-path-glow mr-path-glow--contractors" data-path-market="contractors" />
            <path d="M110 130 Q60 160 0 170" stroke="var(--tj-orange)" stroke-width="2.5" class="mr-path-glow mr-path-glow--technicians" data-path-market="technicians" />
            <path d="M110 130 Q60 220 0 240" stroke="var(--tj-blue)" stroke-width="2.5" class="mr-path-glow mr-path-glow--owners" data-path-market="owners" />
          </svg>
        </div>

        <!-- Hub Core -->
        <div class="mr-hub" data-mr-hub>
          <div class="mr-hub__ring mr-hub__ring--outer"></div>
          <div class="mr-hub__ring mr-hub__ring--inner"></div>
          <div class="mr-hub__core">
            <img src="/logos/tajaddod-icon.svg" alt="تجدد" width="48" height="48" />
            <strong>تجدد</strong>
            <span>المظلة</span>
          </div>
          <div class="mr-hub__pulse"></div>
        </div>

        <!-- Connection lines (right to Brands) -->
        <div class="mr-flow__lines mr-flow__lines--brands" aria-hidden="true">
          <svg viewBox="0 0 120 200" fill="none" preserveAspectRatio="none" class="mr-svg-lines">
            <!-- Background Static paths -->
            <path d="M0 100 Q55 70 120 70" stroke="rgba(255,255,255,0.06)" stroke-width="2" class="mr-path-bg" />
            <path d="M0 100 Q55 130 120 130" stroke="rgba(255,255,255,0.06)" stroke-width="2" class="mr-path-bg" />
            
            <!-- Glowing Laser path overlays -->
            <path d="M0 100 Q55 70 120 70" stroke="#e63946" stroke-width="2.5" class="mr-path-glow mr-path-glow--cnc" data-path-brand="cnc" />
            <path d="M0 100 Q55 130 120 130" stroke="var(--tj-orange)" stroke-width="2.5" class="mr-path-glow mr-path-glow--liper" data-path-brand="liper" />
          </svg>
        </div>
      </div>

      <!-- Source: Brands Column -->
      <div class="mr-flow__brands">
        <span class="mr-flow__col-label">العلامات المتخصصة</span>
        <div class="mr-flow__brand-stack">
          {brandSources.map((brand) => (
            <div class="mr-brand-chip" data-mr-chip data-id={brand.id} data-targets={brand.targets}>
              <div class="mr-brand-chip__logo">
                <img src={brand.logo} alt={brand.name} width="80" height="36" loading="lazy" />
              </div>
              <div class="mr-brand-chip__info">
                <strong>{brand.name}</strong>
                <span>{brand.role}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <div class="mr-mobile-flow" aria-label="قصة دور تجدد في السوق">
      <article class="mr-mobile-flow__card mr-mobile-flow__card--hub">
        <span class="mr-mobile-flow__num">01</span>
        <img src="/logos/tajaddod-icon.svg" alt="تجدد" width="42" height="42" loading="lazy" />
        <h3>تجدد</h3>
        <p>نحول تعدد العلامات إلى منظومة واضحة للسوق.</p>
      </article>

      <div class="mr-mobile-flow__branches">
        <article class="mr-mobile-flow__card">
          <span class="mr-mobile-flow__num">02</span>
          <h3>العلامات المتخصصة</h3>
          <p>حلول الحماية والإضاءة والطاقة</p>
          <div class="mr-mobile-flow__logos">
            {brandSources.map((brand) => (
              <img src={brand.logo} alt={brand.name} width="58" height="28" loading="lazy" />
            ))}
          </div>
        </article>

        <article class="mr-mobile-flow__card">
          <span class="mr-mobile-flow__num">03</span>
          <h3>السوق</h3>
          <p>تجار / مقاولون / فنيون / مشاريع</p>
          <div class="mr-mobile-flow__chips">
            {marketSegments.map((segment) => (
              <span>{segment.title}</span>
            ))}
          </div>
        </article>
      </div>
    </div>

    <!-- Process Steps (mobile-friendly linear flow) -->
    <div class="mr-steps" data-reveal>
      {marketSteps.map((step, i) => (
        <div class="mr-step" data-mr-step>
          <div class="mr-step__num">
            <span>{String(i + 1).padStart(2, '0')}</span>
            {i < marketSteps.length - 1 && <div class="mr-step__connector"></div>}
          </div>
          <div class="mr-step__content">
            <strong>{step.label}</strong>
            <p>{step.detail}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Statement -->
    <div class="mr-closing" data-reveal>
      <blockquote class="mr-quote">
        <span class="mr-quote__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2H4c-1.25 0-2 .75-2 2v4c0 1.25.75 2 2 2h3c0 4-2 7-5 8M14 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2h-4c-1.25 0-2 .75-2 2v4c0 1.25.75 2 2 2h3c0 4-2 7-5 8" />
          </svg>
        </span>
        نقرّب العلامات المتخصصة من احتياج السوق عبر <strong>منظومة توريد موثوقة</strong> تخدم التجار، المقاولين، الفنيين، وأصحاب المشاريع.
      </blockquote>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const flowContainer = document.querySelector('.mr-flow');
    const section = document.querySelector('.mr-section');
    if (!flowContainer || !section) return;

    const brandChips = flowContainer.querySelectorAll('[data-mr-chip]');
    const segmentCards = flowContainer.querySelectorAll('[data-mr-segment]');
    const pathBrandElements = flowContainer.querySelectorAll('[data-path-brand]');
    const pathMarketElements = flowContainer.querySelectorAll('[data-path-market]');
    const hub = flowContainer.querySelector('[data-mr-hub]');

    const clearAll = () => {
      flowContainer.classList.remove('has-hover', 'hover-brand', 'hover-segment');
      section.className = 'section mr-section layer-cinematic';
      
      brandChips.forEach(el => el.classList.remove('is-active', 'is-highlighted'));
      segmentCards.forEach(el => el.classList.remove('is-active', 'is-highlighted'));
      pathBrandElements.forEach(el => el.classList.remove('is-active', 'is-secondary'));
      pathMarketElements.forEach(el => el.classList.remove('is-active', 'is-secondary'));
      hub?.classList.remove('is-active');
    };

    // Brand Hovers
    brandChips.forEach(chip => {
      chip.addEventListener('pointerenter', () => {
        clearAll();
        const brandId = chip.getAttribute('data-id');
        const targetsStr = chip.getAttribute('data-targets') || '';
        const targets = targetsStr.split(',');

        flowContainer.classList.add('has-hover', 'hover-brand');
        section.classList.add(`hover-${brandId}`);
        
        chip.classList.add('is-active');
        hub?.classList.add('is-active');

        // Highlight matching brand path (100%)
        const pathBrand = flowContainer.querySelector(`[data-path-brand="${brandId}"]`);
        pathBrand?.classList.add('is-active');

        // Highlight target segments & market paths (Secondary)
        targets.forEach(targetId => {
          const segment = flowContainer.querySelector(`[data-id="${targetId}"]`);
          segment?.classList.add('is-highlighted');

          const pathMarket = flowContainer.querySelector(`[data-path-market="${targetId}"]`);
          pathMarket?.classList.add('is-secondary');
        });
      });

      chip.addEventListener('pointerleave', clearAll);
    });

    // Segment Hovers
    segmentCards.forEach(card => {
      card.addEventListener('pointerenter', () => {
        clearAll();
        const segmentId = card.getAttribute('data-id');
        const sourcesStr = card.getAttribute('data-sources') || '';
        const sources = sourcesStr.split(',');

        flowContainer.classList.add('has-hover', 'hover-segment');
        section.classList.add(`hover-seg-${segmentId}`);
        
        card.classList.add('is-active');
        hub?.classList.add('is-active');

        // Highlight matching market path (100%)
        const pathMarket = flowContainer.querySelector(`[data-path-market="${segmentId}"]`);
        pathMarket?.classList.add('is-active');

        // Highlight source brands & brand paths (Secondary)
        sources.forEach(sourceId => {
          const brand = flowContainer.querySelector(`[data-id="${sourceId}"]`);
          brand?.classList.add('is-highlighted');

          const pathBrand = flowContainer.querySelector(`[data-path-brand="${sourceId}"]`);
          pathBrand?.classList.add('is-secondary');
        });
      });

      card.addEventListener('pointerleave', clearAll);
    });
  });
</script>

<style>
/* ────────────────────────────────────────────────────────────────────────
   Market Role Section — دور تجدد في السوق
   Premium styling, interactive flows, glassmorphism, and laser line flow
   ──────────────────────────────────────────────────────────────────────── */

.mr-section.layer-cinematic {
  position: relative;
  overflow: hidden;
  padding: clamp(90px, 11vw, 150px) 0;
  background: radial-gradient(circle at 50% 30%, #0d2a37 0%, #081a24 50%, #040b10 100%);
  color: #fff;
  /* CSS Variables for Dynamic Highlight Colors */
  --active-brand-color: rgba(255, 255, 255, 0.4);
  --active-brand-color-rgb: 255, 255, 255;
  transition: background 0.6s ease;
}

/* Background Gradients & Glows */
.mr-section.layer-cinematic.hover-cnc {
  background: radial-gradient(circle at 50% 30%, #3a0909 0%, #1f0404 60%, #020906 100%);
  --active-brand-color: #e63946;
  --active-brand-color-rgb: 230, 57, 70;
}
.mr-section.layer-cinematic.hover-liper {
  background: radial-gradient(circle at 50% 30%, #2f441c 0%, #15200d 60%, #070c03 100%);
  --active-brand-color: var(--tj-orange);
  --active-brand-color-rgb: 255, 140, 0;
}

.mr-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.mr-bg__grid {
  position: absolute;
  inset: 0;
  opacity: 0.05;
  background-image:
    linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse at 50% 45%, #000 20%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 45%, #000 20%, transparent 75%);
}

.mr-bg__glow {
  position: absolute;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  filter: blur(140px);
  opacity: 0.15;
  transition: background 0.6s ease, transform 0.6s ease;
}

.mr-bg__glow--1 {
  top: 10%;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(30, 153, 211, 0.4);
}
.mr-section.layer-cinematic.hover-cnc .mr-bg__glow--1 { background: rgba(230, 57, 70, 0.5); }
.mr-section.layer-cinematic.hover-liper .mr-bg__glow--1 { background: rgba(255, 140, 0, 0.55); }

.mr-bg__glow--2 {
  bottom: 10%;
  right: -5%;
  background: rgba(255, 140, 0, 0.25);
  animation: mrGlowDrift 16s ease-in-out infinite alternate;
}

.mr-bg__glow--3 {
  bottom: 10%;
  left: -5%;
  background: rgba(21, 150, 71, 0.25);
  animation: mrGlowDrift 18s ease-in-out infinite alternate-reverse;
}

@keyframes mrGlowDrift {
  0% { transform: translate(0,0) scale(1); }
  100% { transform: translate(40px, -20px) scale(1.1); }
}

.mr-particle {
  position: absolute;
  left: var(--px);
  top: var(--py);
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
  animation: mrPFloat var(--dur) ease-in-out var(--del) infinite;
}

@keyframes mrPFloat {
  0%, 100% { transform: translate(0,0); opacity: 0; }
  20% { opacity: 0.8; }
  50% { transform: translate(var(--dx), var(--dy)); opacity: 0.4; }
  80% { opacity: 0.15; }
}

.mr-container {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(50px, 7vw, 90px);
}

/* Header */
.mr-header {
  text-align: center;
  max-width: 760px;
}

.mr-eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 20px;
}

.mr-eyebrow__line {
  width: 48px;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(155, 232, 255, 0.6));
}

.mr-eyebrow__line:last-child {
  background: linear-gradient(90deg, rgba(155, 232, 255, 0.6), transparent);
}

.mr-eyebrow__text {
  color: var(--tj-blue-light);
  font-size: var(--tj-text-small);
  font-weight: var(--tj-font-semibold);
  letter-spacing: 0.08em;
}

.mr-title {
  color: #fff;
  font-size: clamp(1.8rem, 3.8vw, 2.6rem);
  font-weight: var(--tj-font-bold);
  line-height: 1.35;
  margin-bottom: 18px;
}

.mr-title__accent {
  display: block;
  margin-top: 6px;
  background: linear-gradient(135deg, var(--tj-blue-light), var(--tj-green-light) 50%, var(--tj-blue));
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: mrGradText 6s ease-in-out infinite;
}

@keyframes mrGradText {
  0%, 100% { background-position: 0% center; }
  50% { background-position: 100% center; }
}

.mr-subtitle {
  color: rgba(255,255,255,0.65);
  font-size: var(--tj-text-body-lg);
  line-height: 1.85;
  max-width: 680px;
  margin: 0 auto;
}

/* ────────────────────────────────────────────────────────────────────────
   Flow Zone — Hub & Spoke
   ──────────────────────────────────────────────────────────────────────── */

.mr-flow {
  direction: ltr;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  grid-template-areas: "market hub brands";
  gap: 0;
  align-items: center;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  position: relative;
}

.mr-mobile-flow {
  display: none;
}

.mr-flow__col-label {
  display: block;
  margin-bottom: 24px;
  color: rgba(255,255,255,0.4);
  font-size: var(--tj-text-small);
  font-weight: var(--tj-font-semibold);
  letter-spacing: 0.08em;
  text-align: center;
  text-transform: uppercase;
}

/* Left: Brands */
.mr-flow__brands {
  grid-area: brands;
  direction: rtl;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}

.mr-flow__brand-stack {
  display: flex;
  flex-direction: column;
  gap: 20px;
  width: 100%;
  max-width: 290px;
}

/* Glassmorphism Chip */
.mr-brand-chip {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  background: rgba(255, 255, 255, 0.02);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 24px;
  cursor: pointer;
  transition:
    transform 0.4s var(--tj-ease-smooth),
    border-color 0.4s ease,
    box-shadow 0.4s ease,
    opacity 0.4s ease;
  user-select: none;
}

.mr-brand-chip:hover,
.mr-brand-chip.is-active {
  transform: translateX(-6px);
  border-color: var(--chip-accent);
  box-shadow:
    0 15px 40px rgba(0,0,0,0.35),
    0 0 20px rgba(var(--chip-accent-rgb), 0.25);
  background: rgba(255, 255, 255, 0.04);
}

.mr-brand-chip.is-highlighted {
  border-color: rgba(var(--chip-accent-rgb), 0.5);
  box-shadow: 0 0 15px rgba(var(--chip-accent-rgb), 0.15);
  background: rgba(255, 255, 255, 0.03);
}

/* Chip inner colors based on ID */
.mr-brand-chip[data-id="cnc"] { --chip-accent: #e63946; --chip-accent-rgb: 230, 57, 70; }
.mr-brand-chip[data-id="liper"] { --chip-accent: var(--tj-orange); --chip-accent-rgb: 255, 140, 0; }

.mr-brand-chip__logo {
  display: grid;
  place-items: center;
  width: 76px;
  height: 48px;
  flex-shrink: 0;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.05);
  transition: background 0.3s, border-color 0.3s;
}

.mr-brand-chip:hover .mr-brand-chip__logo,
.mr-brand-chip.is-active .mr-brand-chip__logo {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(var(--chip-accent-rgb), 0.3);
}

.mr-brand-chip__logo img {
  max-width: 58px;
  max-height: 32px;
  object-fit: contain;
  filter: brightness(0) invert(1);
  opacity: 0.85;
  transition: opacity 0.3s, transform 0.3s;
}

.mr-brand-chip:hover img {
  opacity: 1;
  transform: scale(1.05);
}

.mr-brand-chip__info strong {
  display: block;
