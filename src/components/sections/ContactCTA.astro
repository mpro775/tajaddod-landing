---
import type { Locale } from '../../lib/api/types';
import { dictionary } from '../../i18n';
import { contactLinks as buildContactLinks } from '../../data/site';
import { localePath } from '../../lib/content';

const { locale } = Astro.props as { locale: Locale };
const contact = dictionary(locale).home.contact;
const contactLinks = buildContactLinks({
  whatsapp: contact.whatsappMessage,
  emailSubject: contact.emailSubject,
});
const buttons = [
  { label: contact.whatsapp, href: contactLinks.whatsapp, variant: 'primary' },
  { label: contact.email, href: contactLinks.email, variant: 'secondary' },
];
---

<section class="section cta-section layer-corporate-alt" id="contact">
  <div class="cta-bg" aria-hidden="true">
    <div class="cta-bg__grid"></div>
    <div class="cta-bg__glow cta-bg__glow--1"></div>
    <div class="cta-bg__glow cta-bg__glow--2"></div>
  </div>

  <div class="container cta-container">
    <div class="cta-card" data-reveal>
      <div class="cta-card__inner">
        
        <div class="cta-content">
          <div class="cta-eyebrow">
            <span class="cta-eyebrow__line"></span>
            <span class="cta-eyebrow__text">{contact.eyebrow}</span>
            <span class="cta-eyebrow__line"></span>
          </div>
          
          <h2 class="cta-title">{contact.title}</h2>
          <p class="cta-desc">{contact.description}</p>
          
          <div class="cta-actions">
            {buttons.map(btn => (
              <a href={btn.href} class={`cta-btn cta-btn--${btn.variant}`}>
                {btn.variant === 'primary' && (
                  <span class="cta-btn__icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.06-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413z"/>
                    </svg>
                  </span>
                )}
                {btn.variant === 'secondary' && (
                  <span class="cta-btn__icon">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                  </span>
                )}
                {btn.label}
              </a>
            ))}
          </div>
          
        </div>

        <div class="cta-decoration" aria-hidden="true">
          <div class="cta-orb cta-orb--blue"></div>
          <div class="cta-orb cta-orb--green"></div>
        </div>

      </div>
    </div>
  </div>
</section>

<div class="mobile-sticky-cta" data-mobile-sticky-cta aria-label={contact.quickLabel}>
  <a class="mobile-sticky-cta__primary" href={contactLinks.whatsapp}>{contact.quickWhatsapp}</a>
  <a class="mobile-sticky-cta__secondary" href={`${localePath(locale, '/')}#contact`}>{contact.quickBusiness}</a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const stickyCta = document.querySelector('[data-mobile-sticky-cta]');
    if (!stickyCta) return;

    const mobileQuery = window.matchMedia('(max-width: 767px)');
    let ticking = false;

    const updateStickyCta = () => {
      ticking = false;
      if (!mobileQuery.matches) {
        stickyCta.classList.remove('is-visible');
        return;
      }

      const footer = document.querySelector('.site-footer');
      const contactSection = document.querySelector('.cta-section');
      const nearFooter = footer ? footer.getBoundingClientRect().top < window.innerHeight + 140 : false;
      const contactRect = contactSection?.getBoundingClientRect();
      const contactVisible = contactRect
        ? contactRect.top < window.innerHeight * 0.82 && contactRect.bottom > window.innerHeight * 0.18
        : false;
      const shouldShow = window.scrollY > 480 && !nearFooter && !contactVisible;
      stickyCta.classList.toggle('is-visible', shouldShow);
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateStickyCta);
    };

    updateStickyCta();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  });
</script>

<style>
/* ────────────────────────────────────────────────────────────────────────
   Contact CTA Section
   ──────────────────────────────────────────────────────────────────────── */

.cta-section {
  position: relative;
  overflow: hidden;
  padding: clamp(80px, 12vw, 160px) 0;
  background: var(--tj-bg-section-alt);
  color: var(--tj-text-primary);
}

/* Background Layers */
.cta-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.cta-bg__grid {
  position: absolute;
  inset: 0;
  opacity: 0.04;
  background-image:
    linear-gradient(var(--tj-inverse-alpha-08) 1px, transparent 1px),
    linear-gradient(90deg, var(--tj-inverse-alpha-08) 1px, transparent 1px);
  background-size: 64px 64px;
  mask-image: radial-gradient(ellipse at 50% 50%, var(--tj-neutral-950) 20%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 50%, var(--tj-neutral-950) 20%, transparent 80%);
}

.cta-bg__glow {
  position: absolute;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.15;
}

.cta-bg__glow--1 {
  top: -20%;
  left: -10%;
  background: var(--tj-blue);
}

.cta-bg__glow--2 {
  bottom: -20%;
  right: -10%;
  background: var(--tj-green);
}

.cta-container {
  position: relative;
  z-index: 1;
}

/* CTA Card */
.cta-card {
  position: relative;
  max-width: 900px;
  margin: 0 auto;
  border-radius: 32px;
  background: var(--tj-bg-surface-raised);
  border: 1px solid var(--tj-border-default);
  padding: clamp(40px, 8vw, 80px);
  overflow: hidden;
  box-shadow: 0 40px 80px color-mix(in srgb, var(--tj-neutral-950) 50%, transparent);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.cta-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 32px;
  padding: 1px;
  background: linear-gradient(135deg, var(--tj-inverse-alpha-10), rgba(255,255,255,0) 50%, var(--tj-inverse-alpha-05));
  -webkit-mask: linear-gradient(var(--tj-text-inverse) 0 0) content-box, linear-gradient(var(--tj-text-inverse) 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.cta-card__inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* Content */
.cta-eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 24px;
}

.cta-eyebrow__line {
  width: 40px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--tj-blue-light));
}

.cta-eyebrow__line:last-child {
  background: linear-gradient(90deg, var(--tj-blue-light), transparent);
}

.cta-eyebrow__text {
  color: var(--tj-blue-light);
  font-size: var(--tj-text-small);
  font-weight: var(--tj-font-semibold);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.cta-title {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: var(--tj-font-bold);
  line-height: 1.2;
  margin-bottom: 20px;
  color: var(--tj-text-primary);
  background: none;
  -webkit-text-fill-color: currentColor;
}

.cta-desc {
  font-size: var(--tj-text-body-lg);
  color: var(--tj-text-secondary);
  line-height: 1.8;
  max-width: 600px;
  margin: 0 auto 48px;
}

/* Actions */
.cta-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 20px;
}

.cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 16px 32px;
  border-radius: 100px;
  font-size: var(--tj-text-body);
  font-weight: var(--tj-font-semibold);
  text-decoration: none;
  transition: all 0.3s ease;
}

.cta-btn__icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.cta-btn--primary {
  background: var(--tj-green);
  color: var(--tj-text-inverse);
  box-shadow: 0 10px 30px color-mix(in srgb, var(--tj-green) 30%, transparent);
}

.cta-btn--primary:hover {
  background: #18ab51; /* slightly lighter */
  transform: translateY(-2px);
  box-shadow: 0 15px 40px color-mix(in srgb, var(--tj-green) 40%, transparent);
}

.cta-btn--secondary {
  background: var(--tj-bg-surface);
  color: var(--tj-text-primary);
  border: 1px solid var(--tj-border-default);
}

.cta-btn--secondary:hover {
  background: var(--tj-action-soft);
  border-color: var(--tj-border-strong);
  transform: translateY(-2px);
}

/* Decorative Orbs inside card */
.cta-decoration {
  position: absolute;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  border-radius: 32px;
}

.cta-orb {
  position: absolute;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.2;
}

.cta-orb--blue {
  top: -100px;
  right: -100px;
  background: var(--tj-blue);
  animation: floatOrb 8s ease-in-out infinite alternate;
}

.cta-orb--green {
  bottom: -100px;
  left: -100px;
  background: var(--tj-green);
  animation: floatOrb 10s ease-in-out infinite alternate-reverse;
}

@keyframes floatOrb {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(30px, 30px) scale(1.1); }
}

@media (max-width: 767px) {
  .cta-actions {
    flex-direction: column;
    width: 100%;
  }
  .cta-btn {
    width: 100%;
  }
}

.mobile-sticky-cta {
  position: fixed;
  z-index: 70;
  right: 12px;
  left: 12px;
  bottom: 10px;
  display: none;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 10px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  border: 1px solid var(--tj-inverse-alpha-12);
  border-radius: 22px;
  background: rgba(3, 10, 15, .82);
  box-shadow: 0 20px 60px color-mix(in srgb, var(--tj-neutral-950) 36%, transparent), inset 0 1px 0 var(--tj-inverse-alpha-08);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  opacity: 0;
  pointer-events: none;
  transform: translateY(18px);
  transition: opacity .22s ease, transform .22s ease;
}

.mobile-sticky-cta a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  border-radius: 16px;
  font-size: .9rem;
  font-weight: var(--tj-font-bold);
}

.mobile-sticky-cta__primary {
  color: var(--tj-text-inverse);
  background: var(--tj-green);
  box-shadow: 0 12px 28px color-mix(in srgb, var(--tj-green) 22%, transparent);
}

.mobile-sticky-cta__secondary {
  color: var(--tj-text-inverse);
  border: 1px solid var(--tj-inverse-alpha-10);
  background: var(--tj-inverse-alpha-07);
}

@media (max-width: 767px) {
  .mobile-sticky-cta {
    display: grid;
  }

  .mobile-sticky-cta.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
}
</style>
