---
import type { Locale } from '../../lib/api/types';
import type { VisualBrand } from '../../lib/visual/legacy-view';
import { localePath } from '../../lib/content';
import { dictionary, formatMessage } from '../../i18n';

interface Props {
  brand: VisualBrand;
  locale: Locale;
}

const { brand, locale } = Astro.props;
const labels = dictionary(locale).brands.hero;

const accentMap: Record<string, { color: string; rgb: string; gradient: string }> = {
  cnc: { color: '#e63946', rgb: '230, 57, 70', gradient: 'linear-gradient(135deg, #e63946, #ff6b6b)' },
  liper: { color: '#ff8c00', rgb: '255, 140, 0', gradient: 'linear-gradient(135deg, #ff8c00, #ffb347)' },
};

const accent = accentMap[brand.id] || accentMap.cnc;
---

<section class="brand-hero theme-inverse" style={`--accent: ${accent.color}; --accent-rgb: ${accent.rgb};`}>
  <!-- Layered background -->
  <div class="brand-hero__bg" aria-hidden="true">
    <div class="brand-hero__gradient"></div>
    <div class="brand-hero__grid"></div>
    <div class="brand-hero__glow brand-hero__glow--1"></div>
    <div class="brand-hero__glow brand-hero__glow--2"></div>
    <div class="brand-hero__glow brand-hero__glow--3"></div>

    <!-- Energy lines -->
    <span class="brand-hero__energy-line" style="top: 18%; animation-delay: 0s;"></span>
    <span class="brand-hero__energy-line" style="top: 42%; animation-delay: -2.5s;"></span>
    <span class="brand-hero__energy-line" style="top: 72%; animation-delay: -5s;"></span>

    <!-- Floating particles -->
    <span class="brand-hero__particle" style="left: 10%; top: 20%; --dur: 6s; --del: 0s;"></span>
    <span class="brand-hero__particle" style="left: 80%; top: 30%; --dur: 8s; --del: 1s;"></span>
    <span class="brand-hero__particle" style="left: 45%; top: 75%; --dur: 7s; --del: 2.5s;"></span>
    <span class="brand-hero__particle" style="left: 25%; top: 60%; --dur: 5.5s; --del: 4s;"></span>
    <span class="brand-hero__particle" style="left: 70%; top: 80%; --dur: 9s; --del: 1.5s;"></span>
  </div>

  <div class="container brand-hero__container">
    <!-- Breadcrumb -->
    <nav class="brand-hero__breadcrumb" aria-label={labels.breadcrumb}>
      <a href={localePath(locale, '/')}>{labels.home}</a>
      <svg class="directional-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      <a href={`${localePath(locale, '/')}#brands`}>{labels.brands}</a>
      <svg class="directional-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      <span>{brand.displayName}</span>
    </nav>

    <div class="brand-hero__content">
      <!-- Logo with orbit ring -->
      <div class="brand-hero__logo-orbit">
        <div class="brand-hero__orbit-ring"></div>
        <div class="brand-hero__orbit-ring brand-hero__orbit-ring--2"></div>
        <div class="brand-hero__logo-wrapper">
          <img src={brand.whiteLogo} alt={brand.name} class="brand-hero__logo" width="120" height="120" />
        </div>
      </div>

      <!-- Category pill -->
      <span class="brand-hero__category">{brand.category}</span>

      <!-- Title with gradient accent -->
      <h1 class="brand-hero__title">
        {brand.heroTitle}
      </h1>

      <!-- Description -->
      <p class="brand-hero__desc">{brand.shortDescription}</p>

      <!-- Action buttons -->
      <div class="brand-hero__actions">
        <a href={`${localePath(locale, '/')}#contact`} class="brand-hero__btn brand-hero__btn--primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          <span>{formatMessage(labels.contact, { brand: brand.name })}</span>
        </a>
        {brand.officialWebsite && (
          <a href={brand.officialWebsite} target="_blank" rel="noopener noreferrer" class="brand-hero__btn brand-hero__btn--outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            <span>{labels.officialWebsite}</span>
          </a>
        )}
      </div>

      <!-- Trust badges -->
      <div class="brand-hero__badges">
        <div class="brand-hero__badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>{labels.representative}</span>
        </div>
        <div class="brand-hero__badge-divider"></div>
        <div class="brand-hero__badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>{labels.warranty}</span>
        </div>
        <div class="brand-hero__badge-divider"></div>
        <div class="brand-hero__badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>{labels.delivery}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="brand-hero__scroll" aria-hidden="true">
    <div class="brand-hero__scroll-line"></div>
  </div>
</section>

<style>
  .brand-hero {
    position: relative;
    padding: clamp(140px, 18vw, 200px) 0 clamp(80px, 10vw, 120px);
    overflow: hidden;
    color: var(--tj-text-inverse);
    text-align: center;
    min-height: 85vh;
    display: flex;
    align-items: center;
  }

  /* ── Background layers ─────────────────────────────────────── */
  .brand-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .brand-hero__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      155deg,
      #040d12 0%,
      #081d28 25%,
      #0c2b36 50%,
      #091f2b 75%,
      #040d12 100%
    );
  }

  .brand-hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image:
      linear-gradient(var(--tj-inverse-alpha-15) 1px, transparent 1px),
      linear-gradient(90deg, var(--tj-inverse-alpha-15) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse at 50% 30%, var(--tj-neutral-950) 10%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 30%, var(--tj-neutral-950) 10%, transparent 70%);
  }

  .brand-hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
    pointer-events: none;
  }

  .brand-hero__glow--1 {
    top: -15%;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 700px;
    background: rgba(var(--accent-rgb), 0.18);
    animation: heroGlowPulse 6s ease-in-out infinite;
  }

  .brand-hero__glow--2 {
    bottom: -10%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: color-mix(in srgb, var(--tj-blue) 10%, transparent);
    animation: heroGlowFloat 12s ease-in-out infinite alternate;
  }

  .brand-hero__glow--3 {
    top: 50%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: color-mix(in srgb, var(--tj-green-light) 8%, transparent);
    animation: heroGlowFloat 15s ease-in-out infinite alternate-reverse;
  }

  @keyframes heroGlowPulse {
    0%, 100% { opacity: 0.6; transform: translateX(-50%) scale(1); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.08); }
  }

  @keyframes heroGlowFloat {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(30px, -20px) scale(1.12); }
  }

  /* Energy lines */
  .brand-hero__energy-line {
    position: absolute;
    height: 2px;
    width: 50vw;
    background: linear-gradient(90deg, transparent, rgba(var(--accent-rgb), 0.5), color-mix(in srgb, var(--tj-blue) 40%, transparent), transparent);
    filter: drop-shadow(0 0 10px rgba(var(--accent-rgb), 0.4));
    animation: heroLineFlow 8s linear infinite;
    opacity: 0.4;
    pointer-events: none;
    right: -20vw;
  }

  @keyframes heroLineFlow {
    from { transform: translateX(-30vw); }
    to { transform: translateX(120vw); }
  }

  /* Floating particles */
  .brand-hero__particle {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(var(--accent-rgb), 0.6);
    box-shadow: 0 0 8px rgba(var(--accent-rgb), 0.4);
    animation: heroParticle var(--dur) ease-in-out var(--del) infinite;
    pointer-events: none;
  }

  @keyframes heroParticle {
    0%, 100% { transform: translateY(0) scale(1); opacity: 0; }
    15% { opacity: 0.8; }
    50% { transform: translateY(-60px) scale(1.3); opacity: 0.4; }
    85% { opacity: 0.1; }
  }

  /* ── Container & Layout ────────────────────────────────────── */
  .brand-hero__container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Breadcrumb ────────────────────────────────────────────── */
  .brand-hero__breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 40px;
    font-size: var(--tj-text-small);
    color: var(--tj-inverse-alpha-50);
  }

  .brand-hero__breadcrumb a {
    color: var(--tj-inverse-alpha-55);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .brand-hero__breadcrumb a:hover {
    color: var(--accent);
  }

  .brand-hero__breadcrumb svg {
    width: 14px;
    height: 14px;
    opacity: 0.4;
  }

  .brand-hero__breadcrumb span {
    color: var(--accent);
    font-weight: var(--tj-font-semibold);
  }

  /* ── Content ───────────────────────────────────────────────── */
  .brand-hero__content {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Logo with orbit ───────────────────────────────────────── */
  .brand-hero__logo-orbit {
    position: relative;
    width: 180px;
    height: 180px;
    margin-bottom: 36px;
  }

  .brand-hero__orbit-ring {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px solid rgba(var(--accent-rgb), 0.15);
    animation: orbitSpin 20s linear infinite;
  }

  .brand-hero__orbit-ring::after {
    content: '';
    position: absolute;
    top: 4px;
    right: 4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px rgba(var(--accent-rgb), 0.6);
  }

  .brand-hero__orbit-ring--2 {
    inset: -22px;
    border-color: var(--tj-inverse-alpha-06);
    animation-duration: 30s;
    animation-direction: reverse;
  }

  .brand-hero__orbit-ring--2::after {
    width: 5px;
    height: 5px;
    background: rgba(155, 232, 255, 0.5);
    box-shadow: 0 0 8px rgba(155, 232, 255, 0.4);
  }

  @keyframes orbitSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .brand-hero__logo-wrapper {
    position: absolute;
    inset: 0;
    background: var(--tj-inverse-alpha-04);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 50%;
    border: 1px solid rgba(var(--accent-rgb), 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 36px;
    box-shadow:
      0 0 40px rgba(var(--accent-rgb), 0.1),
      inset 0 0 30px rgba(var(--accent-rgb), 0.05);
    transition: box-shadow 0.5s ease;
  }

  .brand-hero__logo-orbit:hover .brand-hero__logo-wrapper {
    box-shadow:
      0 0 60px rgba(var(--accent-rgb), 0.2),
      inset 0 0 40px rgba(var(--accent-rgb), 0.08);
  }

  .brand-hero__logo {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 4px 20px rgba(var(--accent-rgb), 0.15));
  }

  /* ── Category pill ─────────────────────────────────────────── */
  .brand-hero__category {
    display: inline-flex;
    align-items: center;
    padding: 8px 20px;
    border-radius: 999px;
    background: rgba(var(--accent-rgb), 0.1);
    border: 1px solid rgba(var(--accent-rgb), 0.2);
    color: var(--accent);
    font-size: var(--tj-text-small);
    font-weight: var(--tj-font-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 22px;
  }

  /* ── Title ──────────────────────────────────────────────────── */
  .brand-hero__title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: var(--tj-font-bold);
    line-height: 1.2;
    margin-bottom: 24px;
    color: var(--tj-text-inverse);
    max-width: 700px;
  }

  /* ── Description ───────────────────────────────────────────── */
  .brand-hero__desc {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--tj-inverse-alpha-60);
    line-height: 1.9;
    margin-bottom: 40px;
    max-width: 620px;
  }

  /* ── Action buttons ────────────────────────────────────────── */
  .brand-hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 48px;
  }

  .brand-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    border-radius: 14px;
    font-weight: var(--tj-font-semibold);
    text-decoration: none;
    transition: all 0.35s var(--tj-ease-smooth);
    font-size: 0.95rem;
  }

  .brand-hero__btn svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .brand-hero__btn--primary {
    background: var(--accent);
    color: var(--tj-text-inverse);
    box-shadow: 0 12px 32px rgba(var(--accent-rgb), 0.3);
  }

  .brand-hero__btn--primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 42px rgba(var(--accent-rgb), 0.4);
    filter: brightness(1.08);
  }

  .brand-hero__btn--outline {
    background: var(--tj-inverse-alpha-05);
    color: var(--tj-text-inverse);
    border: 1px solid var(--tj-inverse-alpha-15);
    backdrop-filter: blur(10px);
  }

  .brand-hero__btn--outline:hover {
    background: var(--tj-inverse-alpha-10);
    border-color: var(--tj-inverse-alpha-30);
    transform: translateY(-3px);
  }

  /* ── Trust badges ──────────────────────────────────────────── */
  .brand-hero__badges {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px 28px;
    border-radius: 20px;
    background: var(--tj-inverse-alpha-03);
    border: 1px solid var(--tj-inverse-alpha-06);
    backdrop-filter: blur(12px);
  }

  .brand-hero__badge {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--tj-inverse-alpha-55);
    font-size: var(--tj-text-small);
  }

  .brand-hero__badge svg {
    width: 22px;
    height: 22px;
    color: var(--accent);
    opacity: 0.8;
  }

  .brand-hero__badge-divider {
    width: 1px;
    height: 18px;
    background: var(--tj-inverse-alpha-10);
  }

  /* ── Scroll indicator ──────────────────────────────────────── */
  .brand-hero__scroll {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .brand-hero__scroll-line {
    width: 2px;
    height: 40px;
    border-radius: 2px;
    background: linear-gradient(180deg, rgba(var(--accent-rgb), 0.6), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 0.8; transform: scaleY(1); }
  }

  /* ── Responsive ────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .brand-hero {
      min-height: auto;
      padding: 120px 0 60px;
    }

    .brand-hero__logo-orbit {
      width: 140px;
      height: 140px;
      margin-bottom: 28px;
    }

    .brand-hero__logo-wrapper {
      padding: 28px;
    }

    .brand-hero__badges {
      flex-direction: column;
      gap: 12px;
      padding: 18px 24px;
    }

    .brand-hero__badge-divider {
      width: 40px;
      height: 1px;
    }

    .brand-hero__energy-line:nth-child(5) {
      display: none;
    }

    .brand-hero__scroll {
      display: none;
    }
  }

  @media (max-width: 359px) {
    .brand-hero__actions {
      width: 100%;
    }

    .brand-hero__btn {
      width: 100%;
      justify-content: center;
    }

    .brand-hero__breadcrumb {
      font-size: var(--tj-text-micro);
    }
  }
</style>
