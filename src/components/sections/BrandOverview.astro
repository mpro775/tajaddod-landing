---
import type { Locale } from '../../lib/api/types';
import type { VisualBrand } from '../../lib/visual/legacy-view';
import { dictionary, formatMessage } from '../../i18n';

interface Props {
  brand: VisualBrand;
  locale: Locale;
}

const { brand, locale } = Astro.props;
const labels = dictionary(locale).brands.overview;

const accentMap: Record<string, { color: string; rgb: string }> = {
  cnc: { color: '#e63946', rgb: '230, 57, 70' },
  liper: { color: '#ff8c00', rgb: '255, 140, 0' },
};

const accent = accentMap[brand.id] || accentMap.cnc;

// Stats data
const stats = [
  { icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z M12 13a3 3 0 100-6 3 3 0 000 6z', label: labels.country, value: brand.country },
  { icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z', label: labels.representative, value: brand.representedBy },
  { icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2 M12 12h.01M12 16h.01M12 8h.01', label: labels.specialtiesCount, value: formatMessage(labels.specialtiesValue, { count: brand.specialties.length }) },
];
---

<section class="brand-overview section" id="brand-overview" style={`--accent: ${accent.color}; --accent-rgb: ${accent.rgb};`}>
  <div class="container">
    <!-- Section eyebrow -->
    <div class="overview-eyebrow">
      <span class="overview-eyebrow__line"></span>
      <span class="overview-eyebrow__tag">{labels.eyebrow}</span>
      <span class="overview-eyebrow__line"></span>
    </div>

    <h2 class="overview-title">
      {labels.about} <span class="overview-title__accent">{brand.name}</span>
    </h2>

    <div class="overview-grid">
      <!-- Main content -->
      <div class="overview-main">
        <p class="overview-text">{brand.longDescription}</p>

        <!-- Why Tajaddod card -->
        <div class="overview-why">
          <div class="overview-why__header">
            <div class="overview-why__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m13 2-2 7h7l-8 13 2-8H5l8-12Z" />
              </svg>
            </div>
            <h3>{labels.why}</h3>
          </div>
          <p>{formatMessage(labels.whyText, { brand: brand.name })}</p>
        </div>

        <!-- Stats row -->
        <div class="overview-stats">
          {stats.map((stat) => (
            <div class="overview-stat">
              <div class="overview-stat__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d={stat.icon} />
                </svg>
              </div>
              <div class="overview-stat__text">
                <span class="overview-stat__label">{stat.label}</span>
                <strong class="overview-stat__value">{stat.value}</strong>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Specialties sidebar -->
      <div class="overview-sidebar">
        <div class="overview-specialties">
          <div class="overview-specialties__header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <h3>{labels.specialties}</h3>
          </div>
          <ul class="specialties-list">
            {brand.specialties.map((spec, index) => (
              <li class="specialty-item" style={`animation-delay: ${index * 80}ms;`}>
                <div class="specialty-item__check">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6L9 17L4 12" />
                  </svg>
                </div>
                <span>{spec}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Product families -->
        <div class="overview-families">
          <h4>{labels.families}</h4>
          <div class="overview-families__grid">
            {brand.productFamilies.map((fam) => (
              <span class="overview-family-tag">{fam}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .brand-overview {
    padding: clamp(70px, 9vw, 110px) 0;
    color: var(--tj-text-inverse);
    position: relative;
    z-index: 1;
  }

  /* ── Section eyebrow ───────────────────────────────────────── */
  .overview-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .overview-eyebrow__line {
    width: 44px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(var(--accent-rgb), 0.45));
  }

  .overview-eyebrow__line:last-child {
    background: linear-gradient(90deg, rgba(var(--accent-rgb), 0.45), transparent);
  }

  .overview-eyebrow__tag {
    color: var(--accent);
    font-size: var(--tj-text-small);
    font-weight: var(--tj-font-semibold);
    letter-spacing: 0.06em;
  }

  /* ── Title ──────────────────────────────────────────────────── */
  .overview-title {
    text-align: center;
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: var(--tj-font-bold);
    margin-bottom: clamp(36px, 5vw, 56px);
    color: var(--tj-text-inverse);
  }

  .overview-title__accent {
    color: var(--accent);
  }

  /* ── Grid layout ───────────────────────────────────────────── */
  .overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 1024px) {
    .overview-grid {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 48px;
    }
  }

  /* ── Main content ──────────────────────────────────────────── */
  .overview-main {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .overview-text {
    color: var(--tj-inverse-alpha-65);
    font-size: 1.08rem;
    line-height: 1.9;
    margin: 0;
  }

  /* ── Why Tajaddod card ─────────────────────────────────────── */
  .overview-why {
    background: rgba(var(--accent-rgb), 0.04);
    border: 1px solid rgba(var(--accent-rgb), 0.1);
    border-radius: 22px;
    padding: 28px;
    backdrop-filter: blur(10px);
    transition: border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .overview-why:hover {
    border-color: rgba(var(--accent-rgb), 0.2);
    box-shadow: 0 8px 30px rgba(var(--accent-rgb), 0.06);
  }

  .overview-why__header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .overview-why__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(var(--accent-rgb), 0.1);
    color: var(--accent);
    flex-shrink: 0;
  }

  .overview-why__icon svg {
    width: 24px;
    height: 24px;
  }

  .overview-why h3 {
    font-size: 1.2rem;
    color: var(--accent);
    margin: 0;
  }

  .overview-why p {
    color: var(--tj-inverse-alpha-55);
    line-height: 1.8;
    margin: 0;
    font-size: 0.98rem;
  }

  /* ── Stats ──────────────────────────────────────────────────── */
  .overview-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .overview-stat {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 16px;
    border-radius: 18px;
    background: var(--tj-inverse-alpha-03);
    border: 1px solid var(--tj-inverse-alpha-06);
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .overview-stat:hover {
    border-color: rgba(var(--accent-rgb), 0.15);
    background: rgba(var(--accent-rgb), 0.04);
  }

  .overview-stat__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(var(--accent-rgb), 0.08);
    color: var(--accent);
    flex-shrink: 0;
  }

  .overview-stat__icon svg {
    width: 24px;
    height: 24px;
  }

  .overview-stat__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .overview-stat__label {
    font-size: var(--tj-text-micro);
    color: var(--tj-inverse-alpha-40);
  }

  .overview-stat__value {
    font-size: 0.95rem;
    color: var(--tj-text-inverse);
    font-weight: var(--tj-font-semibold);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Sidebar ───────────────────────────────────────────────── */
  .overview-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ── Specialties ───────────────────────────────────────────── */
  .overview-specialties {
    background: var(--tj-inverse-alpha-02);
    border: 1px solid var(--tj-inverse-alpha-06);
    border-radius: 24px;
    padding: 28px;
    backdrop-filter: blur(10px);
  }

  .overview-specialties__header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--tj-inverse-alpha-08);
  }

  .overview-specialties__header svg {
    width: 26px;
    height: 26px;
    color: var(--accent);
  }

  .overview-specialties__header h3 {
    font-size: 1.25rem;
    color: var(--tj-text-inverse);
    margin: 0;
  }

  .specialties-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .specialty-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--tj-inverse-alpha-02);
    border: 1px solid var(--tj-inverse-alpha-04);
    color: var(--tj-inverse-alpha-75);
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .specialty-item:hover {
    background: rgba(var(--accent-rgb), 0.06);
    border-color: rgba(var(--accent-rgb), 0.15);
    color: var(--tj-text-inverse);
    transform: translateX(calc(var(--tj-inline-direction) * 4px));
  }

  .specialty-item__check {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: rgba(var(--accent-rgb), 0.1);
    flex-shrink: 0;
  }

  .specialty-item__check svg {
    width: 18px;
    height: 18px;
    color: var(--accent);
  }

  /* ── Product families ──────────────────────────────────────── */
  .overview-families {
    background: var(--tj-inverse-alpha-02);
    border: 1px solid var(--tj-inverse-alpha-06);
    border-radius: 20px;
    padding: 24px;
  }

  .overview-families h4 {
    font-size: 1.05rem;
    color: var(--tj-inverse-alpha-80);
    margin: 0 0 16px;
  }

  .overview-families__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .overview-family-tag {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--tj-inverse-alpha-04);
    border: 1px solid var(--tj-inverse-alpha-08);
    color: var(--tj-inverse-alpha-60);
    font-size: var(--tj-text-small);
    transition: all 0.25s ease;
  }

  .overview-family-tag:hover {
    background: rgba(var(--accent-rgb), 0.08);
    border-color: rgba(var(--accent-rgb), 0.2);
    color: var(--accent);
  }

  /* ── Responsive ────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .overview-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
