---
import Button from '../ui/Button.astro';
import HeroTrustItem from '../ui/HeroTrustItem.astro';
import type { Locale } from '../../lib/api/types';
import { dictionary } from '../../i18n';
import '../../styles/hero.css';

const { locale } = Astro.props as { locale: Locale };
const hero = dictionary(locale).home.hero;
---
<section class="cinematic-hero theme-inverse" id="hero" aria-labelledby="hero-title">
  <!-- Static cinematic scene: background + products only -->
  <picture class="hero-picture" aria-hidden="true">
    <source
      media="(max-width: 767px)"
      srcset="/assets/hero/hero-static-scene-mobile.webp"
      width="960"
      height="1200"
    />
    <img
      class="hero-bg"
      src="/assets/hero/hero-static-scene.webp"
      alt=""
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
  </picture>

  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="hero-center-glow" aria-hidden="true"></div>

  <!-- Area-linked glow layers -->
  <img
    class="hero-glow hero-glow-blue"
    src="/assets/hero/glows/glow-blue.svg"
    alt=""
    aria-hidden="true"
    width="800"
    height="800"
    decoding="async"
  />
  <img
    class="hero-glow hero-glow-green"
    src="/assets/hero/glows/glow-green.svg"
    alt=""
    aria-hidden="true"
    width="800"
    height="800"
    decoding="async"
  />
  <img
    class="hero-glow hero-glow-cnc"
    src="/assets/hero/glows/glow-cnc.svg"
    alt=""
    aria-hidden="true"
    width="800"
    height="800"
    decoding="async"
  />

  <!-- Energy flow: inline SVG so stroke animation stays controllable by CSS/GSAP -->
  <svg
    class="hero-energy-flow"
    viewBox="0 0 1920 1080"
    fill="none"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="flowBlue" x1="1380" y1="410" x2="1040" y2="500" gradientUnits="userSpaceOnUse">
        <stop stop-color="#1E99D3" stop-opacity="0.95" />
        <stop offset="1" stop-color="#ff8c00" stop-opacity="0.72" />
      </linearGradient>
      <linearGradient id="flowGreen" gradientUnits="userSpaceOnUse" data-flow-gradient="liper">
        <stop stop-color="#1E99D3" stop-opacity="0.78" />
        <stop offset="1" stop-color="#ff8c00" stop-opacity="0.96" />
      </linearGradient>
      <linearGradient id="flowCnc" gradientUnits="userSpaceOnUse" data-flow-gradient="cnc">
        <stop stop-color="#1E99D3" stop-opacity="0.72" />
        <stop offset="1" stop-color="#E63636" stop-opacity="0.9" />
      </linearGradient>
      <filter id="energyGlow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <path
      class="energy-path energy-path-liper"
      data-flow-connection="liper"
      d="M0 0"
      stroke="url(#flowGreen)"
      stroke-width="4"
      stroke-linecap="round"
      filter="url(#energyGlow)"
    />
    <path
      class="energy-path energy-path-cnc"
      data-flow-connection="cnc"
      d="M0 0"
      stroke="url(#flowCnc)"
      stroke-width="3.5"
      stroke-linecap="round"
      filter="url(#energyGlow)"
    />
    <circle class="energy-core" data-flow-core cx="0" cy="0" r="8" fill="#A7F05A" filter="url(#energyGlow)" />
  </svg>

  <!-- Brand anchors: real logos, visually tied to product zones -->
  <div class="hero-brands-container" aria-label={hero.brandsLabel}>
    <div class="brand-anchor brand-anchor-liper" data-brand="liper" data-flow-target="liper" tabindex="0" role="button" aria-label={`Liper — ${hero.brandAnchors.liper}`}>
      <img src="/logos/liper-logo.svg" alt="Liper" width="138" height="58" />
      <span>{hero.brandAnchors.liper}</span>
    </div>

    <div class="brand-anchor brand-anchor-cnc" data-brand="cnc" data-flow-target="cnc" tabindex="0" role="button" aria-label={`CNC — ${hero.brandAnchors.cnc}`}>
      <img src="/logos/cnc-logo.svg" alt="CNC Electric" width="138" height="70" />
      <span>{hero.brandAnchors.cnc}</span>
    </div>
  </div>

  <!-- Main copy -->
  <div class="hero-content" data-flow-role="destination">
    <p class="hero-eyebrow">{hero.eyebrow}</p>
    <img
      class="tajaddod-logo-hero"
      data-flow-origin
      src="/logos/tajaddod-logo-white.svg"
      alt={hero.logoAlt}
      width="220"
      height="108"
    />

    <h1 id="hero-title">{hero.title}</h1>

    <p>{hero.description}</p>

    <div class="hero-actions">
      {hero.buttons.map((btn) => (
        <Button href={btn.href} variant={btn.variant}>
          {btn.label}
        </Button>
      ))}
    </div>
  </div>

  <!-- Unified trust panel -->
  <div class="hero-trust-panel" aria-label={hero.trustLabel}>
    {hero.trust.map((item) => (
      <HeroTrustItem iconName={item.icon} label={item.label} description={item.description} />
    ))}
  </div>
</section>

<script>
  import { initHeroMotion } from '../../scripts/heroMotion';
  initHeroMotion();
</script>
