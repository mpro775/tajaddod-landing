---
import type { ArticleSummary, Locale } from '../../lib/api/types';
import { localePath } from '../../lib/content';
import { toLegacyArticle } from '../../lib/visual/legacy-view';

interface Props { locale: Locale; articles: ArticleSummary[]; }
const { locale, articles: sourceArticles = [] } = Astro.props;
const latestNews = sourceArticles.slice(0, 3).map((article) => toLegacyArticle(article, locale));
const isEn = locale === 'en';
const labels = {
  eyebrow: isEn ? 'Latest updates' : 'آخر المستجدات',
  title: isEn ? 'Tajaddod news & insights' : 'أخبار ومقالات تجدد',
  subtitle: isEn ? 'Follow Tajaddod news, projects, training activities and partnerships across electricity and energy.' : 'تابع مستجدات تجدد، المشاريع، الأنشطة التدريبية، والشراكات في مجال الكهرباء والطاقة.',
  readMore: isEn ? 'Read more' : 'اقرأ المزيد',
  all: isEn ? 'Browse all news & insights' : 'تصفح كل الأخبار والمقالات',
};
const formatDate = (dateStr: string) => dateStr
  ? new Intl.DateTimeFormat(isEn ? 'en-US' : 'ar-YE', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(dateStr))
  : '';
---
<section id="news" class="latest-news section">
  <!-- Ambient Background -->
  <div class="ln-ambient">
    <div class="ln-ambient__grid"></div>
    <div class="ln-ambient__orb ln-ambient__orb--1"></div>
    <div class="ln-ambient__orb ln-ambient__orb--2"></div>
  </div>

  <div class="container">
    <!-- Section Header -->
    <div class="ln-header" data-reveal="up">
      <p class="ln-eyebrow">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 22h16a2 2 0 002-2V4a2 2 0 00-2-2H8a2 2 0 00-2 2v16a2 2 0 01-2 2zm0 0a2 2 0 01-2-2v-9c0-1.1.9-2 2-2h2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M18 14h-8M18 18h-8M10 6h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {labels.eyebrow}
      </p>
      <h2 class="ln-title">{isEn ? <>Tajaddod <span class="ln-title__accent">news & insights</span></> : <>أخبار ومقالات <span class="ln-title__accent">تجدد</span></>}</h2>
      <div class="ln-title-line"></div>
      <p class="ln-subtitle">{labels.subtitle}</p>
    </div>

    <!-- News Cards Grid -->
    <div class="ln-grid" data-reveal-stagger>
      {latestNews.map((item, i) => (
        <a href={localePath(locale, `/news/${item.slug}`)} class="ln-card" style={`--card-index: ${i}`}>
          <!-- Image Area -->
          <div class="ln-card__media">
            <img src={item.coverImage} alt={item.title} loading="lazy" />
            <div class="ln-card__media-overlay"></div>
            <span class="ln-card__category">{item.category}</span>
            <!-- Floating Date Chip -->
            <div class="ln-card__date-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              <span>{formatDate(item.date)}</span>
            </div>
          </div>

          <!-- Content Area -->
          <div class="ln-card__content">
            <div class="ln-card__author">
              <div class="ln-card__author-avatar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2"/></svg>
              </div>
              <span>{item.author}</span>
            </div>
            <h3 class="ln-card__title">{item.title}</h3>
            <p class="ln-card__excerpt">{item.excerpt}</p>
            <div class="ln-card__footer">
              <span class="ln-card__read-more">
                {labels.readMore}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M5 12l7 7M5 12l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </div>

          <!-- Decorative corner glow -->
          <div class="ln-card__corner-glow"></div>
        </a>
      ))}
    </div>
    
    <!-- CTA Button -->
    <div class="ln-action" data-reveal="up">
      <a href={localePath(locale, "/news")} class="ln-btn">
        <span>{labels.all}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M5 12l7 7M5 12l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* ─── Section Container ────────────────────────────────────────────── */
  .latest-news {
    position: relative;
    padding: clamp(80px, 10vw, 130px) 0;
    background:
      radial-gradient(ellipse at 75% 10%, rgba(30,153,211,0.10), transparent 55%),
      radial-gradient(ellipse at 25% 90%, rgba(21,150,71,0.06), transparent 50%),
      linear-gradient(168deg, #081d28 0%, #0c2b36 30%, #0b3429 58%, #091f2b 100%);
    color: #fff;
    overflow: hidden;
  }

  /* ─── Ambient Background ───────────────────────────────────────────── */
  .ln-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .ln-ambient__grid {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image:
      linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse at 50% 50%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, #000 20%, transparent 75%);
  }
  .ln-ambient__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
  }
  .ln-ambient__orb--1 {
    width: 450px;
    height: 450px;
    top: -15%;
    right: 5%;
    background: rgba(30,153,211,0.2);
    animation: lnOrbFloat 14s ease-in-out infinite;
  }
  .ln-ambient__orb--2 {
    width: 380px;
    height: 380px;
    bottom: -10%;
    left: 10%;
    background: rgba(139,197,67,0.15);
    animation: lnOrbFloat 16s ease-in-out infinite reverse;
  }
  @keyframes lnOrbFloat {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(25px, -18px); }
  }

  /* ─── Section Header ───────────────────────────────────────────────── */
  .ln-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 56px;
    position: relative;
    z-index: 1;
  }
  .ln-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    color: var(--tj-blue-light, #9be8ff);
    font-size: 0.9rem;
    font-weight: var(--tj-font-semibold);
    letter-spacing: 0.02em;
  }
  .ln-eyebrow svg {
    color: var(--tj-blue, #1e99d3);
  }
  .ln-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: var(--tj-font-bold);
    margin-bottom: 0;
    line-height: 1.2;
    color: #fff;
  }
  .ln-title__accent {
    background: linear-gradient(135deg, var(--tj-blue, #1e99d3), var(--tj-green-light, #8bc543));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .ln-title-line {
    width: 72px;
    height: 3px;
    margin: 20px auto 22px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--tj-blue, #1e99d3), var(--tj-green, #159647));
    opacity: 0.7;
  }
  .ln-subtitle {
    color: rgba(255,255,255,0.55);
    font-size: 1.1rem;
    line-height: 1.9;
    max-width: 620px;
    margin: 0 auto;
  }

  /* ─── News Cards Grid ──────────────────────────────────────────────── */
  .ln-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
    margin-bottom: 52px;
    position: relative;
    z-index: 1;
  }

  /* ─── News Card ────────────────────────────────────────────────────── */
  .ln-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 22px;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    transition:
      transform 0.5s var(--tj-ease-smooth, cubic-bezier(0.4, 0, 0.2, 1)),
      border-color 0.5s var(--tj-ease-smooth, cubic-bezier(0.4, 0, 0.2, 1)),
      box-shadow 0.5s var(--tj-ease-smooth, cubic-bezier(0.4, 0, 0.2, 1));
  }
  .ln-card:hover {
    transform: translateY(-8px);
    border-color: rgba(30,153,211,0.25);
    box-shadow:
      0 20px 50px rgba(0,0,0,0.3),
      0 0 30px rgba(30,153,211,0.08);
  }

  /* ─── Corner Glow ──────────────────────────────────────────────────── */
  .ln-card__corner-glow {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(30,153,211,0.15), transparent 70%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .ln-card:hover .ln-card__corner-glow {
    opacity: 1;
  }

  /* ─── Card Media ───────────────────────────────────────────────────── */
  .ln-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16/10;
    overflow: hidden;
  }
  .ln-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--tj-ease-smooth, cubic-bezier(0.4, 0, 0.2, 1));
  }
  .ln-card:hover .ln-card__media img {
    transform: scale(1.06);
  }
  .ln-card__media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      rgba(0,0,0,0.2) 100%
    );
    pointer-events: none;
  }

  /* ─── Category Badge ───────────────────────────────────────────────── */
  .ln-card__category {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: var(--tj-font-semibold);
    background: linear-gradient(135deg, rgba(30,153,211,0.35), rgba(21,150,71,0.25));
    border: 1px solid rgba(30,153,211,0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    z-index: 2;
  }

  /* ─── Date Chip ────────────────────────────────────────────────────── */
  .ln-card__date-chip {
    position: absolute;
    bottom: 12px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 10px;
    font-size: 0.78rem;
    background: rgba(0,0,0,0.45);
    border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(255,255,255,0.75);
    z-index: 2;
  }

  /* ─── Card Content ─────────────────────────────────────────────────── */
  .ln-card__content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 2px;
  }

  .ln-card__author {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: rgba(255,255,255,0.5);
    font-size: 0.82rem;
  }
  .ln-card__author-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(30,153,211,0.2), rgba(21,150,71,0.15));
    border: 1px solid rgba(30,153,211,0.15);
    color: var(--tj-blue-light, #9be8ff);
  }

  .ln-card__title {
    font-size: 1.3rem;
    font-weight: var(--tj-font-bold);
    line-height: 1.4;
    margin-bottom: 10px;
    color: #fff;
    transition: color 0.3s ease;
  }
  .ln-card:hover .ln-card__title {
    color: var(--tj-blue-light, #9be8ff);
  }

  .ln-card__excerpt {
    color: rgba(255,255,255,0.55);
    font-size: 0.92rem;
    line-height: 1.7;
    margin-bottom: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  /* ─── Card Footer ──────────────────────────────────────────────────── */
  .ln-card__footer {
    padding-top: 16px;
    margin-top: auto;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .ln-card__read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--tj-blue, #1e99d3);
    font-weight: var(--tj-font-semibold);
    font-size: 0.9rem;
    transition: gap 0.3s ease, color 0.3s ease;
  }
  .ln-card:hover .ln-card__read-more {
    gap: 12px;
    color: var(--tj-blue-light, #9be8ff);
  }
  .ln-card__read-more svg {
    transition: transform 0.3s ease;
  }
  .ln-card:hover .ln-card__read-more svg {
    transform: translateX(-4px);
  }

  /* ─── Section CTA Button ───────────────────────────────────────────── */
  .ln-action {
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .ln-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 32px;
    border-radius: 16px;
    font-weight: var(--tj-font-semibold);
    font-size: 1rem;
    color: #fff;
    text-decoration: none;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }
  .ln-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(30,153,211,0.12), rgba(21,150,71,0.08));
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .ln-btn:hover {
    border-color: rgba(30,153,211,0.5);
    box-shadow: 0 12px 36px rgba(30,153,211,0.15);
    transform: translateY(-3px);
  }
  .ln-btn:hover::before {
    opacity: 1;
  }
  .ln-btn span,
  .ln-btn svg {
    position: relative;
    z-index: 1;
  }
  .ln-btn svg {
    transition: transform 0.3s ease;
  }
  .ln-btn:hover svg {
    transform: translateX(-4px);
  }

  /* ─── Mobile Responsive ────────────────────────────────────────────── */
  @media (max-width: 820px) {
    .ln-header {
      margin-bottom: 40px;
    }
    .ln-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .ln-ambient__orb--1 {
      width: 280px;
      height: 280px;
    }
    .ln-ambient__orb--2 {
      width: 250px;
      height: 250px;
    }
  }

  @media (max-width: 520px) {
    .latest-news {
      padding: clamp(60px, 10vw, 100px) 0;
    }
    .ln-card__content {
      padding: 18px;
    }
    .ln-card__title {
      font-size: 1.15rem;
    }
  }
</style>
