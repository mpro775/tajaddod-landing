---
import type { Locale, ProjectSummary } from '../../lib/api/types';
import { localePath } from '../../lib/content';
import { toLegacyProject } from '../../lib/visual/legacy-view';

interface Props { locale: Locale; projects: ProjectSummary[]; }
const { locale, projects: sourceProjects = [] } = Astro.props;
const projects = sourceProjects.map((project) => toLegacyProject(project, locale));
const featuredProject = projects[0];
const sideProjects = projects.slice(1, 4);
const isEn = locale === 'en';
const labels = {
  eyebrow: isEn ? 'Completed work' : 'أعمالنا المنجزة',
  title: isEn ? 'Projects delivered by' : 'مشاريع نفذتها',
  brand: isEn ? 'Tajaddod' : 'تجدد',
  subtitle: isEn
    ? 'Tajaddod goes beyond product supply to deliver integrated electrical and solar-energy solutions for commercial, service and infrastructure projects.'
    : 'لا تكتفي تجدد بتوريد المنتجات، بل تشارك في تنفيذ حلول كهربائية وطاقة شمسية متكاملة للمشاريع السكنية والتجارية والخدمية.',
  details: isEn ? 'View project details' : 'عرض تفاصيل المشروع',
  all: isEn ? 'Browse all projects' : 'تصفح جميع المشاريع',
};
---
<section id="projects" class="featured-projects section">
  <!-- Ambient Background Glows -->
  <div class="fp-ambient">
    <div class="fp-ambient__orb fp-ambient__orb--blue"></div>
    <div class="fp-ambient__orb fp-ambient__orb--green"></div>
    <div class="fp-ambient__orb fp-ambient__orb--orange"></div>
  </div>

  <div class="container">
    <!-- Section Header -->
    <div class="fp-header" data-reveal="up">
      <p class="fp-eyebrow">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M2 20h20M5 20V10l7-7 7 7v10M9 20v-5a3 3 0 016 0v5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {labels.eyebrow}
      </p>
      <h2 class="fp-title">{labels.title} <span class="fp-title__accent">{labels.brand}</span></h2>
      <div class="fp-title-line"></div>
      <p class="fp-subtitle">{labels.subtitle}</p>
    </div>
    
    <!-- Projects Bento Grid -->
    <div class="fp-bento" data-reveal-stagger>
      <!-- Hero Featured Card -->
      {featuredProject && (
        <a href={localePath(locale, `/projects/${featuredProject.slug}`)} class="fp-card fp-card--hero">
          <div class="fp-card__media">
            <img src={featuredProject.coverImage} alt={featuredProject.title} loading="lazy" />
            <div class="fp-card__overlay"></div>
            <div class="fp-card__shine"></div>
          </div>
          <div class="fp-card__body">
            <span class="fp-card__badge">{featuredProject.category}</span>
            <h3 class="fp-card__title">{featuredProject.title}</h3>
            <p class="fp-card__summary">{featuredProject.summary}</p>
            <div class="fp-card__meta">
              <span class="fp-card__meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/></svg>
                {featuredProject.location}
              </span>
              <span class="fp-card__meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                {featuredProject.year}
              </span>
              {featuredProject.stats && featuredProject.stats[0] && (
                <span class="fp-card__meta-item fp-card__meta-item--highlight">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {featuredProject.stats[0].value}
                </span>
              )}
            </div>
            <span class="fp-card__cta">
              {labels.details}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M5 12l7 7M5 12l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </a>
      )}
      
      <!-- Side Cards -->
      <div class="fp-side">
        {sideProjects.map((project, i) => (
          <a href={localePath(locale, `/projects/${project.slug}`)} class="fp-card fp-card--side" style={`--card-delay: ${i * 100}ms`}>
            <div class="fp-card__media">
              <img src={project.coverImage} alt={project.title} loading="lazy" />
              <div class="fp-card__overlay"></div>
              <div class="fp-card__shine"></div>
            </div>
            <div class="fp-card__body">
              <span class="fp-card__badge fp-card__badge--small">{project.category}</span>
              <h3 class="fp-card__title">{project.title}</h3>
              <div class="fp-card__meta">
                <span class="fp-card__meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/></svg>
                  {project.location}
                </span>
                <span class="fp-card__meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  {project.year}
                </span>
              </div>
            </div>
            <div class="fp-card__arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M5 12l7 7M5 12l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
    
    <!-- CTA Button -->
    <div class="fp-action" data-reveal="up">
      <a href={localePath(locale, "/projects")} class="fp-btn">
        <span>{labels.all}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M5 12l7 7M5 12l7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* ─── Section Container ────────────────────────────────────────────── */
  .featured-projects {
    position: relative;
    padding: clamp(80px, 10vw, 130px) 0;
    background:
      radial-gradient(ellipse at 20% 0%, rgba(30,153,211,0.12), transparent 50%),
      radial-gradient(ellipse at 80% 100%, rgba(21,150,71,0.08), transparent 50%),
      linear-gradient(168deg, #071a24 0%, #0c2a35 28%, #0a3828 58%, #081d28 100%);
    color: #fff;
    overflow: hidden;
  }

  /* ─── Ambient Orbs ─────────────────────────────────────────────────── */
  .fp-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .fp-ambient__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.25;
  }
  .fp-ambient__orb--blue {
    width: 500px;
    height: 500px;
    top: -10%;
    left: 10%;
    background: rgba(30,153,211,0.5);
    animation: orbFloat 12s ease-in-out infinite;
  }
  .fp-ambient__orb--green {
    width: 400px;
    height: 400px;
    bottom: -5%;
    right: 5%;
    background: rgba(21,150,71,0.4);
    animation: orbFloat 15s ease-in-out infinite reverse;
  }
  .fp-ambient__orb--orange {
    width: 300px;
    height: 300px;
    top: 40%;
    right: 20%;
    background: rgba(255,140,0,0.2);
    animation: orbFloat 10s ease-in-out infinite 3s;
  }

  @keyframes orbFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -20px) scale(1.1); }
    66% { transform: translate(-20px, 15px) scale(0.95); }
  }

  /* ─── Section Header ───────────────────────────────────────────────── */
  .fp-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 56px;
    position: relative;
    z-index: 1;
  }
  .fp-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    color: var(--tj-blue-light, #9be8ff);
    font-size: 0.9rem;
    font-weight: var(--tj-font-semibold);
    letter-spacing: 0.02em;
  }
  .fp-eyebrow svg {
    color: var(--tj-blue, #1e99d3);
  }
  .fp-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: var(--tj-font-bold);
    margin-bottom: 0;
    line-height: 1.2;
    color: #fff;
  }
  .fp-title__accent {
    background: linear-gradient(135deg, var(--tj-blue, #1e99d3), var(--tj-green-light, #8bc543));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .fp-title-line {
    width: 72px;
    height: 3px;
    margin: 20px auto 22px;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--tj-blue, #1e99d3), var(--tj-green, #159647));
    opacity: 0.7;
  }
  .fp-subtitle {
    color: rgba(255,255,255,0.58);
    font-size: 1.1rem;
    line-height: 1.9;
    max-width: 660px;
    margin: 0 auto;
  }

  /* ─── Bento Grid Layout ────────────────────────────────────────────── */
  .fp-bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 52px;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 992px) {
    .fp-bento {
      grid-template-columns: 1.4fr 1fr;
      gap: 24px;
    }
  }

  .fp-side {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (min-width: 992px) {
    .fp-side {
      gap: 24px;
    }
  }

  /* ─── Card Base ────────────────────────────────────────────────────── */
  .fp-card {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border: 1px solid rgba(255,255,255,0.08);
    transition:
      transform 0.5s var(--tj-ease-smooth, cubic-bezier(0.4, 0, 0.2, 1)),
      border-color 0.5s var(--tj-ease-smooth, cubic-bezier(0.4, 0, 0.2, 1)),
      box-shadow 0.5s var(--tj-ease-smooth, cubic-bezier(0.4, 0, 0.2, 1));
  }
  .fp-card:hover {
    transform: translateY(-6px);
    border-color: rgba(30,153,211,0.3);
    box-shadow:
      0 24px 60px rgba(0,0,0,0.35),
      0 0 40px rgba(30,153,211,0.1);
  }

  /* ─── Card Media ───────────────────────────────────────────────────── */
  .fp-card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .fp-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--tj-ease-smooth, cubic-bezier(0.4, 0, 0.2, 1));
  }
  .fp-card:hover .fp-card__media img {
    transform: scale(1.08);
  }
  .fp-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.92) 0%,
      rgba(0,0,0,0.55) 40%,
      rgba(0,0,0,0.15) 70%,
      rgba(0,0,0,0) 100%
    );
    z-index: 1;
  }
  .fp-card__shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      transparent 30%,
      rgba(30,153,211,0.06) 50%,
      transparent 70%
    );
    z-index: 2;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .fp-card:hover .fp-card__shine {
    opacity: 1;
  }

  /* ─── Card Body ────────────────────────────────────────────────────── */
  .fp-card__body {
    position: relative;
    z-index: 3;
    padding: 28px;
  }

  /* ─── Hero Card ────────────────────────────────────────────────────── */
  .fp-card--hero {
    min-height: 480px;
  }
  @media (min-width: 992px) {
    .fp-card--hero {
      min-height: 100%;
    }
    .fp-card--hero .fp-card__body {
      padding: 36px;
    }
  }
  .fp-card--hero .fp-card__title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 14px;
  }
  .fp-card__summary {
    color: rgba(255,255,255,0.65);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ─── Side Card ────────────────────────────────────────────────────── */
  .fp-card--side {
    min-height: 200px;
    flex: 1;
  }
  @media (min-width: 992px) {
    .fp-card--side {
      min-height: 0;
    }
  }
  .fp-card--side .fp-card__title {
    font-size: 1.2rem;
    margin-bottom: 10px;
  }
  .fp-card--side .fp-card__overlay {
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.9) 0%,
      rgba(0,0,0,0.4) 50%,
      rgba(0,0,0,0.05) 100%
    );
  }

  /* ─── Arrow on Side Cards ──────────────────────────────────────────── */
  .fp-card__arrow {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 3;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
    color: rgba(255,255,255,0.5);
    transition: all 0.4s ease;
  }
  .fp-card--side:hover .fp-card__arrow {
    background: var(--tj-blue, #1e99d3);
    border-color: transparent;
    color: #fff;
    transform: translateX(-4px);
  }

  /* ─── Badge ────────────────────────────────────────────────────────── */
  .fp-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: var(--tj-font-semibold);
    margin-bottom: 14px;
    background: linear-gradient(135deg, rgba(30,153,211,0.25), rgba(21,150,71,0.2));
    border: 1px solid rgba(30,153,211,0.2);
    backdrop-filter: blur(10px);
    color: var(--tj-blue-light, #9be8ff);
  }
  .fp-card__badge--small {
    padding: 4px 12px;
    font-size: 0.75rem;
  }

  /* ─── Title & Meta ─────────────────────────────────────────────────── */
  .fp-card__title {
    font-weight: var(--tj-font-bold);
    line-height: 1.35;
    color: #fff;
  }

  .fp-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 20px;
  }
  .fp-card--side .fp-card__meta {
    margin-bottom: 0;
  }
  .fp-card__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.55);
  }
  .fp-card__meta-item svg {
    opacity: 0.6;
  }
  .fp-card__meta-item--highlight {
    color: var(--tj-blue-light, #9be8ff);
    font-weight: var(--tj-font-semibold);
  }
  .fp-card__meta-item--highlight svg {
    opacity: 0.9;
    color: var(--tj-blue, #1e99d3);
  }

  /* ─── CTA inside Hero Card ─────────────────────────────────────────── */
  .fp-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: 14px;
    font-size: 0.9rem;
    font-weight: var(--tj-font-semibold);
    background: var(--tj-blue, #1e99d3);
    color: #fff;
    box-shadow: 0 12px 30px rgba(30,153,211,0.25);
    transition: all 0.35s ease;
  }
  .fp-card--hero:hover .fp-card__cta {
    background: linear-gradient(135deg, var(--tj-blue, #1e99d3), var(--tj-green, #159647));
    box-shadow: 0 16px 40px rgba(30,153,211,0.35);
    gap: 12px;
  }

  /* ─── Section CTA Button ───────────────────────────────────────────── */
  .fp-action {
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .fp-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 32px;
    border-radius: 16px;
    font-weight: var(--tj-font-semibold);
    font-size: 1rem;
    color: #fff;
    text-decoration: none;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }
  .fp-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(30,153,211,0.12), rgba(21,150,71,0.08));
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .fp-btn:hover {
    border-color: rgba(30,153,211,0.5);
    box-shadow: 0 12px 36px rgba(30,153,211,0.15);
    transform: translateY(-3px);
  }
  .fp-btn:hover::before {
    opacity: 1;
  }
  .fp-btn span,
  .fp-btn svg {
    position: relative;
    z-index: 1;
  }
  .fp-btn svg {
    transition: transform 0.3s ease;
  }
  .fp-btn:hover svg {
    transform: translateX(-4px);
  }

  /* ─── Mobile Responsive ────────────────────────────────────────────── */
  @media (max-width: 820px) {
    .fp-header {
      margin-bottom: 40px;
    }
    .fp-card--hero {
      min-height: 380px;
    }
    .fp-card--side {
      min-height: 220px;
    }
    .fp-card__body {
      padding: 22px;
    }
    .fp-ambient__orb--blue {
      width: 300px;
      height: 300px;
    }
    .fp-ambient__orb--green {
      width: 250px;
      height: 250px;
    }
    .fp-ambient__orb--orange {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .featured-projects {
      padding: clamp(60px, 10vw, 100px) 0;
    }
    .fp-card--hero {
      min-height: 340px;
    }
    .fp-card--side {
      min-height: 200px;
    }
    .fp-card__body {
      padding: 18px;
    }
    .fp-card__summary {
      display: none;
    }
  }
</style>
