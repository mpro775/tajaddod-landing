---
import { achievements } from '../../data/achievements';

const iconMap: Record<string, string> = {
  calendar: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 4H5C3.89543 4 3 4.89543 3 6V20C3 21.1046 3.89543 22 5 22H19C20.1046 22 21 21.1046 21 20V6C21 4.89543 20.1046 4 19 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 2V6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 2V6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 10H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  projects: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M21 16V8C21 6.89543 20.1046 6 19 6H5C3.89543 6 3 6.89543 3 8V16C3 17.1046 3.89543 18 5 18H19C20.1046 18 21 17.1046 21 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 22V18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 22H16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  energy: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  clients: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17 21V19C17 17.9391 16.5786 16.9217 15.8284 16.1716C15.0783 15.4214 14.0609 15 13 15H5C3.93913 15 2.92172 15.4214 2.17157 16.1716C1.42143 16.9217 1 17.9391 1 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 11C11.2091 11 13 9.20914 13 7C13 4.79086 11.2091 3 9 3C6.79086 3 5 4.79086 5 7C5 9.20914 6.79086 11 9 11Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M23 21V19C22.9993 18.1137 22.7044 17.2528 22.1614 16.5523C21.6184 15.8519 20.8581 15.3516 20 15.13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 3.13C16.8604 3.35031 17.623 3.85071 18.1676 4.55232C18.7122 5.25392 19.0078 6.11683 19.0078 7.005C19.0078 7.89318 18.7122 8.75608 18.1676 9.45768C17.623 10.1593 16.8604 10.6597 16 10.88" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  team: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 12H22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 2C14.5013 4.73835 15.9228 8.29203 16 12C15.9228 15.708 14.5013 19.2616 12 22C9.49872 19.2616 8.07725 15.708 8 12C8.07725 8.29203 9.49872 4.73835 12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
};
---

<section class="achievements-section section" id="achievements">
  <div class="achievements-bg">
    <div class="glow-sphere"></div>
    <div class="energy-lines"></div>
  </div>

  <div class="container">
    <div class="section-header">
      <span class="eyebrow">إنجازات تجدد</span>
      <h2 class="section-title">أرقام تعكس حضورنا في سوق الكهرباء والطاقة</h2>
    </div>

    <div class="achievements-grid" id="achievements-grid">
      {achievements.map((item) => (
        <div class="achievement-card">
          <div class="card-icon" set:html={iconMap[item.icon] || ''}></div>
          <div class="card-content">
            <div class="card-number-wrapper">
              <span class="card-number counter" data-target={item.value}>0</span>
              <span class="card-suffix">{item.suffix}</span>
            </div>
            <h3 class="card-label">{item.label}</h3>
            <p class="card-desc">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .achievements-section {
    position: relative;
    padding: clamp(80px, 10vw, 120px) 0;
    background: #040c11; /* Deep background matching the theme */
    overflow: hidden;
    color: #fff;
  }
  .achievements-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .glow-sphere {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(30,153,211,0.08) 0%, transparent 70%);
    border-radius: 50%;
  }
  .energy-lines {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 80%);
  }
  .container {
    position: relative;
    z-index: 1;
  }
  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .eyebrow {
    display: inline-block;
    padding: 6px 16px;
    background: rgba(30,153,211,0.1);
    color: #9be8ff;
    border: 1px solid rgba(30,153,211,0.2);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: var(--tj-font-medium);
    margin-bottom: 16px;
  }
  .section-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: var(--tj-font-bold);
    background: linear-gradient(135deg, #fff, rgba(255,255,255,0.7));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (min-width: 768px) {
    .achievements-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  @media (min-width: 1024px) {
    .achievements-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 24px;
    }
  }
  /* On mobile: 2x2 then full width for the last item */
  @media (max-width: 767px) {
    .achievement-card:last-child {
      grid-column: 1 / -1;
    }
  }

  .achievement-card {
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    padding: 32px 24px;
    text-align: center;
    transition: all 0.4s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  
  .achievement-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(30,153,211,0.05) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .achievement-card:hover {
    transform: translateY(-8px);
    border-color: rgba(30,153,211,0.3);
    box-shadow: 0 15px 35px rgba(0,0,0,0.4), 0 0 20px rgba(30,153,211,0.1);
  }
  
  .achievement-card:hover::before {
    opacity: 1;
  }

  .card-icon {
    width: 48px;
    height: 48px;
    color: var(--tj-primary);
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .card-number-wrapper {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
    margin-bottom: 8px;
    position: relative;
    z-index: 1;
  }
  
  .card-number {
    font-size: 2.8rem;
    font-weight: var(--tj-font-black);
    color: #fff;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  
  .card-suffix {
    font-size: 1.5rem;
    font-weight: var(--tj-font-bold);
    color: var(--tj-primary);
  }

  .card-label {
    font-size: 1.1rem;
    font-weight: var(--tj-font-semibold);
    color: rgba(255,255,255,0.9);
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
  }

  .card-desc {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.6;
    margin: 0;
    position: relative;
    z-index: 1;
  }
</style>

<script>
  // Simple count-up animation script using Intersection Observer
  document.addEventListener('DOMContentLoaded', () => {
    const counters = document.querySelectorAll('.counter');
    let hasAnimated = false;

    const animateCounters = () => {
      if (hasAnimated) return;
      hasAnimated = true;

      counters.forEach(counter => {
        const targetStr = counter.getAttribute('data-target');
        if (!targetStr) return;
        
        const target = parseFloat(targetStr);
        const duration = 2000; // ms
        const steps = 60;
        const stepTime = duration / steps;
        
        let current = 0;
        const isFloat = target % 1 !== 0;
        
        const updateCounter = () => {
          current += target / steps;
          
          if (current < target) {
            counter.textContent = isFloat ? current.toFixed(2) : Math.ceil(current).toString();
            setTimeout(updateCounter, stepTime);
          } else {
            counter.textContent = targetStr;
          }
        };
        
        updateCounter();
      });
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCounters();
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    const grid = document.getElementById('achievements-grid');
    if (grid) {
      observer.observe(grid);
    }
  });
</script>
