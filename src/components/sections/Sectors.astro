---
/**
 * Sectors Section — من نخدم
 * Focuses on targeting specific user personas (retailers, contractors, technicians, developers)
 * and presenting customized value propositions in a cinematic interactive dashboard layout.
 */
import Icon from '../ui/Icon.astro';
import SectionHeader from '../layout/SectionHeader.astro';
import type { Locale } from '../../lib/api/types';
import { dictionary } from '../../i18n';

const { locale } = Astro.props as { locale: Locale };
const content = dictionary(locale).home.sectors;
const sectorVisuals = [
  {
    id: 'retailers',
    icon: 'store',
    accent: 'blue',
    accentColor: 'var(--tj-blue)',
    accentColorRgb: '30, 153, 211',
  },
  {
    id: 'contractors',
    icon: 'helmet',
    accent: 'green',
    accentColor: 'var(--tj-green)',
    accentColorRgb: '21, 150, 71',
  },
  {
    id: 'technicians',
    icon: 'tool',
    accent: 'lime',
    accentColor: 'var(--tj-orange)',
    accentColorRgb: '255, 140, 0',
  },
  {
    id: 'owners',
    icon: 'building',
    accent: 'blue',
    accentColor: 'var(--tj-blue)',
    accentColorRgb: '30, 153, 211',
  }
];
const sectorDetails = content.items.map((item) => {
  const visual = sectorVisuals.find((entry) => entry.id === item.id)!;
  return {
    ...item,
    ...visual,
    brands: [
      { name: 'CNC', logo: '/logos/cnc-logo.svg', role: item.brandRoles.cnc },
      { name: 'Liper', logo: '/logos/liper-logo.svg', role: item.brandRoles.liper },
    ],
  };
});
---
<section class="section sectors-section layer-cinematic" id="sectors">
  <!-- Cinematic Background -->
  <div class="sc-bg" aria-hidden="true">
    <div class="sc-bg__grid"></div>
    <div class="sc-bg__glow sc-bg__glow--1"></div>
    <div class="sc-bg__glow sc-bg__glow--2"></div>
  </div>

  <!-- Desktop Interactive Layout -->
  <div class="container sectors-desktop-layout">
    <!-- Right Column: Sidebar & Selector Tabs -->
    <div class="sectors-sidebar">
      <SectionHeader
        dark
        eyebrow={content.eyebrow}
        title={content.title}
        description={content.description}
      />

      <div class="sc-tabs" data-reveal>
        {sectorDetails.map((sec, i) => (
          <button class={`sc-tab sc-tab--${sec.accent} ${i === 0 ? 'is-active' : ''}`} data-sector-id={sec.id}>
            <span class="sc-tab__icon">
              <Icon name={sec.icon} />
            </span>
            <div class="sc-tab__label">
              <strong>{sec.title}</strong>
              <span>{content.discover}</span>
            </div>
            <span class="sc-tab__arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6" />
              </svg>
            </span>
          </button>
        ))}
      </div>
    </div>

    <!-- Left Column: Dynamic Value Board -->
    <div class="sectors-showcase-zone" data-reveal>
      <div class="sc-board sector-card" id="value-board" data-active-sector="retailers">
        <!-- Accent light source inside the card -->
        <div class="sc-board__glow" id="board-glow"></div>

        <!-- Board Top Header -->
        <div class="sc-board__header">
          <div class="sc-board__icon" id="board-icon">
            <Icon name="store" />
          </div>
          <div class="sc-board__meta">
            <h3 id="board-title">{sectorDetails[0].title}</h3>
            <span class="sc-board__badge">{content.badge}</span>
          </div>
        </div>

        <!-- Value Statement -->
        <p class="sc-board__statement" id="board-statement">{sectorDetails[0].statement}</p>

        <div class="sc-board__divider"></div>

        <!-- Value Propositions Checklist -->
        <div class="sc-board__checklist-wrapper">
          <h4>{content.offer}</h4>
          <ul class="sc-board__checklist" id="board-checklist">
            {sectorDetails[0].features.map((feat) => (
              <li>
                <span class="sc-check-icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <span>{feat}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Associated Brands Chips -->
        <div class="sc-board__brands-wrapper">
          <h4>{content.relatedBrands}</h4>
          <div class="sc-board__brands" id="board-brands">
            {sectorDetails[0].brands.map((brand) => (
              <div class="sc-brand-tag">
                <img src={brand.logo} alt={brand.name} width="44" height="20" />
                <span class="sc-brand-tag__name">{brand.name}</span>
                <span class="sc-brand-tag__role">{brand.role}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Stacked Layout (Fallback) -->
  <div class="container sectors-mobile-layout">
    <SectionHeader
      align="center"
      dark
      eyebrow={content.eyebrow}
      title={content.title}
      description={content.description}
    />

    <div class="sc-mobile-tabs" role="tablist" aria-label={content.tabsLabel}>
      {sectorDetails.map((sec, i) => (
        <button
          class={`sc-mobile-tab sc-mobile-tab--${sec.accent} ${i === 0 ? 'is-active' : ''}`}
          type="button"
          role="tab"
          id={`sector-mobile-tab-${sec.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`sector-mobile-panel-${sec.id}`}
          tabindex={i === 0 ? '0' : '-1'}
          data-mobile-sector-tab={sec.id}
        >
          {sec.title}
        </button>
      ))}
    </div>

    <div class="sc-mobile-stack">
      {sectorDetails.map((sec, i) => (
        <article
          class={`sc-mobile-card sc-mobile-card--${sec.accent} sector-card ${i === 0 ? 'is-active' : ''}`}
          id={`sector-mobile-panel-${sec.id}`}
          role="tabpanel"
          aria-labelledby={`sector-mobile-tab-${sec.id}`}
          data-mobile-sector-panel={sec.id}
          hidden={i !== 0}
        >
          <div class="sc-mobile-card__glow-bg"></div>
          <div class="sc-mobile-card__inner">
            <div class="sc-mobile-card__header">
              <div class="sc-mobile-card__icon">
                <Icon name={sec.icon} />
              </div>
              <h3>{sec.title}</h3>
            </div>
            
            <p class="sc-mobile-card__statement">{sec.statement}</p>
            
            <div class="sc-mobile-card__checklist-title">{content.offer}</div>
            <ul class="sc-mobile-card__checklist">
              {sec.features.slice(0, 3).map((feat) => (
                <li>
                  <span class="sc-check-icon" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>

            <div class="sc-mobile-card__brands-title">{content.relatedBrands}</div>
            <div class="sc-mobile-card__brands">
              {sec.brands.map((brand) => (
                <div class="sc-brand-tag">
                  <img src={brand.logo} alt={brand.name} width="44" height="20" />
                  <span class="sc-brand-tag__name">{brand.name}</span>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline define:vars={{ sectorDetails }}>
  document.addEventListener('DOMContentLoaded', () => {
    const tabsContainer = document.querySelector('.sc-tabs');
    const board = document.getElementById('value-board');
    if (!tabsContainer || !board) return;

    const tabs = tabsContainer.querySelectorAll('.sc-tab');
    const boardTitle = document.getElementById('board-title');
    const boardStatement = document.getElementById('board-statement');
    const boardChecklist = document.getElementById('board-checklist');
    const boardBrands = document.getElementById('board-brands');
    const boardIcon = document.getElementById('board-icon');

    // Custom Icon Path Map (matches ui/Icon.astro definitions)
    const iconPaths = {
      store: 'M4 10h16l-1-5H5l-1 5Zm2 0v9h12v-9M9 19v-5h6v5',
      helmet: 'M4 15a8 8 0 0 1 16 0v2H4v-2Zm4-1V8m8 6V8M3 17h18v3H3v-3Z',
      tool: 'M14 6a4 4 0 0 0 5 5l-8 8a3 3 0 0 1-4-4l8-8Zm-8 12 3 3',
      building: 'M5 21V4h9v17M14 9h5v12M8 8h3m-3 4h3m-3 4h3m8-3h-2m2 4h-2'
    };

    tabs.forEach(tab => {
      const updateShowcase = () => {
        if (tab.classList.contains('is-active')) return;

        tabs.forEach(t => t.classList.remove('is-active'));
        tab.classList.add('is-active');

        const sectorId = tab.getAttribute('data-sector-id');
        const detail = sectorDetails.find(s => s.id === sectorId);
        if (!detail) return;

        // Apply smooth fade-out to board content
        board.classList.add('is-transitioning');

        setTimeout(() => {
          // Update data-active-sector and styles
          board.setAttribute('data-active-sector', sectorId);
          board.style.setProperty('--board-accent-color', detail.accentColor);
          board.style.setProperty('--board-accent-color-rgb', detail.accentColorRgb);

          // Update header
          if (boardTitle) boardTitle.textContent = detail.title;
          if (boardStatement) boardStatement.textContent = detail.statement;

          // Update Icon
          if (boardIcon && iconPaths[detail.icon]) {
            const svgPath = boardIcon.querySelector('path');
            if (svgPath) svgPath.setAttribute('d', iconPaths[detail.icon]);
          }

          // Update Checklist
          if (boardChecklist) {
            boardChecklist.innerHTML = detail.features.map(feat => `
              <li>
                <span class="sc-check-icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <span>${feat}</span>
              </li>
            `).join('');
          }

          // Update Brands Chips
          if (boardBrands) {
            boardBrands.innerHTML = detail.brands.map(brand => `
              <div class="sc-brand-tag">
                <img src="${brand.logo}" alt="${brand.name}" width="44" height="20" />
                <span class="sc-brand-tag__name">${brand.name}</span>
                <span class="sc-brand-tag__role">${brand.role}</span>
              </div>
            `).join('');
          }

          // Fade content back in
          board.classList.remove('is-transitioning');
        }, 180);
      };

      tab.addEventListener('click', updateShowcase);
      tab.addEventListener('pointerenter', updateShowcase);
    });

    const mobileTabs = document.querySelectorAll('[data-mobile-sector-tab]');
    const mobilePanels = document.querySelectorAll('[data-mobile-sector-panel]');
    const isRtl = document.documentElement.dir === 'rtl';

    const activateMobileTab = (tab) => {
        const sectorId = tab.getAttribute('data-mobile-sector-tab');
        if (!sectorId) return;

        mobileTabs.forEach(item => {
          item.classList.remove('is-active');
          item.setAttribute('aria-selected', 'false');
          item.setAttribute('tabindex', '-1');
        });

        mobilePanels.forEach(panel => {
          const isActive = panel.getAttribute('data-mobile-sector-panel') === sectorId;
          if (panel instanceof HTMLElement) panel.hidden = !isActive;
          panel.classList.toggle('is-active', isActive);
        });

        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        tab.setAttribute('tabindex', '0');
        if (tab instanceof HTMLElement) {
          tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
    };

    mobileTabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateMobileTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (!(event instanceof KeyboardEvent)) return;
        const lastIndex = mobileTabs.length - 1;
        let targetIndex = index;
        const inlineNext = isRtl ? -1 : 1;
        if (event.key === 'ArrowRight') {
          targetIndex = (index + inlineNext + mobileTabs.length) % mobileTabs.length;
        } else if (event.key === 'ArrowLeft') {
          targetIndex = (index - inlineNext + mobileTabs.length) % mobileTabs.length;
        }
        else if (event.key === 'Home') targetIndex = 0;
        else if (event.key === 'End') targetIndex = lastIndex;
        else return;

        event.preventDefault();
        const target = mobileTabs[targetIndex];
        activateMobileTab(target);
        if (target instanceof HTMLElement) target.focus();
      });
    });
  });
</script>

<style>
/* ────────────────────────────────────────────────────────────────────────
   Sectors Section — من نخدم (Cinematic Version)
   Premium dark interactive selectors and dashboard value display
   ──────────────────────────────────────────────────────────────────────── */

.sectors-section {
  position: relative;
  background: #020609;
  color: var(--tj-text-inverse);
  overflow: hidden;
  padding: clamp(90px, 11vw, 150px) 0;
  border-top: 1px solid var(--tj-inverse-alpha-05);
}

/* Background Grids & Glows */
.sc-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.sc-bg__grid {
  position: absolute;
  inset: 0;
  opacity: 0.03;
  background-image:
    linear-gradient(var(--tj-inverse-alpha-08) 1px, transparent 1px),
    linear-gradient(90deg, var(--tj-inverse-alpha-08) 1px, transparent 1px);
  background-size: 64px 64px;
}

.sc-bg__glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(140px);
  opacity: 0.15;
}

.sc-bg__glow--1 {
  width: 450px;
  height: 450px;
  top: 15%;
  left: -5%;
  background: var(--tj-blue);
}

.sc-bg__glow--2 {
  width: 500px;
  height: 500px;
  bottom: 10%;
  right: -5%;
  background: var(--tj-green);
}

.sectors-desktop-layout {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: 64px;
  align-items: center;
  width: 100%;
}

.sectors-mobile-layout {
  display: none;
}

/* Sidebar & Tabs Column */
.sectors-sidebar {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.sc-tabs {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
}

/* Vertical Tab Button */
.sc-tab {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  border-radius: 20px;
  background: var(--tj-inverse-alpha-02);
  border: 1px solid var(--tj-inverse-alpha-05);
  text-align: start;
  cursor: pointer;
  position: relative;
  transition:
    background 0.3s var(--tj-ease-smooth),
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    transform 0.3s ease;
  user-select: none;
}

.sc-tab::before {
  content: "";
  position: absolute;
  top: 50%;
  right: 0;
  transform: translateY(-50%) scaleX(0);
  width: 4px;
  height: 28px;
  border-radius: 999px;
  background: var(--tab-accent);
  transform-origin: right;
  transition: transform 0.3s var(--tj-ease-smooth), box-shadow 0.3s ease;
}

/* Hover and Active Tab states */
.sc-tab:hover {
  background: var(--tj-inverse-alpha-04);
  border-color: var(--tj-inverse-alpha-10);
}

.sc-tab.is-active {
  background: var(--tj-inverse-alpha-08);
  border-color: rgba(var(--tab-accent-rgb), 0.3);
  box-shadow:
    0 12px 30px color-mix(in srgb, var(--tj-neutral-950) 30%, transparent),
    inset 0 0 15px rgba(var(--tab-accent-rgb), 0.1);
  transform: translateX(calc(var(--tj-inline-direction) * 6px));
}

.sc-tab.is-active::before {
  transform: translateY(-50%) scaleX(1);
  box-shadow: 0 0 10px var(--tab-accent);
}

/* Brand specific accents */
.sc-tab--blue { --tab-accent: var(--tj-blue); --tab-accent-rgb: 30, 153, 211; }
.sc-tab--green { --tab-accent: var(--tj-green); --tab-accent-rgb: 21, 150, 71; }
.sc-tab--lime { --tab-accent: var(--tj-orange); --tab-accent-rgb: 255, 140, 0; }

/* Tab Icon */
.sc-tab__icon {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--tj-inverse-alpha-05);
  border: 1px solid var(--tj-inverse-alpha-08);
  color: var(--tj-inverse-alpha-60);
  transition: background 0.3s, color 0.3s, border-color 0.3s, transform 0.3s, box-shadow 0.3s;
}

.sc-tab.is-active .sc-tab__icon {
  background: rgba(var(--tab-accent-rgb), 0.15);
  border-color: rgba(var(--tab-accent-rgb), 0.3);
  color: var(--tab-accent);
  transform: scale(1.1);
  box-shadow: 0 0 15px rgba(var(--tab-accent-rgb), 0.2);
}

.sc-tab__icon svg {
  width: 20px;
  height: 20px;
}

.sc-tab__label {
  flex-grow: 1;
}

.sc-tab__label strong {
  display: block;
  color: var(--tj-inverse-alpha-70);
  font-size: var(--tj-text-body-lg);
  font-weight: var(--tj-font-bold);
  transition: color 0.3s;
}

.sc-tab.is-active .sc-tab__label strong {
  color: var(--tj-text-inverse);
}

.sc-tab__label span {
  display: block;
  color: var(--tj-inverse-alpha-50);
  font-size: var(--tj-text-nano);
  margin-top: 2px;
}

.sc-tab__arrow {
  color: var(--tj-inverse-alpha-30);
  opacity: 0;
  transform: translateX(calc(var(--tj-inline-direction) * -10px));
  transition: opacity 0.3s, transform 0.3s, color 0.3s;
}

.sc-tab.is-active .sc-tab__arrow {
  opacity: 1;
  transform: none;
  color: var(--tab-accent);
}

.sc-tab__arrow svg {
  width: 18px;
  height: 18px;
}

/* Left Column: Dynamic Board Display */
.sectors-showcase-zone {
  position: relative;
  width: 100%;
}

.sc-board {
  position: relative;
  overflow: hidden;
  padding: 44px;
  background: var(--tj-inverse-alpha-02);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--tj-inverse-alpha-06);
  border-radius: 38px;
  box-shadow: 0 30px 60px color-mix(in srgb, var(--tj-neutral-950) 40%, transparent);
  transition:
    opacity 0.3s ease,
    transform 0.4s var(--tj-ease-smooth),
    border-color 0.4s ease,
    box-shadow 0.4s ease;
  min-height: 520px;
  /* Local board styling variables */
  --board-accent-color: var(--tj-blue);
  --board-accent-color-rgb: 30, 153, 211;
}

.sc-board.is-transitioning {
  opacity: 0;
  transform: scale(0.98);
}

.sc-board:hover {
  border-color: rgba(var(--board-accent-color-rgb), 0.3);
  box-shadow:
    0 40px 80px color-mix(in srgb, var(--tj-neutral-950) 50%, transparent),
    0 0 30px rgba(var(--board-accent-color-rgb), 0.15);
}

/* Board Glow Background Element */
.sc-board__glow {
  position: absolute;
  top: 0;
  right: 0;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: radial-gradient(circle at 100% 0%, rgba(var(--board-accent-color-rgb), 0.15) 0%, transparent 70%);
  transition: background 0.6s ease;
  pointer-events: none;
  z-index: 0;
}

/* Board Header */
.sc-board__header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 28px;
}

.sc-board__icon {
  display: grid;
  place-items: center;
  width: 64px;
  height: 64px;
  border-radius: 18px;
  background: rgba(var(--board-accent-color-rgb), 0.1);
  border: 1px solid rgba(var(--board-accent-color-rgb), 0.2);
  color: var(--board-accent-color);
  box-shadow: 0 0 20px rgba(var(--board-accent-color-rgb), 0.15);
  transition: background 0.6s, color 0.6s, border-color 0.6s, box-shadow 0.6s;
}

.sc-board__icon svg {
  width: 28px;
  height: 28px;
}

.sc-board__meta h3 {
  color: var(--tj-text-inverse);
  font-size: clamp(1.4rem, 2.2vw, 1.8rem);
  font-weight: var(--tj-font-bold);
  margin-bottom: 4px;
}

.sc-board__badge {
  display: inline-block;
  font-size: var(--tj-text-nano);
  font-weight: var(--tj-font-bold);
  color: var(--board-accent-color);
  border: 1px solid rgba(var(--board-accent-color-rgb), 0.3);
  background: rgba(var(--board-accent-color-rgb), 0.05);
  border-radius: 99px;
  padding: 4px 12px;
  transition: color 0.6s, border-color 0.6s, background 0.6s;
}

/* Statement */
.sc-board__statement {
  position: relative;
  z-index: 1;
  color: var(--tj-inverse-alpha-90);
  font-size: var(--tj-text-body-lg);
  font-weight: var(--tj-font-semibold);
  line-height: 1.8;
  margin-bottom: 24px;
}

.sc-board__divider {
  height: 1px;
  width: 100%;
  background: linear-gradient(90deg, var(--tj-inverse-alpha-10), transparent);
  margin-bottom: 28px;
}

/* Checklist */
.sc-board__checklist-wrapper {
  position: relative;
  z-index: 1;
  margin-bottom: 34px;
}

.sc-board__checklist-wrapper h4,
.sc-board__brands-wrapper h4 {
  color: var(--tj-inverse-alpha-90);
  font-size: var(--tj-text-small);
  font-weight: var(--tj-font-bold);
  margin-bottom: 16px;
  letter-spacing: 0.02em;
}

.sc-board__checklist {
  display: grid;
  gap: 14px;
  padding: 0;
  margin: 0;
  list-style: none;
}

.sc-board__checklist li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  color: var(--tj-inverse-alpha-60);
  font-size: var(--tj-text-body);
  line-height: 1.65;
}

.sc-check-icon {
  display: inline-grid;
  place-items: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(var(--board-accent-color-rgb), 0.1);
  border: 1px solid rgba(var(--board-accent-color-rgb), 0.2);
  color: var(--board-accent-color);
  flex-shrink: 0;
  margin-top: 3px;
  transition: background 0.6s, border-color 0.6s, color 0.6s;
}

