---
import type { Locale, PublicProductSummary } from '../../lib/api/types';
import type { VisualBrand } from '../../lib/visual/legacy-view';
import { localePath } from '../../lib/content';
import BrandProductCard from '../cards/BrandProductCard.astro';
import { dictionary, formatMessage } from '../../i18n';
interface Props { brand: VisualBrand; locale: Locale; products: PublicProductSummary[]; error?: boolean; }
const { brand, products, locale, error = false } = Astro.props;
const labels = dictionary(locale).catalog;
const catalogPath = localePath(locale, `/brands/${brand.slug}/products`);
---
<section class="product-showcase section" id="brand-products">
  <div class="container">
    <header class="catalog-section-heading">
      <p class="eyebrow">{labels.preview}</p>
      <h2>{formatMessage(labels.title, { brand: brand.name })}</h2>
      <p>{formatMessage(labels.previewDescription, { brand: brand.name })}</p>
    </header>
    {error ? (
      <div class="catalog-state" role="status"><p>{labels.error}</p><a href={catalogPath}>{labels.retry}</a></div>
    ) : products.length > 0 ? (
      <div class="catalog-grid catalog-grid--preview">
        {products.slice(0, 6).map((product) => <BrandProductCard product={product} locale={locale} brand={brand} />)}
      </div>
    ) : <div class="catalog-state"><p>{labels.empty}</p></div>}
    <div class="catalog-actions">
      <a class="catalog-button" href={catalogPath}>{formatMessage(labels.allProducts, { brand: brand.name })}<span class="directional-icon" aria-hidden="true">←</span></a>
      <a class="catalog-text-link" href={`${localePath(locale, '/')}#contact`}>{labels.contactTeam}</a>
    </div>
  </div>
</section>
