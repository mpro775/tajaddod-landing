---
import type { Locale } from '../../lib/api/types';
import type { VisualBrand } from '../../lib/visual/legacy-view';
import { localePath } from '../../lib/content';
import BrandProductCard from '../cards/BrandProductCard.astro';

interface Props {
  brand: VisualBrand;
  locale: Locale;
  products: any[];
}

const { brand, products, locale } = Astro.props;
const isEn = locale === 'en';

const accentMap: Record<string, { color: string; rgb: string }> = {
  cnc: { color: '#e63946', rgb: '230, 57, 70' },
  liper: { color: '#ff8c00', rgb: '255, 140, 0' },
};

const accent = accentMap[brand.id] || accentMap.cnc;

// Group products by category
const categories = [...new Set(products.map((p) => p.category))];
---

<section class="brand-products section" id="brand-products" style={`--accent: ${accent.color}; --accent-rgb: ${accent.rgb};`}>
  <div class="container">
    <!-- Section header -->
    <div class="brand-products__header">
      <div class="brand-products__eyebrow">
        <span class="brand-products__eyebrow-line"></span>
        <span class="brand-products__eyebrow-tag">{isEn ? 'Product catalog' : 'كتالوج المنتجات'}</span>
        <span class="brand-products__eyebrow-line"></span>
      </div>
      <h2 class="brand-products__title">
        {isEn ? 'Products from' : 'منتجات'} <span>{brand.name}</span>
      </h2>
      <p class="brand-products__desc">{isEn ? `Explore the selected products and solutions available from ${brand.name}.` : `اكتشف أحدث المنتجات والحلول التي نقدمها من ${brand.name}`}</p>
    </div>

    <!-- Category filter pills -->
    {categories.length > 1 && (
      <div class="brand-products__filters" id="product-filters">
        <button class="filter-pill is-active" data-filter="all">
          <span>{isEn ? 'All' : 'الكل'}</span>
          <span class="filter-pill__count">{products.length}</span>
        </button>
        {categories.map((cat) => (
          <button class="filter-pill" data-filter={cat}>
            <span>{cat}</span>
            <span class="filter-pill__count">{products.filter((p) => p.category === cat).length}</span>
          </button>
        ))}
      </div>
    )}

    {products.length > 0 ? (
      <div class="brand-products__grid" id="products-grid">
        {products.map((product) => (
          <div class="product-wrapper" data-category={product.category}>
            <BrandProductCard product={product} brandColor={accent.color} locale={locale} />
          </div>
        ))}
      </div>
    ) : (
      <div class="brand-products__empty">
        <div class="brand-products__empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
        </div>
        <p>{isEn ? 'Products will be added soon' : 'سيتم إضافة المنتجات قريباً'}</p>
        <span>{isEn ? 'Follow Tajaddod for the latest additions.' : 'تابعونا للاطلاع على أحدث المنتجات'}</span>
      </div>
    )}

    <!-- CTA section -->
    <div class="brand-products__cta">
      <div class="brand-products__cta-card">
        <!-- Decorative elements -->
        <div class="brand-products__cta-glow" aria-hidden="true"></div>
        <div class="brand-products__cta-line" aria-hidden="true"></div>

        <div class="brand-products__cta-content">
          <div class="brand-products__cta-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
          <div class="brand-products__cta-text">
            <h3>{isEn ? `Looking for more ${brand.name} products?` : `هل تبحث عن المزيد من منتجات ${brand.name}؟`}</h3>
            <p>{isEn ? 'Contact Tajaddod for product availability, specifications and project requirements.' : 'تفضل بتصفح الكتالوج الشامل أو تواصل معنا للاستفسار عن منتج معين'}</p>
          </div>
        </div>

        <div class="brand-products__cta-actions">
          <a href={`${localePath(locale, '/')}#contact`} class="brand-products__cta-btn brand-products__cta-btn--primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
            </svg>
            <span>{isEn ? 'Contact Tajaddod' : 'تواصل مع تجدد'}</span>
          </a>
          {brand.officialWebsite && (
            <a href={brand.officialWebsite} target="_blank" rel="noopener noreferrer" class="brand-products__cta-btn brand-products__cta-btn--outline">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
              </svg>
              <span>{isEn ? `Official ${brand.name} website` : `الموقع الرسمي لـ ${brand.name}`}</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Category filter functionality
  document.addEventListener('DOMContentLoaded', () => {
    const filters = document.getElementById('product-filters');
    const grid = document.getElementById('products-grid');

    if (!filters || !grid) return;

    const pills = filters.querySelectorAll('.filter-pill');
    const items = grid.querySelectorAll('.product-wrapper');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        // Update active state
        pills.forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');

        const filter = pill.getAttribute('data-filter');

        // Filter products
        items.forEach((item) => {
          const category = item.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            (item as HTMLElement).style.display = '';
            (item as HTMLElement).style.animation = 'fadeSlideUp 0.5s ease forwards';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .brand-products {
    padding: clamp(70px, 9vw, 110px) 0;
    color: #fff;
    position: relative;
  }

  /* ── Section header ────────────────────────────────────────── */
  .brand-products__header {
    text-align: center;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .brand-products__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 18px;
  }

  .brand-products__eyebrow-line {
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(var(--accent-rgb), 0.4));
  }

  .brand-products__eyebrow-line:last-child {
    background: linear-gradient(90deg, rgba(var(--accent-rgb), 0.4), transparent);
  }

  .brand-products__eyebrow-tag {
    color: var(--accent);
    font-size: var(--tj-text-small);
    font-weight: var(--tj-font-semibold);
    letter-spacing: 0.05em;
  }

  .brand-products__title {
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: var(--tj-font-bold);
    margin-bottom: 16px;
    color: #fff;
  }

  .brand-products__title span {
    color: var(--accent);
  }

  .brand-products__desc {
    color: rgba(255, 255, 255, 0.5);
    font-size: 1.05rem;
  }

  /* ── Filter pills ──────────────────────────────────────────── */
  .brand-products__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: clamp(32px, 5vw, 48px);
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--tj-text-small);
    font-weight: var(--tj-font-semibold);
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .filter-pill:hover {
    border-color: rgba(var(--accent-rgb), 0.2);
    background: rgba(var(--accent-rgb), 0.06);
    color: #fff;
  }

  .filter-pill.is-active {
    background: rgba(var(--accent-rgb), 0.12);
    border-color: rgba(var(--accent-rgb), 0.3);
    color: var(--accent);
    box-shadow: 0 4px 16px rgba(var(--accent-rgb), 0.1);
  }

  .filter-pill__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    font-size: var(--tj-text-micro);
    font-variant-numeric: tabular-nums;
  }

  .filter-pill.is-active .filter-pill__count {
    background: rgba(var(--accent-rgb), 0.15);
    color: var(--accent);
  }

  /* ── Products grid ─────────────────────────────────────────── */
  .brand-products__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 24px;
    margin-bottom: 64px;
  }

  .product-wrapper {
    animation: fadeSlideUp 0.5s ease forwards;
  }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Empty state ───────────────────────────────────────────── */
  .brand-products__empty {
    text-align: center;
    padding: 80px 24px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 28px;
    margin-bottom: 64px;
  }

  .brand-products__empty-icon {
    display: grid;
    place-items: center;
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    border-radius: 50%;
    background: rgba(var(--accent-rgb), 0.06);
    color: var(--accent);
    opacity: 0.6;
  }

  .brand-products__empty-icon svg {
    width: 42px;
    height: 42px;
  }

  .brand-products__empty p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.15rem;
    font-weight: var(--tj-font-semibold);
    margin-bottom: 8px;
  }

  .brand-products__empty span {
    color: rgba(255, 255, 255, 0.4);
    font-size: var(--tj-text-small);
  }

  /* ── CTA section ───────────────────────────────────────────── */
  .brand-products__cta {
    max-width: 860px;
    margin: 0 auto;
  }

  .brand-products__cta-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.06), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(var(--accent-rgb), 0.12);
    border-radius: 28px;
    padding: 44px 36px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* CTA glow */
  .brand-products__cta-glow {
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.1), transparent 65%);
    pointer-events: none;
  }

  /* CTA top line */
  .brand-products__cta-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.6;
  }

  .brand-products__cta-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .brand-products__cta-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: rgba(var(--accent-rgb), 0.1);
    border: 1px solid rgba(var(--accent-rgb), 0.15);
    color: var(--accent);
    flex-shrink: 0;
  }

  .brand-products__cta-icon svg {
    width: 28px;
    height: 28px;
  }

  .brand-products__cta-text h3 {
    font-size: 1.5rem;
    margin: 0 0 10px;
    color: #fff;
  }

  .brand-products__cta-text p {
    color: rgba(255, 255, 255, 0.5);
    font-size: 1rem;
    margin: 0;
    line-height: 1.7;
  }

  .brand-products__cta-actions {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .brand-products__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border-radius: 14px;
    font-weight: var(--tj-font-semibold);
    text-decoration: none;
    transition: all 0.35s ease;
    font-size: 0.95rem;
  }

  .brand-products__cta-btn svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .brand-products__cta-btn--primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 10px 28px rgba(var(--accent-rgb), 0.25);
  }

  .brand-products__cta-btn--primary:hover {
    filter: brightness(1.08);
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(var(--accent-rgb), 0.35);
  }

  .brand-products__cta-btn--outline {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .brand-products__cta-btn--outline:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  /* ── Responsive ────────────────────────────────────────────── */
  @media (max-width: 820px) {
    .brand-products__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .brand-products__cta-card {
      padding: 32px 24px;
    }

    .brand-products__cta-content {
      flex-direction: column;
    }

    .brand-products__cta-text h3 {
      font-size: 1.3rem;
    }

    .brand-products__filters {
      overflow-x: auto;
      flex-wrap: nowrap;
      justify-content: flex-start;
      padding-bottom: 8px;
      -webkit-overflow-scrolling: touch;
    }

    .filter-pill {
      white-space: nowrap;
      flex-shrink: 0;
    }
  }

  @media (max-width: 520px) {
    .brand-products__grid {
      grid-template-columns: 1fr;
    }

    .brand-products__cta-actions {
      width: 100%;
    }

    .brand-products__cta-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
