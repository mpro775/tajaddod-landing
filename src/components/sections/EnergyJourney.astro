---
import type { Locale } from '../../lib/api/types';
import { dictionary } from '../../i18n';

const { locale } = Astro.props as { locale: Locale };
const journey = dictionary(locale).home.energyJourney;

const brandColors: Record<string, string> = {
  'CNC': '#e63946', // Red
  'Liper': '#ff8c00', // Orange
  'Liper / CNC': '#52af45', // Green blend
  'Tajaddod': 'rgba(255, 255, 255, 0.8)',
};

const brandLogos: Record<string, string> = {
  'CNC': '/logos/cnc-logo-white.svg',
  'Liper': '/logos/liper-logo-white.svg',
  'Liper / CNC': '/logos/tajaddod-icon.svg',
  'Tajaddod': '/logos/tajaddod-icon.svg',
};

const brandIds: Record<string, string> = {
  'CNC': 'cnc',
  'Liper': 'liper',
  'Liper / CNC': 'liper-cnc',
  'Tajaddod': 'tajaddod',
};

---

<section class="section ej-section layer-cinematic" id="journey">
  <!-- Background Effects -->
  <div class="ej-bg" aria-hidden="true">
    <div class="ej-bg__grid"></div>
    <div class="ej-bg__aurora ej-bg__aurora--1"></div>
    <div class="ej-bg__aurora ej-bg__aurora--2"></div>
    <div class="ej-bg__aurora ej-bg__aurora--3"></div>
    <div class="ej-bg__noise"></div>
    <!-- Floating particles container -->
    <canvas class="ej-particles" data-ej-particles></canvas>
  </div>

  <div class="container ej-container">
    <!-- Section Header -->
    <div class="ej-header" data-reveal>
      <div class="ej-header__eyebrow">
        <span class="ej-header__eyebrow-line"></span>
        <span class="ej-header__eyebrow-text">{journey.eyebrow}</span>
        <span class="ej-header__eyebrow-line"></span>
      </div>
      <h2 class="ej-header__title">{journey.title}</h2>
      <p class="ej-header__desc">{journey.description}</p>
    </div>

    <!-- Timeline Container -->
    <div class="ej-timeline" data-ej-timeline>
      <!-- Connecting energy beam -->
      <div class="ej-beam" data-ej-beam>
        <div class="ej-beam__track"></div>
        <div class="ej-beam__progress" data-ej-beam-progress></div>
        <div class="ej-beam__glow" data-ej-beam-glow></div>
      </div>

      <!-- Steps -->
      {journey.steps.map((step, i) => (
        <div 
          class="ej-step" 
          data-ej-step={i}
          data-brand={brandIds[step.brand] || 'tajaddod'}
          style={`--brand-color: ${brandColors[step.brand] || 'rgba(255,255,255,0.8)'}; --step-index: ${i};`}
        >
          <!-- Node on the beam -->
          <div class="ej-step__node">
            <div class="ej-step__node-ring"></div>
            <div class="ej-step__node-core"></div>
            <div class="ej-step__node-pulse"></div>
            <span class="ej-step__node-num">{String(i + 1).padStart(2, '0')}</span>
          </div>

          <!-- Card -->
          <div class="ej-step__card">
            <div class="ej-step__card-glow"></div>
            <div class="ej-step__card-inner">
              <div class="ej-step__progress">
                <span>{String(i + 1).padStart(2, '0')}</span>
                <span>/</span>
                <span>{String(journey.steps.length).padStart(2, '0')}</span>
              </div>
              <!-- Brand badge -->
              <div class="ej-step__brand-badge">
                <img 
                  src={brandLogos[step.brand]} 
                  alt={step.brand} 
                  class="ej-step__brand-logo"
                  loading="lazy"
                />
              </div>
              
              <div class="ej-step__content">
                <span class="ej-step__brand-name" style={`color: ${brandColors[step.brand]}`}>{step.brand}</span>
                <h3 class="ej-step__title">{step.title}</h3>
                <p class="ej-step__desc">{step.text}</p>
              </div>

              <!-- Decorative corner accents -->
              <div class="ej-step__corner ej-step__corner--tl"></div>
              <div class="ej-step__corner ej-step__corner--br"></div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom summary line -->
    <div class="ej-summary" data-reveal>
      <div class="ej-summary__line"></div>
      <div class="ej-summary__brands">
        <img src="/logos/cnc-logo-white.svg" alt="CNC" class="ej-summary__logo" loading="lazy" />
        <span class="ej-summary__plus">+</span>
        <img src="/logos/liper-logo-white.svg" alt="Liper" class="ej-summary__logo" loading="lazy" />
        <span class="ej-summary__eq">=</span>
        <img src="/logos/tajaddod-icon.svg" alt={journey.tajaddodName} class="ej-summary__logo ej-summary__logo--main" loading="lazy" />
      </div>
      <p class="ej-summary__text">{journey.summary}</p>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { documentDirection, fromInlineEnd, fromInlineStart } from '../../lib/direction';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.ej-section') as HTMLElement;
    const timeline = document.querySelector('[data-ej-timeline]') as HTMLElement;
    const steps = document.querySelectorAll('[data-ej-step]');
    const beamProgress = document.querySelector('[data-ej-beam-progress]') as HTMLElement;
    const beamGlow = document.querySelector('[data-ej-beam-glow]') as HTMLElement;
    const canvas = document.querySelector('[data-ej-particles]') as HTMLCanvasElement;
    const isMobile = window.matchMedia('(max-width: 1023px)').matches;
    const direction = documentDirection();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!section || !timeline || steps.length === 0) return;

    // ─── Particle System ────────────────────────────────────
    if (canvas && !isMobile && !reduceMotion) {
      const ctx = canvas.getContext('2d');
      if (ctx) {
        const particles: { x: number; y: number; vx: number; vy: number; size: number; alpha: number; color: string }[] = [];
        const colors = ['#1e99d3', '#159647', '#ff8c00', '#ffffff'];
        
        function resizeCanvas() {
          canvas.width = section.offsetWidth;
          canvas.height = section.offsetHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        // Create particles
        for (let i = 0; i < 26; i++) {
          particles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            vx: (Math.random() - 0.5) * 0.3,
            vy: (Math.random() - 0.5) * 0.3,
            size: Math.random() * 2 + 0.5,
            alpha: Math.random() * 0.3 + 0.1,
            color: colors[Math.floor(Math.random() * colors.length)]
          });
        }

        function animateParticles() {
          if (!ctx) return;
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          
          particles.forEach(p => {
            p.x += p.vx;
            p.y += p.vy;
            
            if (p.x < 0) p.x = canvas.width;
            if (p.x > canvas.width) p.x = 0;
            if (p.y < 0) p.y = canvas.height;
            if (p.y > canvas.height) p.y = 0;
            
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fillStyle = p.color;
            ctx.globalAlpha = p.alpha;
            ctx.fill();
          });
          
          requestAnimationFrame(animateParticles);
        }
        
        // Only animate when section is in viewport
        const particleObserver = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) {
            animateParticles();
          }
        }, { threshold: 0.1 });
        particleObserver.observe(section);
      }
    }

    // ─── Beam Progress Animation ────────────────────────────
    if (beamProgress) {
      gsap.fromTo(beamProgress,
        { scaleY: 0 },
        {
          scaleY: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: timeline,
            start: 'top 70%',
            end: 'bottom 30%',
            scrub: 1.2,
          }
        }
      );
    }

    if (beamGlow) {
      gsap.fromTo(beamGlow,
        { scaleY: 0, opacity: 0 },
        {
          scaleY: 1,
          opacity: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: timeline,
            start: 'top 70%',
            end: 'bottom 30%',
            scrub: 1.2,
          }
        }
      );
    }

    // ─── Step Reveal Animations ─────────────────────────────
    steps.forEach((step, i) => {
      const card = step.querySelector('.ej-step__card');
      const node = step.querySelector('.ej-step__node');
      const brandBadge = step.querySelector('.ej-step__brand-badge');
      const content = step.querySelector('.ej-step__content');

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: step,
          start: 'top 75%',
          end: 'top 25%',
          toggleActions: 'play none none reverse',
        }
      });

      // Node appears first
      tl.from(node, {
        scale: 0,
        opacity: 0,
        duration: 0.5,
        ease: 'back.out(1.7)'
      })
      // Then card slides in
      .from(card, {
        x: isMobile ? 0 : i % 2 === 0 ? fromInlineStart(60, direction) : fromInlineEnd(60, direction),
        y: isMobile ? 18 : 0,
        opacity: 0,
        duration: isMobile ? 0.42 : 0.6,
        ease: 'power3.out'
      }, '-=0.2')
      // Brand badge pops
      .from(brandBadge, {
        scale: 0,
        rotation: -180,
        opacity: 0,
        duration: 0.5,
        ease: 'back.out(2)'
      }, '-=0.3')
      // Content fades up
      .from(content, {
        y: 20,
        opacity: 0,
        duration: 0.4,
        ease: 'power2.out'
      }, '-=0.2');

      // Active state management
      ScrollTrigger.create({
        trigger: step,
        start: 'top 55%',
        end: 'bottom 45%',
        onEnter: () => activateStep(i),
        onEnterBack: () => activateStep(i),
        onLeave: () => deactivateStep(i),
        onLeaveBack: () => deactivateStep(i),
      });
    });

    function activateStep(index: number) {
      steps.forEach((s, i) => {
        if (i === index) {
          s.classList.add('is-active');
        }
      });

      // Update section aurora colors based on active brand
      const brand = steps[index]?.getAttribute('data-brand');
      section.setAttribute('data-active-brand', brand || '');
    }

    function deactivateStep(index: number) {
      steps[index]?.classList.remove('is-active');
    }

    // ─── Header Animation ───────────────────────────────────
    const header = document.querySelector('.ej-header');
    if (header) {
      gsap.from(header.querySelector('.ej-header__eyebrow'), {
        y: 30, opacity: 0, duration: 0.8,
        scrollTrigger: { trigger: header, start: 'top 80%' }
      });
      gsap.from(header.querySelector('.ej-header__title'), {
        y: 40, opacity: 0, duration: 0.8, delay: 0.15,
        scrollTrigger: { trigger: header, start: 'top 80%' }
      });
      gsap.from(header.querySelector('.ej-header__desc'), {
        y: 30, opacity: 0, duration: 0.8, delay: 0.3,
        scrollTrigger: { trigger: header, start: 'top 80%' }
      });
    }

    // ─── Summary Animation ──────────────────────────────────
    const summary = document.querySelector('.ej-summary');
    if (summary) {
      gsap.from(summary, {
        y: 40, opacity: 0, duration: 0.8,
        scrollTrigger: { trigger: summary, start: 'top 85%' }
      });
    }
  });
</script>

<style>
/* ════════════════════════════════════════════════════════════════════════
   Energy Journey — Premium Cinematic Timeline
   ════════════════════════════════════════════════════════════════════════ */

.ej-section {
  position: relative;
  overflow: hidden;
  padding: clamp(100px, 12vw, 180px) 0;
  background: #030a0f !important;
  color: var(--tj-text-inverse);
  transition: background 1s ease;
}

/* Dynamic background based on active brand */
.ej-section[data-active-brand="cnc"] {
  background: radial-gradient(ellipse at 50% 50%, #3a0909 0%, #1f0404 40%, #030a0f 100%) !important;
}
.ej-section[data-active-brand="liper"] {
  background: radial-gradient(ellipse at 50% 50%, #3d210a 0%, #241103 40%, #030a0f 100%) !important;
}
.ej-section[data-active-brand="liper-cnc"] {
  background: radial-gradient(ellipse at 50% 50%, #153d10 0%, #0b2108 40%, #030a0f 100%) !important;
}
.ej-section[data-active-brand="tajaddod"] {
  background: radial-gradient(ellipse at 50% 50%, #0d1820 0%, #080f16 40%, #030a0f 100%) !important;
}

/* ─── Background Effects ───────────────────────────────────── */

.ej-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.ej-bg__grid {
  position: absolute;
  inset: 0;
  opacity: 0.025;
  background-image:
    linear-gradient(var(--tj-inverse-alpha-06) 1px, transparent 1px),
    linear-gradient(90deg, var(--tj-inverse-alpha-06) 1px, transparent 1px);
  background-size: 80px 80px;
}

.ej-bg__aurora {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.06;
  transition: opacity 1.5s ease, background 1.5s ease;
  animation: ejAurora 12s ease-in-out infinite alternate;
}

.ej-bg__aurora--1 {
  width: 800px;
  height: 500px;
  top: -10%;
  left: 10%;
  background: var(--tj-blue);
  animation-delay: 0s;
}

.ej-bg__aurora--2 {
  width: 600px;
  height: 600px;
  bottom: -5%;
  right: 5%;
  background: var(--tj-green);
  animation-delay: -4s;
}

.ej-bg__aurora--3 {
  width: 500px;
  height: 400px;
  top: 40%;
  left: 50%;
  transform: translateX(-50%);
  background: var(--tj-orange);
  animation-delay: -8s;
}

@keyframes ejAurora {
  0% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(20px, -15px) scale(1.1); }
  100% { transform: translate(-10px, 10px) scale(0.95); }
}

.ej-bg__noise {
  position: absolute;
  inset: 0;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
}

.ej-particles {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* ─── Container ────────────────────────────────────────────── */

.ej-container {
  position: relative;
  z-index: 1;
}

/* ─── Header ───────────────────────────────────────────────── */

.ej-header {
  text-align: center;
  margin-bottom: clamp(80px, 10vw, 140px);
  max-width: 700px;
  margin-inline: auto;
}

.ej-header__eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 24px;
}

.ej-header__eyebrow-line {
  width: 40px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--tj-blue), transparent);
}

.ej-header__eyebrow-text {
  font-size: var(--tj-text-nano);
  font-weight: var(--tj-font-bold);
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--tj-blue);
  background: linear-gradient(135deg, var(--tj-blue), var(--tj-green-light));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.ej-header__title {
  font-size: var(--tj-text-h2);
  font-weight: var(--tj-font-extrabold);
  line-height: var(--tj-leading-tight);
  margin-bottom: 20px;
  color: var(--tj-text-inverse);
}

.ej-header__desc {
  font-size: var(--tj-text-body-lg);
  color: var(--tj-inverse-alpha-50);
  line-height: var(--tj-leading-normal);
  max-width: 580px;
  margin-inline: auto;
}

/* ─── Timeline ─────────────────────────────────────────────── */

.ej-timeline {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0 20px;
}

/* ─── Energy Beam (vertical line) ──────────────────────────── */

.ej-beam {
  position: absolute;
  top: 0;
  bottom: 0;
  inset-inline-start: 40px;
  width: 3px;
  z-index: 1;
}

@media (min-width: 1024px) {
  .ej-beam {
    inset-inline-start: 50%;
    transform: translateX(calc(var(--tj-inline-direction) * -50%));
  }
}

.ej-beam__track {
  position: absolute;
  inset: 0;
  background: var(--tj-inverse-alpha-06);
  border-radius: 999px;
}

.ej-beam__progress {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, var(--tj-blue), var(--tj-green), var(--tj-orange));
  border-radius: 999px;
  transform-origin: top;
  transform: scaleY(0);
}

.ej-beam__glow {
  position: absolute;
  top: 0;
  left: -8px;
  right: -8px;
  bottom: 0;
  background: linear-gradient(180deg, 
    color-mix(in srgb, var(--tj-blue) 30%, transparent),
    color-mix(in srgb, var(--tj-green) 30%, transparent),
    color-mix(in srgb, var(--tj-orange) 30%, transparent)
  );
  border-radius: 999px;
  filter: blur(12px);
  transform-origin: top;
  transform: scaleY(0);
  opacity: 0;
}

/* ─── Step ─────────────────────────────────────────────────── */

.ej-step {
  position: relative;
  display: flex;
  align-items: center;
  padding: 40px 0;
  padding-inline-start: 80px;
  opacity: 0.35;
  transition: opacity 0.6s var(--tj-ease-smooth);
}

.ej-step.is-active {
  opacity: 1;
}

@media (min-width: 1024px) {
  .ej-step {
    padding: 50px 0;
    padding-inline-start: 0;
    justify-content: flex-end;
    width: 50%;
    margin-inline-start: auto;
    padding-inline-end: 60px;
  }

  .ej-step:nth-child(even) {
    justify-content: flex-start;
    margin-inline-start: 0;
    margin-inline-end: auto;
    padding-inline-end: 0;
    padding-inline-start: 60px;
    flex-direction: row-reverse;
  }
}

/* ─── Node ─────────────────────────────────────────────────── */

.ej-step__node {
  position: absolute;
  inset-inline-start: 26px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
  flex-shrink: 0;
}

@media (min-width: 1024px) {
  .ej-step__node {
    inset-inline: auto;
    position: absolute;
  }
  .ej-step:nth-child(odd) .ej-step__node {
    inset-inline-start: -16px;
  }
  .ej-step:nth-child(even) .ej-step__node {
    inset-inline-end: -16px;
  }
}

.ej-step__node-ring {
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 2px solid var(--brand-color);
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.5s var(--tj-ease-spring);
}

.ej-step.is-active .ej-step__node-ring {
  opacity: 0.6;
  transform: scale(1);
}

.ej-step__node-core {
  position: absolute;
  inset: 4px;
  border-radius: 50%;
  background: #0a1520;
  border: 2px solid var(--tj-inverse-alpha-15);
  transition: all 0.5s var(--tj-ease-smooth);
}

.ej-step.is-active .ej-step__node-core {
  background: var(--brand-color);
  border-color: var(--brand-color);
  box-shadow: 
    0 0 20px var(--brand-color),
    0 0 40px color-mix(in srgb, var(--brand-color) 40%, transparent);
}

.ej-step__node-pulse {
  position: absolute;
  inset: -8px;
  border-radius: 50%;
  background: var(--brand-color);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.ej-step.is-active .ej-step__node-pulse {
  animation: ejNodePulse 2s ease-out infinite;
}

@keyframes ejNodePulse {
  0% { transform: scale(0.8); opacity: 0.4; }
  100% { transform: scale(2.5); opacity: 0; }
}

.ej-step__node-num {
  position: absolute;
  top: -28px;
  font-size: 0.6rem;
  font-weight: var(--tj-font-bold);
  color: var(--tj-inverse-alpha-20);
  letter-spacing: 0.1em;
  transition: color 0.4s ease;
}

.ej-step.is-active .ej-step__node-num {
  color: var(--brand-color);
}

/* ─── Card ─────────────────────────────────────────────────── */

.ej-step__card {
  position: relative;
  flex: 1;
  max-width: 450px;
}

.ej-step__card-glow {
  position: absolute;
  inset: -1px;
  border-radius: 22px;
  background: linear-gradient(135deg, 
    color-mix(in srgb, var(--brand-color) 20%, transparent),
    transparent 60%
  );
  opacity: 0;
  transition: opacity 0.6s ease;
  z-index: 0;
}

.ej-step.is-active .ej-step__card-glow {
  opacity: 1;
}

.ej-step__card-inner {
  position: relative;
  background: var(--tj-inverse-alpha-03);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--tj-inverse-alpha-06);
  border-radius: 22px;
  padding: 32px;
  overflow: hidden;
  transition: all 0.6s var(--tj-ease-smooth);
}

.ej-step__progress {
  position: absolute;
  top: 18px;
  left: 18px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: var(--tj-inverse-alpha-40);
  font-size: var(--tj-text-nano);
  font-weight: var(--tj-font-bold);
  letter-spacing: 0;
}

.ej-step.is-active .ej-step__card-inner {
  background: var(--tj-inverse-alpha-05);
  border-color: var(--tj-inverse-alpha-12);
  box-shadow: 
    0 24px 48px color-mix(in srgb, var(--tj-neutral-950) 40%, transparent),
    inset 0 1px 0 var(--tj-inverse-alpha-06);
}

/* Corner accents */
.ej-step__corner {
  position: absolute;
  width: 20px;
  height: 20px;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.ej-step.is-active .ej-step__corner {
  opacity: 0.3;
}

.ej-step__corner--tl {
  top: 12px;
  left: 12px;
  border-top: 2px solid var(--brand-color);
  border-left: 2px solid var(--brand-color);
}

.ej-step__corner--br {
  bottom: 12px;
  right: 12px;
  border-bottom: 2px solid var(--brand-color);
