---
interface Props {
  product: any;
  brandColor: string;
}

const { product, brandColor } = Astro.props;

// Extract RGB from hex
const hexToRgb = (hex: string) => {
  const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  return result ? `${parseInt(result[1], 16)}, ${parseInt(result[2], 16)}, ${parseInt(result[3], 16)}` : '230, 57, 70';
};

const rgb = hexToRgb(brandColor);
---

<article class="product-card" style={`--brand: ${brandColor}; --brand-rgb: ${rgb};`}>
  <!-- Image section -->
  <div class="product-card__image-wrap">
    <div class="product-card__image-bg"></div>
    <img src={product.image} alt={product.name} class="product-card__image" loading="lazy" />

    {product.badges && product.badges.length > 0 && (
      <div class="product-card__badges">
        {product.badges.map((badge: string) => (
          <span class="product-card__badge">{badge}</span>
        ))}
      </div>
    )}

    <!-- Hover overlay -->
    <div class="product-card__overlay">
      <span class="product-card__view-text">عرض التفاصيل</span>
    </div>
  </div>

  <!-- Content -->
  <div class="product-card__content">
    <div class="product-card__meta">
      <span class="product-card__category">{product.category}</span>
      {product.type && product.type !== product.category && (
        <span class="product-card__type">{product.type}</span>
      )}
    </div>

    <h3 class="product-card__title">{product.name}</h3>
    <p class="product-card__desc">{product.description}</p>

    <!-- Footer info -->
    <div class="product-card__footer">
      {product.warrantyYears && (
        <div class="product-card__warranty">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>ضمان {product.warrantyYears} سنوات</span>
        </div>
      )}
    </div>
  </div>

  <!-- Energy bar -->
  <div class="product-card__energy">
    <div class="product-card__energy-fill"></div>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 22px;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.4s var(--tj-ease-smooth);
  }

  .product-card:hover {
    transform: translateY(-6px);
    border-color: rgba(var(--brand-rgb), 0.25);
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.3),
      0 0 30px rgba(var(--brand-rgb), 0.06);
  }

  /* ── Image section ─────────────────────────────────────────── */
  .product-card__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px;
  }

  .product-card__image-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      145deg,
      rgba(var(--brand-rgb), 0.04),
      rgba(255, 255, 255, 0.02)
    );
    transition: background 0.4s ease;
  }

  .product-card:hover .product-card__image-bg {
    background: linear-gradient(
      145deg,
      rgba(var(--brand-rgb), 0.08),
      rgba(255, 255, 255, 0.03)
    );
  }

  .product-card__image {
    position: relative;
    z-index: 1;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.5s var(--tj-ease-smooth);
    filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.15));
  }

  .product-card:hover .product-card__image {
    transform: scale(1.06);
  }

  /* Badges */
  .product-card__badges {
    position: absolute;
    z-index: 2;
    top: 14px;
    right: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .product-card__badge {
    background: rgba(var(--brand-rgb), 0.85);
    color: #fff;
    font-size: var(--tj-text-micro);
    padding: 4px 10px;
    border-radius: 8px;
    font-weight: var(--tj-font-semibold);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 12px rgba(var(--brand-rgb), 0.2);
  }

  /* Overlay */
  .product-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .product-card:hover .product-card__overlay {
    opacity: 1;
  }

  .product-card__view-text {
    padding: 10px 24px;
    border-radius: 999px;
    background: rgba(var(--brand-rgb), 0.85);
    color: #fff;
    font-size: var(--tj-text-small);
    font-weight: var(--tj-font-semibold);
    box-shadow: 0 8px 24px rgba(var(--brand-rgb), 0.3);
    transform: translateY(10px);
    transition: transform 0.35s ease;
  }

  .product-card:hover .product-card__view-text {
    transform: translateY(0);
  }

  /* ── Content section ───────────────────────────────────────── */
  .product-card__content {
    padding: 22px 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .product-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .product-card__category {
    font-size: var(--tj-text-micro);
    color: var(--brand);
    font-weight: var(--tj-font-semibold);
    padding: 3px 10px;
    border-radius: 6px;
    background: rgba(var(--brand-rgb), 0.08);
  }

  .product-card__type {
    font-size: var(--tj-text-micro);
    color: rgba(255, 255, 255, 0.4);
  }

  .product-card__title {
    font-size: 1.05rem;
    color: #fff;
    margin: 0;
    line-height: 1.45;
    font-weight: var(--tj-font-semibold);
  }

  .product-card__desc {
    color: rgba(255, 255, 255, 0.45);
    font-size: var(--tj-text-small);
    line-height: 1.7;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__footer {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .product-card__warranty {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--tj-text-micro);
    color: rgba(255, 255, 255, 0.5);
  }

  .product-card__warranty svg {
    width: 14px;
    height: 14px;
    color: var(--brand);
    opacity: 0.7;
  }

  /* ── Energy bar ────────────────────────────────────────────── */
  .product-card__energy {
    height: 2px;
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
  }

  .product-card__energy-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, transparent, var(--brand), transparent);
    transition: width 0.6s var(--tj-ease-energy);
  }

  .product-card:hover .product-card__energy-fill {
    width: 100%;
  }
</style>
