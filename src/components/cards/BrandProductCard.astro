---
import type { LandingProduct, Locale, PublicProductSummary } from '../../lib/api/types';
import { dictionary } from '../../i18n';
import { formatWarrantyDuration } from '../../i18n/format';
import { localePath } from '../../lib/content';
import { brandAccent, productView, PRODUCT_PLACEHOLDER } from '../../lib/product-view';

interface Props {
  product: LandingProduct | PublicProductSummary;
  locale: Locale;
  brand?: { name: string; slug: string };
}
const { product, locale, brand } = Astro.props;
const view = productView(product, locale);
const labels = dictionary(locale);
const warranty = formatWarrantyDuration(view.warrantyYears, locale);
const brandName = view.brandName || brand?.name;
const accent = brandAccent(view.brandSlug || brand?.slug);
---
{view.identifier && (
  <a class="product-tile" href={localePath(locale, `/products/${encodeURIComponent(view.identifier)}`)} style={`--product-accent: ${accent}`}>
    <div class="product-tile__media">
      <img src={view.image} alt={view.image === PRODUCT_PLACEHOLDER ? labels.catalog.imageUnavailable : view.name} width="640" height="480" loading="lazy" decoding="async" data-image-fallback={PRODUCT_PLACEHOLDER} />
    </div>
    <div class="product-tile__body">
      <div class="product-tile__meta">
        {brandName && <span class="product-tile__brand">{brandName}</span>}
        {view.category && <span>{view.category}</span>}
      </div>
      <h3>{view.name}</h3>
      {view.description && <p class="product-tile__description">{view.description}</p>}
      {warranty && <p class="product-tile__warranty">{warranty}</p>}
      <span class="product-tile__details">{labels.brands.productCard.details}<span class="directional-icon" aria-hidden="true">←</span></span>
    </div>
  </a>
)}
