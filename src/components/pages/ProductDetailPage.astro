---
import type { Locale, PublicProductDetail, PublicProductSummary } from '../../lib/api/types';
import { dictionary, formatMessage } from '../../i18n';
import { formatWarrantyDuration } from '../../i18n/format';
import { localePath } from '../../lib/content';
import { productView, PRODUCT_PLACEHOLDER } from '../../lib/product-view';
import BrandProductCard from '../cards/BrandProductCard.astro';

interface Props { locale: Locale; product: PublicProductDetail; related?: PublicProductSummary[]; }
const { locale, product, related = [] } = Astro.props;
const view = productView(product, locale);
const copy = dictionary(locale);
const labels = copy.catalog;
const warranty = formatWarrantyDuration(view.warrantyYears, locale);
const media = [product.mainImage, ...(product.images || [])]
  .map((image) => typeof image === 'string' ? image : image?.url)
  .filter((url, index, source): url is string => Boolean(url) && source.indexOf(url) === index);
const images = media.length ? media : [PRODUCT_PLACEHOLDER];
const brandPath = view.brandSlug ? localePath(locale, `/brands/${view.brandSlug}`) : undefined;
const catalogPath = brandPath ? `${brandPath}/products` : undefined;
const specifications = (product.attributesDetails || []).flatMap((attribute) => {
  const name = locale === 'en' ? attribute.nameEn || attribute.name : attribute.name || attribute.nameEn;
  const values = (attribute.values || []).map((value) => locale === 'en'
    ? value.valueEn || value.nameEn || value.label || value.value || value.name
    : value.label || value.value || value.name || value.nameEn || value.valueEn).filter(Boolean);
  return name && values.length ? [{ name, value: values.join(locale === 'en' ? ', ' : '، ') }] : [];
});
const relatedProducts = related.filter((item) => productView(item, locale).identifier).slice(0, 4);
---
<main class="product-detail">
  <section class="product-information">
    <div class="container">
      <nav class="catalog-breadcrumb" aria-label={copy.common.breadcrumb}>
        <a href={localePath(locale, '/')}>{copy.nav.home}</a><span aria-hidden="true">/</span>
        <a href={localePath(locale, '/brands')}>{copy.nav.brands}</a><span aria-hidden="true">/</span>
        {brandPath && <><a href={brandPath}>{view.brandName}</a><span aria-hidden="true">/</span><a href={catalogPath}>{labels.products}</a><span aria-hidden="true">/</span></>}
        <span aria-current="page">{view.name}</span>
      </nav>
      <div class="product-information__grid">
        <div class="product-gallery" data-product-gallery data-gallery-message={labels.imageChanged}>
          <div class="product-gallery__main">
            <img src={images[0]} alt={images[0] === PRODUCT_PLACEHOLDER ? labels.imageUnavailable : view.name} width="900" height="700" data-gallery-main data-image-fallback={PRODUCT_PLACEHOLDER} fetchpriority="high" />
          </div>
          {media.length === 0 && <p class="product-gallery__unavailable">{labels.imageUnavailable}</p>}
          {media.length > 1 && (
            <div class="product-gallery__thumbnails" role="group" aria-label={labels.gallery}>
              {images.map((url, index) => (
                <button type="button" data-gallery-image={url} data-gallery-index={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-label={formatMessage(labels.imageNumber, { number: index + 1, name: view.name })}>
                  <img src={url} alt="" width="120" height="96" loading="lazy" data-image-fallback={PRODUCT_PLACEHOLDER} />
                </button>
              ))}
            </div>
          )}
          <p class="sr-only" data-gallery-status aria-live="polite" aria-atomic="true"></p>
        </div>
        <div class="product-information__copy">
          <p class="eyebrow">{labels.overview}</p>
          {view.brandName && (brandPath ? <a class="product-information__brand" href={brandPath}>{view.brandName}</a> : <p class="product-information__brand">{view.brandName}</p>)}
          <h1>{view.name}</h1>
          {view.description && <p class="product-information__description">{view.description}</p>}
          {view.category && <dl class="product-information__facts">
            {view.category && <div><dt>{labels.category}</dt><dd>{view.category}</dd></div>}
          </dl>}
          {warranty && <p class="product-information__warranty">{warranty}</p>}
          <div class="product-information__actions">
            <a class="catalog-button" href={`${localePath(locale, '/')}#contact`}>{labels.contact}</a>
            {catalogPath && <a class="catalog-text-link" href={catalogPath}>{formatMessage(labels.browseBrand, { brand: view.brandName })}</a>}
          </div>
        </div>
      </div>
    </div>
  </section>
  {specifications.length > 0 && (
    <section class="product-specifications section">
      <div class="container">
        <header class="catalog-section-heading"><h2>{labels.specifications}</h2></header>
        <dl>{specifications.map((specification) => <div><dt>{specification.name}</dt><dd>{specification.value}</dd></div>)}</dl>
      </div>
    </section>
  )}
  {relatedProducts.length > 0 && (
    <section class="product-showcase section">
      <div class="container">
        <header class="catalog-section-heading"><h2>{labels.related}</h2></header>
        <div class="catalog-grid">{relatedProducts.map((item) => <BrandProductCard product={item} locale={locale} />)}</div>
      </div>
    </section>
  )}
</main>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
    const status = gallery.querySelector<HTMLElement>('[data-gallery-status]');
    const buttons = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-image]'));
    if (!main || buttons.length === 0) return;
    const select = (index: number, focus = false) => {
      const button = buttons[index];
      const source = button?.dataset.galleryImage;
      if (!source) return;
      main.dataset.imageFallback = '/assets/products/product-placeholder.svg';
      main.src = source;
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      if (status) status.textContent = (gallery.dataset.galleryMessage || '').replace('{number}', String(index + 1)).replace('{total}', String(buttons.length));
      if (focus) button.focus();
    };
    buttons.forEach((button, index) => {
      button.addEventListener('click', () => select(index));
      button.addEventListener('keydown', (event) => {
        const direction = document.documentElement.dir === 'rtl' ? -1 : 1;
        let next = index;
        if (event.key === 'ArrowRight') next = (index + direction + buttons.length) % buttons.length;
        else if (event.key === 'ArrowLeft') next = (index - direction + buttons.length) % buttons.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = buttons.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
      });
    });
  });
</script>
