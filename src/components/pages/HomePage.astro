---
import type { Locale, WebsiteHome } from '../../lib/api/types';
import CinematicHero from '../sections/CinematicHero.astro';
import About from '../sections/About.astro';
import Achievements from '../sections/Achievements.astro';
import Brands from '../sections/Brands.astro';
import FeaturedProjects from '../sections/FeaturedProjects.astro';
import MarketRole from '../sections/MarketRole.astro';
import Coverage from '../sections/Coverage.astro';
import Sectors from '../sections/Sectors.astro';
import EnergyJourney from '../sections/EnergyJourney.astro';
import AppDownload from '../sections/AppDownload.astro';
import LatestNews from '../sections/LatestNews.astro';
import ContactCTA from '../sections/ContactCTA.astro';

interface Props {
  locale: Locale;
  home?: WebsiteHome;
  error?: string;
}

const { locale, home, error } = Astro.props;
const settings = home?.settings;
const projects = settings?.enableProjectsSection === false ? [] : (home?.projects || []);
const articles = settings?.enableArticlesSection === false ? [] : (home?.articles || []);
const brands = settings?.enableBrandsSection === false ? [] : (home?.brands || []);
---

<main>
  <CinematicHero />
  <About />
  <Achievements />

  {error && (
    <div class="container visual-restore-error" role="status">
      {error}
    </div>
  )}

  {brands.length > 0 && <Brands locale={locale} brands={brands} />}
  {projects.length > 0 && <FeaturedProjects locale={locale} projects={projects} />}

  <MarketRole />
  <Coverage />
  <Sectors />
  <EnergyJourney />
  <AppDownload />

  {articles.length > 0 && <LatestNews locale={locale} articles={articles} />}
  <ContactCTA />
</main>

<style>
  .visual-restore-error {
    margin-top: 24px;
    margin-bottom: 24px;
    padding: 14px 18px;
    border: 1px solid rgba(220, 70, 70, .2);
    border-radius: 14px;
    background: rgba(220, 70, 70, .06);
    color: #8b2f2f;
  }
</style>
