---
import type { Locale, ProjectCollection } from '../../lib/api/types';
import { localePath } from '../../lib/content';
import { applyProjectFilters, type FilterQuery } from '../../lib/filters';
import { categoryLabels, dictionary, sectorLabels, serviceLabels } from '../../i18n';
import { toLegacyProject } from '../../lib/visual/legacy-view';
import PageHeader from '../layout/PageHeader.astro';
import FilterBar from '../ui/FilterBar.astro';

interface Props {
  locale: Locale;
  collection?: ProjectCollection;
  error?: string;
  query?: FilterQuery;
}

const { locale, collection, error, query = {} } = Astro.props;
const labels = dictionary(locale).projects;
const rawCollection = collection || { projects: [], pagination: { total: 0, page: 1, limit: 100, totalPages: 0 } };
const filtered = applyProjectFilters(rawCollection, query);
const projects = filtered.projects.map((project) => toLegacyProject(project, locale));
const categories = [...new Set(rawCollection.projects.map((project) => project.category).filter(Boolean))];
const baseWithoutCategory = Object.fromEntries(Object.entries(query).filter(([key]) => key !== 'category'));
const tabs = [
  { label: dictionary(locale).common.all, query: baseWithoutCategory, active: !query.category },
  ...categories.map((category) => ({
    label: categoryLabels[locale][category] || category,
    query: { ...baseWithoutCategory, category },
    active: query.category === category,
  })),
];
const countLabel = locale === 'en'
  ? `${projects.length} project${projects.length === 1 ? '' : 's'}`
  : `${projects.length} مشروع`;
---

<main class="projects-page">
  <PageHeader title={labels.pageTitle} description={labels.pageDescription} />
  <section class="projects-content section">
    <div class="container">
      <FilterBar locale={locale} action="/projects" query={query} searchLabel={labels.search} tabs={tabs} resultsLabel={countLabel} clearLabel={labels.reset} ariaLabel={labels.categoriesLabel}>
        <input type="search" name="client" value={query.client || ''} placeholder={labels.clientSearch} />
        <input type="number" name="year" min="1900" max="2100" value={query.year || ''} placeholder={labels.year} />
        <select name="service" aria-label={labels.service}>
          <option value="">{labels.allServices}</option>
          {Object.entries(serviceLabels[locale]).map(([value, label]) => <option value={value} selected={query.service === value}>{label}</option>)}
        </select>
        <select name="sector" aria-label={labels.sector}>
          <option value="">{labels.allSectors}</option>
          {Object.entries(sectorLabels[locale]).map(([value, label]) => <option value={value} selected={query.sector === value}>{label}</option>)}
        </select>
        {query.category && <input type="hidden" name="category" value={query.category} />}
      </FilterBar>

      {error ? (
        <div class="page-state" role="alert"><p>{error}</p><a href={localePath(locale, '/projects')}>{labels.reset}</a></div>
      ) : projects.length === 0 ? (
        <div class="page-state"><p>{labels.empty}</p>{Object.keys(query).length > 0 && <a href={localePath(locale, '/projects')}>{labels.reset}</a>}</div>
      ) : (
        <div class="projects-grid">
          {projects.map((project) => (
            <a href={localePath(locale, `/projects/${project.slug}`)} class="project-card">
              <div class="card-image"><img src={project.coverImage} alt={project.title} width="1200" height="750" loading="lazy" /><span>{project.category}</span></div>
              <div class="card-content"><h2>{project.title}</h2><p>{project.location} · {project.year}</p>{project.summary && <span>{project.summary}</span>}</div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</main>

<style>
  .projects-page { min-height:100vh; color:var(--tj-text-primary); background:var(--tj-bg-page); }
  .projects-content { background:var(--tj-bg-section); }
  .projects-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--tj-card-gap); }
  .project-card { display:flex; flex-direction:column; overflow:hidden; color:var(--tj-text-primary); text-decoration:none; border:1px solid var(--tj-border-subtle); border-radius:var(--tj-radius-xl); background:var(--tj-bg-surface); box-shadow:var(--tj-shadow-1); transition:transform var(--tj-transition-smooth),box-shadow var(--tj-transition-smooth),border-color var(--tj-transition-smooth); }
  .project-card:hover { transform:translateY(-6px); border-color:var(--tj-border-strong); box-shadow:var(--tj-shadow-3); }
  .project-card:focus-visible { outline:3px solid var(--tj-focus-ring); outline-offset:4px; }
  .card-image { position:relative; aspect-ratio:16/10; overflow:hidden; background:var(--tj-bg-surface-soft); }
  .card-image img { width:100%; height:100%; object-fit:cover; transition:transform .5s ease; } .project-card:hover img{transform:scale(1.04)}
  .card-image span { position:absolute; inset-block-start:1rem; inset-inline-end:1rem; padding:.35rem .7rem; color:var(--tj-text-on-brand); background:var(--tj-action-primary); border-radius:var(--tj-radius-pill); font-size:var(--tj-type-caption); }
  .card-content { display:grid; gap:.75rem; padding:1.5rem; } .card-content h2{color:var(--tj-text-primary);font-size:var(--tj-type-h3)} .card-content p{color:var(--tj-text-muted)} .card-content span{color:var(--tj-text-secondary);line-height:var(--tj-leading-body)}
  .page-state { display:grid; justify-items:center; gap:1rem; max-width:50rem; margin-inline:auto; padding:3rem; text-align:center; color:var(--tj-text-secondary); border:1px solid var(--tj-border-default); border-radius:var(--tj-radius-xl); background:var(--tj-bg-surface); }
  .page-state a { color:var(--tj-text-accent); font-weight:var(--tj-font-bold); }
  @media(max-width:1100px){.projects-grid{grid-template-columns:repeat(2,1fr)}} @media(max-width:700px){.projects-grid{grid-template-columns:1fr}}
</style>
