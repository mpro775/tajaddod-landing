---
import type { Locale, ProjectCollection } from '../../lib/api/types';
import { localePath } from '../../lib/content';
import { categoryLabels, dictionary, sectorLabels, serviceLabels } from '../../i18n';
import { toLegacyProject } from '../../lib/visual/legacy-view';

interface Props {
  locale: Locale;
  collection?: ProjectCollection;
  error?: string;
  query?: Record<string, string>;
}

const { locale, collection, error, query = {} } = Astro.props;
const copy = dictionary(locale);
const labels = copy.projects;
const projects = (collection?.projects || []).map((project) => toLegacyProject(project, locale));
const allLabel = copy.common.all;
const categories = [allLabel, ...new Set(projects.map((p) => p.category).filter(Boolean))];
---

<main class="projects-page">
  <div class="page-header theme-inverse">
    <div class="container">
      <h1 class="page-title">{labels.pageTitle}</h1>
      <p class="page-desc">{labels.pageDescription}</p>
    </div>
  </div>

  <div class="container">
    {error && <div class="projects-error" role="status">{error}</div>}

    {projects.length > 0 ? (
      <>
        <div class="filters" aria-label={labels.categoriesLabel}>
          {categories.map((cat, index) => (
            <button type="button" class={`filter-btn ${index === 0 ? 'active' : ''}`} data-filter={index === 0 ? 'all' : cat}>
              {cat}
            </button>
          ))}
        </div>

        <details class="advanced-filters" open={Boolean(query.search || query.client || query.year || query.service || query.sector)}>
          <summary>{labels.advanced}</summary>
          <form class="advanced-filters__form" action={localePath(locale, '/projects')} method="get">
            <input type="search" name="search" value={query.search || ''} placeholder={labels.search} />
            <input type="search" name="client" value={query.client || ''} placeholder={labels.clientSearch} />
            <input type="number" name="year" min="1900" max="2100" value={query.year || ''} placeholder={labels.year} />
            <select name="service" aria-label={labels.service}>
              <option value="">{labels.allServices}</option>
              {Object.entries(serviceLabels[locale]).map(([value, label]) => (
                <option value={value} selected={query.service === value}>{label}</option>
              ))}
            </select>
            <select name="sector" aria-label={labels.sector}>
              <option value="">{labels.allSectors}</option>
              {Object.entries(sectorLabels[locale]).map(([value, label]) => (
                <option value={value} selected={query.sector === value}>{label}</option>
              ))}
            </select>
            <select name="category" aria-label={labels.category}>
              <option value="">{labels.allCategories}</option>
              {Object.entries(categoryLabels[locale]).map(([value, label]) => (
                <option value={value} selected={query.category === value}>{label}</option>
              ))}
            </select>
            <div class="advanced-filters__actions">
              <button class="advanced-filter-submit" type="submit">{labels.apply}</button>
              <a class="advanced-filter-reset" href={localePath(locale, '/projects')}>{labels.reset}</a>
            </div>
          </form>
        </details>

        <div class="projects-grid">
          {projects.map((project) => (
            <a href={localePath(locale, `/projects/${project.slug}`)} class="project-card" data-category={project.category}>
              <div class="card-image">
                <img src={project.coverImage} alt={project.title} loading="lazy" />
                <span class="card-badge">{project.category}</span>
              </div>
              <div class="card-content">
                <h2 class="card-title">{project.title}</h2>
                <div class="card-meta">
                  <span class="meta-item">{project.location}</span>
                  <span class="meta-item">{project.year}</span>
                </div>
                {project.summary && <p class="card-summary">{project.summary}</p>}
              </div>
            </a>
          ))}
        </div>
      </>
    ) : !error && <div class="projects-empty">{labels.empty}</div>}
  </div>
</main>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((button) => button.classList.remove('active'));
      btn.classList.add('active');
      const filterValue = btn.getAttribute('data-filter');
      projectCards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category');
        card.style.display = filterValue === 'all' || filterValue === cardCategory ? 'flex' : 'none';
      });
    });
  });
</script>

<style>
  .projects-page {
    background: var(--tj-bg-page);
    min-height: 100vh;
    padding-bottom: var(--tj-section-space);
    color: var(--tj-text-primary);
  }
  .page-header {
    padding: clamp(120px, 15vw, 160px) 0 clamp(60px, 8vw, 80px);
    text-align: center;
    background:
      radial-gradient(circle at 50% 0%, rgba(var(--tj-blue-rgb), 0.22), transparent 52%),
      var(--tj-bg-inverse);
  }
  .page-title {
    font-size: var(--tj-type-h1);
    font-weight: var(--tj-font-bold);
    margin-bottom: var(--tj-space-lg);
    color: var(--tj-text-inverse);
  }
  .page-desc {
    font-size: var(--tj-type-body-lg);
    color: var(--tj-inverse-alpha-70);
    max-width: 700px;
    margin: 0 auto;
    line-height: var(--tj-leading-body);
  }
  .projects-error,.projects-empty{max-width:760px;margin:0 auto 36px;padding:18px 22px;border:1px solid var(--tj-border-default);border-radius:var(--tj-radius-lg);background:var(--tj-bg-surface);color:var(--tj-text-secondary);text-align:center}
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tj-space-3);
    justify-content: center;
    margin-bottom: var(--tj-space-7);
  }
  .filter-btn {
    background: var(--tj-bg-surface);
    border: 1px solid var(--tj-border-default);
    color: var(--tj-text-secondary);
    padding: 10px 24px;
    border-radius: var(--tj-radius-pill);
    cursor: pointer;
    font-size: var(--tj-type-body);
    transition: background-color var(--tj-transition-base), color var(--tj-transition-base), border-color var(--tj-transition-base);
  }
  .filter-btn:hover { background: var(--tj-action-soft); color: var(--tj-text-accent); }
  .filter-btn.active { background: var(--tj-action-primary); color: var(--tj-text-on-brand); border-color: var(--tj-action-primary); }
  .advanced-filters{margin:-18px auto 42px;max-width:1080px;border:1px solid var(--tj-border-default);border-radius:var(--tj-radius-lg);background:var(--tj-bg-surface);box-shadow:var(--tj-shadow-1);overflow:hidden}
  .advanced-filters summary{cursor:pointer;list-style:none;padding:14px 18px;color:var(--tj-text-secondary);font-weight:var(--tj-font-semibold);text-align:center}
  .advanced-filters summary::-webkit-details-marker{display:none}
  .advanced-filters__form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:0 18px 18px}
  .advanced-filters__form input,.advanced-filters__form select{width:100%;min-height:46px;border:1px solid var(--tj-border-default);border-radius:var(--tj-radius-md);background:var(--tj-bg-surface-soft);color:var(--tj-text-primary);padding:0 14px;font:inherit;outline:none}
  .advanced-filters__form input:focus,.advanced-filters__form select:focus{border-color:var(--tj-focus-ring);box-shadow:0 0 0 3px color-mix(in srgb,var(--tj-focus-ring) 20%,transparent)}
  .advanced-filters__actions{grid-column:1/-1;display:flex;gap:10px;justify-content:center;padding-top:4px}
  .advanced-filter-submit,.advanced-filter-reset{min-height:44px;border-radius:var(--tj-radius-pill);padding:0 22px;font:inherit;font-weight:var(--tj-font-semibold);display:inline-flex;align-items:center;justify-content:center;text-decoration:none}
  .advanced-filter-submit{border:0;background:var(--tj-action-primary);color:var(--tj-text-on-brand);cursor:pointer}
  .advanced-filter-reset{border:1px solid var(--tj-border-default);color:var(--tj-text-secondary);background:transparent}
  .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--tj-card-gap); }
  .project-card {
    background: var(--tj-bg-surface);
    border: 1px solid var(--tj-border-subtle);
    border-radius: var(--tj-radius-lg);
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    box-shadow: var(--tj-shadow-1);
    transition: transform var(--tj-transition-smooth), border-color var(--tj-transition-smooth), box-shadow var(--tj-transition-smooth);
  }
  .project-card:hover { transform: translateY(-5px); border-color: var(--tj-border-strong); box-shadow: var(--tj-shadow-3); }
  .card-image { position: relative; width: 100%; aspect-ratio: 16/10; overflow: hidden; background:var(--tj-bg-surface-soft); }
  .card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .project-card:hover .card-image img { transform: scale(1.05); }
  .card-badge { position: absolute; top: 16px; inset-inline-end: 16px; background: var(--tj-action-primary); color: var(--tj-text-on-brand); font-size: var(--tj-type-caption); padding: 4px 12px; border-radius: var(--tj-radius-pill); font-weight: var(--tj-font-semibold); }
  .card-content { padding: 24px; flex: 1; display: flex; flex-direction: column; }
  .card-title { font-size: var(--tj-type-h3); color: var(--tj-text-primary); margin-bottom: 12px; font-weight: var(--tj-font-bold); }
  .card-meta { display: flex; gap: 16px; margin-bottom: 16px; font-size: var(--tj-type-small); color: var(--tj-text-muted); }
  .card-summary { color: var(--tj-text-secondary); font-size: 0.95rem; line-height: 1.6; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  @media(max-width:1023px){.advanced-filters__form{grid-template-columns:1fr 1fr}}
  @media(max-width:767px){.projects-grid{grid-template-columns:1fr}.filter-btn{padding:9px 17px;font-size:.9rem}.card-meta{flex-wrap:wrap}.advanced-filters__form{grid-template-columns:1fr}.advanced-filters__actions{flex-direction:column}.advanced-filter-submit,.advanced-filter-reset{width:100%}}
</style>
