---
import type { Locale, ProjectCollection } from '../../lib/api/types';
import { localePath } from '../../lib/content';
import { categoryLabels, sectorLabels, serviceLabels } from '../../i18n';
import { toLegacyProject } from '../../lib/visual/legacy-view';

interface Props {
  locale: Locale;
  collection?: ProjectCollection;
  error?: string;
  query?: Record<string, string>;
}

const { locale, collection, error, query = {} } = Astro.props;
const isEn = locale === 'en';
const projects = (collection?.projects || []).map((project) => toLegacyProject(project, locale));
const allLabel = isEn ? 'All' : 'الكل';
const categories = [allLabel, ...new Set(projects.map((p) => p.category).filter(Boolean))];
---

<main class="projects-page">
  <div class="page-header">
    <div class="container">
      <h1 class="page-title">{isEn ? 'Projects delivered by Tajaddod' : 'مشاريع نفذتها تجدد'}</h1>
      <p class="page-desc">{isEn ? 'Integrated electrical and solar-energy work delivered for commercial, service and infrastructure projects.' : 'نشارك في تنفيذ حلول كهربائية وطاقة شمسية متكاملة للمشاريع السكنية والتجارية والخدمية.'}</p>
    </div>
  </div>

  <div class="container">
    {error && <div class="projects-error" role="status">{error}</div>}

    {projects.length > 0 ? (
      <>
        <div class="filters" aria-label={isEn ? 'Project categories' : 'تصنيفات المشاريع'}>
          {categories.map((cat, index) => (
            <button type="button" class={`filter-btn ${index === 0 ? 'active' : ''}`} data-filter={index === 0 ? 'all' : cat}>
              {cat}
            </button>
          ))}
        </div>

        <details class="advanced-filters" open={Boolean(query.search || query.client || query.year || query.service || query.sector)}>
          <summary>{isEn ? 'Advanced filters' : 'فلترة متقدمة'}</summary>
          <form class="advanced-filters__form" action={localePath(locale, '/projects')} method="get">
            <input type="search" name="search" value={query.search || ''} placeholder={isEn ? 'Search projects' : 'ابحث في المشاريع'} />
            <input type="search" name="client" value={query.client || ''} placeholder={isEn ? 'Client name' : 'اسم العميل'} />
            <input type="number" name="year" min="1900" max="2100" value={query.year || ''} placeholder={isEn ? 'Year' : 'السنة'} />
            <select name="service" aria-label={isEn ? 'Service' : 'الخدمة'}>
              <option value="">{isEn ? 'All services' : 'كل الخدمات'}</option>
              {Object.entries(serviceLabels[locale]).map(([value, label]) => (
                <option value={value} selected={query.service === value}>{label}</option>
              ))}
            </select>
            <select name="sector" aria-label={isEn ? 'Sector' : 'القطاع'}>
              <option value="">{isEn ? 'All sectors' : 'كل القطاعات'}</option>
              {Object.entries(sectorLabels[locale]).map(([value, label]) => (
                <option value={value} selected={query.sector === value}>{label}</option>
              ))}
            </select>
            <select name="category" aria-label={isEn ? 'Category' : 'التصنيف'}>
              <option value="">{isEn ? 'All categories' : 'كل التصنيفات'}</option>
              {Object.entries(categoryLabels[locale]).map(([value, label]) => (
                <option value={value} selected={query.category === value}>{label}</option>
              ))}
            </select>
            <div class="advanced-filters__actions">
              <button class="advanced-filter-submit" type="submit">{isEn ? 'Apply filters' : 'تطبيق الفلاتر'}</button>
              <a class="advanced-filter-reset" href={localePath(locale, '/projects')}>{isEn ? 'Reset' : 'إعادة تعيين'}</a>
            </div>
          </form>
        </details>

        <div class="projects-grid">
          {projects.map((project) => (
            <a href={localePath(locale, `/projects/${project.slug}`)} class="project-card" data-category={project.category}>
              <div class="card-image">
                <img src={project.coverImage} alt={project.title} loading="lazy" />
                <span class="card-badge">{project.category}</span>
              </div>
              <div class="card-content">
                <h2 class="card-title">{project.title}</h2>
                <div class="card-meta">
                  <span class="meta-item">{project.location}</span>
                  <span class="meta-item">{project.year}</span>
                </div>
                {project.summary && <p class="card-summary">{project.summary}</p>}
              </div>
            </a>
          ))}
        </div>
      </>
    ) : !error && <div class="projects-empty">{isEn ? 'No published projects are available yet.' : 'لا توجد مشاريع منشورة حاليًا.'}</div>}
  </div>
</main>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((button) => button.classList.remove('active'));
      btn.classList.add('active');
      const filterValue = btn.getAttribute('data-filter');
      projectCards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category');
        card.style.display = filterValue === 'all' || filterValue === cardCategory ? 'flex' : 'none';
      });
    });
  });
</script>

<style>
  .projects-page {
    background: #040d12;
    min-height: 100vh;
    padding-bottom: 100px;
    color: #fff;
  }
  .page-header {
    padding: clamp(120px, 15vw, 160px) 0 clamp(60px, 8vw, 80px);
    text-align: center;
    background: linear-gradient(180deg, rgba(30,153,211,0.1) 0%, transparent 100%);
  }
  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: var(--tj-font-bold);
    margin-bottom: 24px;
    color: #fff;
  }
  .page-desc {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.8;
  }
  .projects-error,.projects-empty{max-width:760px;margin:0 auto 36px;padding:18px 22px;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.04);color:rgba(255,255,255,.75);text-align:center}
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 48px;
  }
  .filter-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    padding: 10px 24px;
    border-radius: 999px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s ease;
  }
  .filter-btn:hover { background: rgba(255, 255, 255, 0.1); }
  .filter-btn.active { background: var(--tj-primary); color: #fff; border-color: var(--tj-primary); }
  .advanced-filters{margin:-18px auto 42px;max-width:1080px;border:1px solid rgba(255,255,255,.08);border-radius:18px;background:rgba(255,255,255,.025);overflow:hidden}
  .advanced-filters summary{cursor:pointer;list-style:none;padding:14px 18px;color:rgba(255,255,255,.78);font-weight:var(--tj-font-medium);text-align:center}
  .advanced-filters summary::-webkit-details-marker{display:none}
  .advanced-filters__form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:0 18px 18px}
  .advanced-filters__form input,.advanced-filters__form select{width:100%;min-height:46px;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:#0b1e26;color:#fff;padding:0 14px;font:inherit;outline:none}
  .advanced-filters__form input:focus,.advanced-filters__form select:focus{border-color:var(--tj-primary)}
  .advanced-filters__actions{grid-column:1/-1;display:flex;gap:10px;justify-content:center;padding-top:4px}
  .advanced-filter-submit,.advanced-filter-reset{min-height:44px;border-radius:999px;padding:0 22px;font:inherit;font-weight:var(--tj-font-medium);display:inline-flex;align-items:center;justify-content:center;text-decoration:none}
  .advanced-filter-submit{border:0;background:var(--tj-primary);color:#fff;cursor:pointer}
  .advanced-filter-reset{border:1px solid rgba(255,255,255,.14);color:rgba(255,255,255,.78);background:transparent}
  .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 32px; }
  .project-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.4s ease;
  }
  .project-card:hover { transform: translateY(-5px); border-color: rgba(255, 255, 255, 0.1); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); }
  .card-image { position: relative; width: 100%; aspect-ratio: 16/10; overflow: hidden; background:#0b1e26; }
  .card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .project-card:hover .card-image img { transform: scale(1.05); }
  .card-badge { position: absolute; top: 16px; inset-inline-end: 16px; background: var(--tj-primary); color: #fff; font-size: 0.8rem; padding: 4px 12px; border-radius: 999px; font-weight: var(--tj-font-medium); }
  .card-content { padding: 24px; flex: 1; display: flex; flex-direction: column; }
  .card-title { font-size: 1.4rem; color: #fff; margin-bottom: 12px; font-weight: var(--tj-font-bold); }
  .card-meta { display: flex; gap: 16px; margin-bottom: 16px; font-size: 0.9rem; color: rgba(255, 255, 255, 0.5); }
  .card-summary { color: rgba(255, 255, 255, 0.7); font-size: 0.95rem; line-height: 1.6; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  @media(max-width:760px){.advanced-filters__form{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.projects-grid{grid-template-columns:1fr}.filter-btn{padding:9px 17px;font-size:.9rem}.card-meta{flex-wrap:wrap}.advanced-filters__form{grid-template-columns:1fr}.advanced-filters__actions{flex-direction:column}.advanced-filter-submit,.advanced-filter-reset{width:100%}}
</style>
