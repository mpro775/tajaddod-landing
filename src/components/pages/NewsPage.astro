---
import type { ArticleCollection, Locale } from '../../lib/api/types';
import { localePath } from '../../lib/content';
import { articleCategories, type FilterQuery } from '../../lib/filters';
import { dictionary, intlLocale } from '../../i18n';
import { toLegacyArticle } from '../../lib/visual/legacy-view';
import PageHeader from '../layout/PageHeader.astro';
import FilterBar from '../ui/FilterBar.astro';

interface Props {
  locale: Locale;
  collection?: ArticleCollection;
  error?: string;
  query?: FilterQuery;
}

const { locale, collection, error, query = {} } = Astro.props;
const labels = dictionary(locale).news;
const news = (collection?.articles || []).map((article) => toLegacyArticle(article, locale));
const categories = articleCategories(collection);
const dateFormatter = new Intl.DateTimeFormat(intlLocale(locale), { year: 'numeric', month: 'long', day: 'numeric' });
const cleanTabs = Object.fromEntries(Object.entries(query).filter(([key]) => key !== 'type' && key !== 'category'));
const tabCopy = locale === 'en'
  ? { all: 'All', news: 'News', events: 'Events', training: 'Training' }
  : { all: 'الكل', news: 'الأخبار', events: 'الفعاليات', training: 'التدريب' };
const tabs = [
  { label: tabCopy.all, query: cleanTabs, active: !query.type && !query.category },
  { label: tabCopy.news, query: { ...cleanTabs, type: 'news' }, active: query.type === 'news' },
  { label: tabCopy.events, query: { ...cleanTabs, category: 'events' }, active: query.category === 'events' },
  { label: tabCopy.training, query: { ...cleanTabs, category: 'training' }, active: query.category === 'training' },
];
const countLabel = locale === 'en'
  ? `${news.length} result${news.length === 1 ? '' : 's'}`
  : `${news.length} نتيجة`;
const clearLabel = locale === 'en' ? 'Clear all' : 'مسح الكل';
---

<main class="news-index">
  <PageHeader title={labels.pageTitle} description={labels.pageDescription} />
  <section class="news-content section">
    <div class="container">
      <FilterBar locale={locale} action="/news" query={query} searchLabel={labels.search} tabs={tabs} resultsLabel={countLabel} clearLabel={clearLabel} ariaLabel={labels.categoriesLabel}>
        <select name="category" aria-label={locale === 'en' ? 'Category' : 'التصنيف'}>
          <option value="">{locale === 'en' ? 'All categories' : 'كل التصنيفات'}</option>
          {categories.map((category) => <option value={category} selected={query.category === category}>{category}</option>)}
        </select>
        {query.type && <input type="hidden" name="type" value={query.type} />}
      </FilterBar>

      {error ? (
        <div class="page-state" role="alert"><p>{error}</p><a href={localePath(locale, '/news')}>{clearLabel}</a></div>
      ) : news.length === 0 ? (
        <div class="page-state"><p>{labels.empty}</p>{Object.keys(query).length > 0 && <a href={localePath(locale, '/news')}>{clearLabel}</a>}</div>
      ) : (
        <div class="news-grid">
          {news.map((item) => (
            <a href={localePath(locale, `/news/${item.slug}`)} class="news-card">
              <div class="news-card__image"><img src={item.coverImage} alt={item.title} width="1200" height="750" loading="lazy" /><span>{item.category}</span></div>
              <div class="news-card__content">
                <p>{item.date ? dateFormatter.format(new Date(item.date)) : ''}</p>
                <h2>{item.title}</h2>
                {item.excerpt && <span>{item.excerpt}</span>}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</main>

<style>
  .news-index { min-height:100vh; color:var(--tj-text-primary); background:var(--tj-bg-page); }
  .news-content { background:var(--tj-bg-section); }
  .news-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--tj-card-gap); }
  .news-card { display:flex; flex-direction:column; overflow:hidden; color:var(--tj-text-primary); text-decoration:none; border:1px solid var(--tj-border-subtle); border-radius:var(--tj-radius-xl); background:var(--tj-bg-surface); box-shadow:var(--tj-shadow-1); transition:transform var(--tj-transition-smooth),box-shadow var(--tj-transition-smooth),border-color var(--tj-transition-smooth); }
  .news-card:hover { transform:translateY(-6px); border-color:var(--tj-border-strong); box-shadow:var(--tj-shadow-3); }
  .news-card:focus-visible { outline:3px solid var(--tj-focus-ring); outline-offset:4px; }
  .news-card__image { position:relative; aspect-ratio:16/10; overflow:hidden; background:var(--tj-bg-surface-soft); }
  .news-card__image img { width:100%; height:100%; object-fit:cover; transition:transform .5s ease; }.news-card:hover img{transform:scale(1.04)}
  .news-card__image span { position:absolute; inset-block-start:1rem; inset-inline-end:1rem; padding:.35rem .7rem; color:var(--tj-text-on-brand); background:var(--tj-action-primary); border-radius:var(--tj-radius-pill); font-size:var(--tj-type-caption); }
  .news-card__content { display:grid; gap:.75rem; padding:1.5rem; }.news-card__content p{color:var(--tj-text-muted)}.news-card__content h2{color:var(--tj-text-primary);font-size:var(--tj-type-h3)}.news-card__content span{color:var(--tj-text-secondary);line-height:var(--tj-leading-body)}
  .page-state { display:grid; justify-items:center; gap:1rem; max-width:50rem; margin-inline:auto; padding:3rem; text-align:center; color:var(--tj-text-secondary); border:1px solid var(--tj-border-default); border-radius:var(--tj-radius-xl); background:var(--tj-bg-surface); }.page-state a{color:var(--tj-text-accent);font-weight:var(--tj-font-bold)}
  @media(max-width:1100px){.news-grid{grid-template-columns:repeat(2,1fr)}} @media(max-width:700px){.news-grid{grid-template-columns:1fr}}
</style>
