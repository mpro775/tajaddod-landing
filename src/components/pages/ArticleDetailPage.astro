---
import type { ArticleDetail, ArticleSummary, Locale } from '../../lib/api/types';
import { localePath, renderRichContent } from '../../lib/content';
import { toLegacyArticle } from '../../lib/visual/legacy-view';

const { locale, article: sourceArticle, related: sourceRelated = [] } = Astro.props as { locale: Locale; article: ArticleDetail; related?: ArticleSummary[] };
const isEn = locale === 'en';
const item = toLegacyArticle(sourceArticle, locale);
const relatedNews = sourceRelated.slice(0, 2).map((related) => toLegacyArticle(related, locale));
const readingTime = Math.max(1, sourceArticle.readTime || Math.ceil((item.contentSource || '').split(/\s+/).filter(Boolean).length / 200));
const formattedDate = item.date ? new Intl.DateTimeFormat(isEn ? 'en-US' : 'ar-YE', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(item.date)) : '';
const contentHtml = renderRichContent(item.contentSource || '');
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || Astro.url.origin).replace(/\/+$/, '');
const articleUrl = `${siteUrl}${localePath(locale, `/news/${item.slug}`)}`;
const labels = {
  home: isEn ? 'Home' : 'الرئيسية', news: isEn ? 'News' : 'الأخبار', readTime: isEn ? 'min read' : 'دقيقة قراءة',
  gallery: isEn ? 'Image gallery' : 'معرض الصور', share: isEn ? 'Share article' : 'مشاركة الخبر', details: isEn ? 'Article details' : 'تفاصيل الخبر',
  category: isEn ? 'Category' : 'التصنيف', published: isEn ? 'Published' : 'تاريخ النشر', author: isEn ? 'Author' : 'الكاتب', reading: isEn ? 'Reading time' : 'وقت القراءة',
  minute: isEn ? 'min' : 'دقيقة', back: isEn ? 'Back to news' : 'العودة إلى الأخبار', also: isEn ? 'Read also' : 'اقرأ أيضاً', related: isEn ? 'Related news' : 'أخبار ذات صلة',
  more: isEn ? 'Read more' : 'قراءة المزيد', stay: isEn ? 'Stay up to date with Tajaddod' : 'ابقَ على اطلاع بآخر مستجداتنا',
  stayDesc: isEn ? 'Contact us to learn more about our services and upcoming projects.' : 'تواصل معنا لمعرفة المزيد عن خدماتنا ومشاريعنا القادمة', contact: isEn ? 'Contact us' : 'تواصل معنا', all: isEn ? 'All news' : 'جميع الأخبار',
};
---
<main class="news-detail" id="news-detail-page">
    <!-- Cinematic Hero -->
    <section class="nd-hero">
      <div class="nd-hero__bg">
        <img src={item.coverImage} alt={item.title} />
        <div class="nd-hero__overlay"></div>
        <div class="nd-hero__grain"></div>
      </div>
      <!-- Animated energy lines -->
      <div class="nd-hero__lines">
        <span></span>
        <span></span>
      </div>
      <div class="container nd-hero__inner">
        <!-- Breadcrumb -->
        <nav class="nd-breadcrumb" aria-label={isEn ? "Breadcrumb" : "التنقل التفصيلي"}>
          <a href={localePath(locale, "/")} class="nd-breadcrumb__link">{labels.home}</a>
          <svg class="nd-breadcrumb__sep" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          <a href={localePath(locale, "/news")} class="nd-breadcrumb__link">{labels.news}</a>
          <svg class="nd-breadcrumb__sep" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          <span class="nd-breadcrumb__current">{item.title.length > 40 ? item.title.slice(0, 40) + '...' : item.title}</span>
        </nav>

        <div class="nd-hero__meta-row">
          <span class="nd-category-badge">{item.category}</span>
          <span class="nd-reading-time">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            {readingTime} {labels.readTime}
          </span>
        </div>

        <h1 class="nd-hero__title">{item.title}</h1>
        <p class="nd-hero__excerpt">{item.excerpt}</p>

        <div class="nd-hero__info-bar">
          <div class="nd-info-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>{formattedDate}</span>
          </div>
          <div class="nd-info-divider"></div>
          <div class="nd-info-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>{item.author}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Article Body -->
    <section class="nd-body">
      <div class="container">
        <div class="nd-body__layout">
          <!-- Main Content -->
          <article class="nd-article" id="article-content">
            <!-- Decorative accent line -->
            <div class="nd-article__accent"></div>
            
            <div class="nd-article__text">
              <div class="nd-rich-content" set:html={contentHtml}></div>
            </div>

            {item.gallery && item.gallery.length > 0 && (
              <div class="nd-gallery">
                <h3 class="nd-gallery__title">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  {labels.gallery}
                </h3>
                <div class="nd-gallery__grid">
                  {item.gallery.map((img: string) => (
                    <div class="nd-gallery__item">
                      <img src={img} alt={isEn ? "Article image" : "صورة توضيحية للخبر"} loading="lazy" />
                    </div>
                  ))}
                </div>
              </div>
            )}
          </article>

          <!-- Sidebar -->
          <aside class="nd-sidebar">
            <!-- Share Widget -->
            <div class="nd-widget nd-share-widget">
              <h3 class="nd-widget__title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                {labels.share}
              </h3>
              <div class="nd-share-buttons">
                <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(articleUrl)}&text=${encodeURIComponent(item.title)}`} target="_blank" rel="noopener" class="nd-share-btn nd-share-btn--twitter" aria-label={isEn ? "Share on X" : "مشاركة على تويتر"} id="share-twitter">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a href={`https://wa.me/?text=${encodeURIComponent(item.title + ' ' + articleUrl)}`} target="_blank" rel="noopener" class="nd-share-btn nd-share-btn--whatsapp" aria-label={isEn ? "Share on WhatsApp" : "مشاركة على واتساب"} id="share-whatsapp">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </a>
                <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`} target="_blank" rel="noopener" class="nd-share-btn nd-share-btn--facebook" aria-label={isEn ? "Share on Facebook" : "مشاركة على فيسبوك"} id="share-facebook">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
                <button class="nd-share-btn nd-share-btn--copy" id="copy-link-btn" aria-label={isEn ? "Copy link" : "نسخ الرابط"} data-url={articleUrl}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                </button>
              </div>
            </div>

            <!-- Article Info Widget -->
            <div class="nd-widget nd-info-widget">
              <h3 class="nd-widget__title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                {labels.details}
              </h3>
              <ul class="nd-info-list">
                <li class="nd-info-list__item">
                  <span class="nd-info-list__label">{labels.category}</span>
                  <span class="nd-info-list__value">{item.category}</span>
                </li>
                <li class="nd-info-list__item">
                  <span class="nd-info-list__label">{labels.published}</span>
                  <span class="nd-info-list__value">{formattedDate}</span>
                </li>
                <li class="nd-info-list__item">
                  <span class="nd-info-list__label">{labels.author}</span>
                  <span class="nd-info-list__value">{item.author}</span>
                </li>
                <li class="nd-info-list__item">
                  <span class="nd-info-list__label">{labels.reading}</span>
                  <span class="nd-info-list__value">{readingTime} {labels.minute}</span>
                </li>
              </ul>
            </div>

            <!-- Back to News -->
            <a href={localePath(locale, "/news")} class="nd-back-link" id="back-to-news">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              {labels.back}
            </a>
          </aside>
        </div>
      </div>
    </section>

    <!-- Related News -->
    {relatedNews.length > 0 && (
      <section class="nd-related" id="related-news">
        <div class="container">
          <div class="nd-related__header">
            <span class="nd-related__eyebrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              {labels.also}
            </span>
            <h2 class="nd-related__title">{labels.related}</h2>
          </div>
          <div class="nd-related__grid">
            {relatedNews.map((related) => (
              <a href={localePath(locale, `/news/${related.slug}`)} class="nd-related-card" id={`related-${related.slug}`}>
                <div class="nd-related-card__img">
                  <img src={related.coverImage} alt={related.title} loading="lazy" />
                  <div class="nd-related-card__overlay"></div>
                  <span class="nd-related-card__cat">{related.category}</span>
                </div>
                <div class="nd-related-card__body">
                  <span class="nd-related-card__date">{new Intl.DateTimeFormat(isEn ? 'en-US' : 'ar-YE', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(related.date))}</span>
                  <h3 class="nd-related-card__title">{related.title}</h3>
                  <p class="nd-related-card__excerpt">{related.excerpt}</p>
                  <span class="nd-related-card__cta">
                    {labels.more}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA Section -->
    <section class="nd-cta">
      <div class="container">
        <div class="nd-cta__box">
          <div class="nd-cta__glow"></div>
          <div class="nd-cta__content">
            <h2 class="nd-cta__title">{labels.stay}</h2>
            <p class="nd-cta__desc">{labels.stayDesc}</p>
          </div>
          <div class="nd-cta__actions">
            <a href={`${localePath(locale, "/")}#contact`} class="button button-primary" id="cta-contact">{labels.contact}</a>
            <a href={localePath(locale, "/news")} class="button button-ghost nd-cta__ghost" id="cta-all-news">{labels.all}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
<script>
  // Copy link functionality
  const copyBtn = document.getElementById('copy-link-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        copyBtn.classList.add('copied');
        setTimeout(() => copyBtn.classList.remove('copied'), 2000);
      } catch {
        // Fallback
        const input = document.createElement('input');
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
        copyBtn.classList.add('copied');
        setTimeout(() => copyBtn.classList.remove('copied'), 2000);
      }
    });
  }
</script>
<style>
  /* ═══════════════════════════════════════════════════════════════════════
     News Detail Page — Premium Cinematic Design
     ═══════════════════════════════════════════════════════════════════════ */

  .news-detail {
    background: #040d12;
    color: #fff;
    min-height: 100vh;
  }

  /* ─── Hero Section ─────────────────────────────────────────────────── */
  .nd-hero {
    position: relative;
    padding: clamp(130px, 18vw, 200px) 0 clamp(50px, 7vw, 80px);
    overflow: hidden;
  }

  .nd-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .nd-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.7) brightness(0.5);
  }

  .nd-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(4,13,18,0.6) 0%, rgba(4,13,18,0.3) 30%, rgba(4,13,18,0.85) 70%, #040d12 100%),
      radial-gradient(ellipse at 20% 80%, rgba(30,153,211,0.15), transparent 50%),
      radial-gradient(ellipse at 80% 20%, rgba(139,197,67,0.1), transparent 50%);
  }

  .nd-hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
  }

  .nd-hero__lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .nd-hero__lines span {
    position: absolute;
    height: 1px;
    width: 40vw;
    background: linear-gradient(90deg, transparent, rgba(30,153,211,0.5), rgba(139,197,67,0.4), transparent);
    animation: ndLineFlow 8s linear infinite;
    opacity: 0.4;
  }

  .nd-hero__lines span:nth-child(1) { top: 30%; right: -20vw; }
  .nd-hero__lines span:nth-child(2) { top: 65%; left: -20vw; animation-delay: -3s; }

  @keyframes ndLineFlow {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100vw); }
  }

  .nd-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 900px;
  }

  /* Breadcrumb */
  .nd-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font-size: 0.85rem;
  }

  .nd-breadcrumb__link {
    color: rgba(255,255,255,0.55);
    transition: color 200ms ease;
  }

  .nd-breadcrumb__link:hover {
    color: var(--tj-blue-light);
  }

  .nd-breadcrumb__sep {
    color: rgba(255,255,255,0.25);
    flex-shrink: 0;
  }

  .nd-breadcrumb__current {
    color: rgba(255,255,255,0.8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 300px;
  }

  /* Category & Reading Time */
  .nd-hero__meta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .nd-category-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 18px;
    background: var(--tj-gradient-brand);
    color: #fff;
    border-radius: var(--tj-radius-pill);
    font-size: 0.85rem;
    font-weight: var(--tj-font-semibold);
    letter-spacing: -0.01em;
  }

  .nd-reading-time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgba(255,255,255,0.5);
    font-size: 0.85rem;
  }

  .nd-reading-time svg {
    opacity: 0.6;
  }

  /* Title & Excerpt */
  .nd-hero__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: var(--tj-font-bold);
    line-height: 1.3;
    margin-bottom: 18px;
    letter-spacing: var(--tj-tracking-tight);
    max-width: 850px;
  }

  .nd-hero__excerpt {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.8;
    color: rgba(255,255,255,0.6);
    max-width: 700px;
    margin-bottom: 32px;
  }

  /* Info Bar */
  .nd-hero__info-bar {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 18px 24px;
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--tj-radius-xl);
    width: fit-content;
  }

  .nd-info-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(255,255,255,0.75);
    font-size: 0.95rem;
  }

  .nd-info-item svg {
    color: var(--tj-blue);
    flex-shrink: 0;
  }

  .nd-info-divider {
    width: 1px;
    height: 24px;
    background: rgba(255,255,255,0.12);
  }

  /* ─── Article Body ─────────────────────────────────────────────────── */
  .nd-body {
    padding: clamp(48px, 7vw, 80px) 0;
    position: relative;
  }

  .nd-body::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(30,153,211,0.2), rgba(139,197,67,0.15), transparent);
  }

  .nd-body__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  @media (min-width: 960px) {
    .nd-body__layout {
      grid-template-columns: 1fr 320px;
      gap: 56px;
    }
  }

  /* Article */
  .nd-article {
    position: relative;
  }

  .nd-article__accent {
    width: 60px;
    height: 4px;
    border-radius: 4px;
    background: var(--tj-gradient-brand);
    margin-bottom: 32px;
  }

  .nd-article__text {
    font-size: clamp(1.05rem, 1.4vw, 1.18rem);
    line-height: 2;
    color: rgba(255,255,255,0.82);
  }

  .nd-paragraph {
    margin-bottom: 24px;
    position: relative;
  }

  .nd-paragraph:first-child::first-letter {
    float: right;
    font-size: 3.2rem;
    line-height: 1;
    font-weight: var(--tj-font-bold);
    color: var(--tj-blue);
    margin-left: 12px;
    margin-top: 6px;
  }

  /* Gallery */
  .nd-gallery {
    margin-top: 48px;
    padding-top: 40px;
