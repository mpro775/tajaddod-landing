---
import type { Locale, PublicBrand } from '../../lib/api/types';
import { localePath } from '../../lib/content';
import { toVisualBrands } from '../../lib/visual/legacy-view';
import { dictionary } from '../../i18n';
import PageHeader from '../layout/PageHeader.astro';
import BrandLogo from '../ui/BrandLogo.astro';
interface Props { locale: Locale; brands?: PublicBrand[]; error?: string; }
const { locale, brands = [], error } = Astro.props;
const view = toVisualBrands(brands, locale);
const labels = dictionary(locale).catalog;
---
<main class="brands-index">
  <PageHeader eyebrow={labels.brandsEyebrow} title={labels.brandsTitle} description={labels.brandsDescription} />
  <section class="section brand-identity-section">
    <div class="container">
      {error && <p class="catalog-state" role="status">{labels.brandsError}</p>}
      <div class="brand-identity-grid">
        {view.map((brand) => (
          <a class="brand-identity" href={localePath(locale, `/brands/${brand.slug}`)} style={`--identity-accent: ${brand.id === 'liper' ? '#ff8c00' : '#e63946'}`}>
            <div class="brand-identity__logo"><BrandLogo src={brand.logo} slug={brand.id} name={brand.name} /></div>
            <div class="brand-identity__copy">
              <p class="brand-identity__category">{brand.category}</p>
              <h2>{brand.name}</h2>
              <p>{brand.shortDescription}</p>
              <ul class="brand-identity__specialties">{brand.specialties.slice(0, 3).map((specialty) => <li>{specialty}</li>)}</ul>
              <strong class="brand-identity__link">{labels.explore}<span class="directional-icon" aria-hidden="true">←</span></strong>
            </div>
          </a>
        ))}
      </div>
      <div class="brand-identity-help"><h2>{labels.help}</h2><a class="catalog-button" href={`${localePath(locale, '/')}#contact`}>{labels.contactTeam}</a></div>
    </div>
  </section>
</main>
