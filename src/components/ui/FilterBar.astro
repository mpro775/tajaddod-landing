---
import type { Locale } from '../../lib/api/types';
import { localePath } from '../../lib/content';
import { serializeFilterQuery, type FilterQuery } from '../../lib/filters';

interface Tab {
  label: string;
  query: FilterQuery;
  active: boolean;
}

interface Props {
  locale: Locale;
  action: string;
  query: FilterQuery;
  searchLabel: string;
  tabs: Tab[];
  resultsLabel: string;
  clearLabel: string;
  ariaLabel: string;
}

const { locale, action, query, searchLabel, tabs, resultsLabel, clearLabel, ariaLabel } = Astro.props;
const activeEntries = Object.entries(query).filter(([key, value]) => key !== 'page' && value);
const path = localePath(locale, action);
const hrefFor = (next: FilterQuery) => {
  const serialized = serializeFilterQuery(next);
  return serialized ? `${path}?${serialized}` : path;
};
---

<section class="filter-bar" aria-label={ariaLabel} data-filter-bar>
  <nav class="filter-tabs" aria-label={ariaLabel}>
    {tabs.map((tab) => (
      <a class:list={['filter-tab', { 'is-active': tab.active }]} href={hrefFor(tab.query)} aria-current={tab.active ? 'page' : undefined}>
        {tab.label}
      </a>
    ))}
  </nav>

  <form class="filter-form" action={path} method="get">
    <label class="filter-search">
      <span class="sr-only">{searchLabel}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
      <input type="search" name="search" value={query.search || ''} />
    </label>
    <slot />
    <button class="filter-submit" type="submit">{locale === 'en' ? 'Apply filters' : 'تطبيق الفلاتر'}</button>
  </form>

  <div class="filter-summary">
    <strong>{resultsLabel}</strong>
    {activeEntries.length > 0 && (
      <div class="active-filters" aria-label={locale === 'en' ? 'Active filters' : 'الفلاتر النشطة'}>
        {activeEntries.map(([key, value]) => (
          <a class="filter-chip" href={hrefFor(Object.fromEntries(Object.entries(query).filter(([entryKey]) => entryKey !== key)))}>
            <span>{value}</span><span aria-hidden="true">×</span>
          </a>
        ))}
        <a class="filter-clear" href={path}>{clearLabel}</a>
      </div>
    )}
  </div>
</section>

<style>
  .filter-bar { 
    display: flex; 
    flex-direction: column; 
    gap: 1.5rem; 
    margin-block: 0 3rem; 
    padding: 1.75rem; 
    border: 1px solid var(--tj-border-subtle); 
    border-radius: var(--tj-radius-xl); 
    background: var(--tj-bg-surface); 
    box-shadow: var(--tj-shadow-2, 0 4px 20px rgba(0, 0, 0, 0.05)); 
  }
  
  .filter-tabs { 
    display: flex; 
    flex-wrap: wrap; 
    gap: 0.5rem; 
    padding: 0.5rem; 
    border-radius: var(--tj-radius-pill); 
    background: var(--tj-bg-surface-soft); 
    width: fit-content; 
    max-width: 100%; 
  }
  
  /* Make tabs horizontally scrollable on small screens to save space and look native */
  @media (max-width: 768px) {
    .filter-tabs { 
      flex-wrap: nowrap; 
      overflow-x: auto; 
      width: 100%;
      -webkit-overflow-scrolling: touch; 
      scrollbar-width: none; /* Firefox */
      padding-bottom: 0.5rem;
    }
    .filter-tabs::-webkit-scrollbar { display: none; /* Chrome/Safari */ }
  }

  .filter-tab { 
    display: inline-flex; 
    min-height: 2.75rem; 
    align-items: center; 
    padding-inline: 1.25rem; 
    border: 1px solid transparent; 
    border-radius: var(--tj-radius-pill); 
    color: var(--tj-text-secondary); 
    text-decoration: none; 
    font-weight: var(--tj-font-semibold); 
    white-space: nowrap;
    transition: all var(--tj-transition-smooth);
  }
  
  .filter-tab:hover { 
    color: var(--tj-text-primary); 
    background: var(--tj-action-soft); 
  }
  
  .filter-tab.is-active { 
    color: var(--tj-text-on-brand); 
    background: var(--tj-action-primary); 
    box-shadow: var(--tj-shadow-1); 
  }

  /* Filter form layout - Single Line Slider */
  .filter-form { 
    display: flex; 
    flex-wrap: nowrap; 
    gap: 1rem; 
    align-items: center; 
    overflow-x: auto;
    width: 100%;
    padding-bottom: 0.5rem; /* Space for the invisible scrollbar */
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }
  
  .filter-form::-webkit-scrollbar { 
    display: none; /* Chrome/Safari */ 
  }
  
  .filter-search { 
    position: relative; 
    display: flex; 
    align-items: center; 
    flex: 0 0 auto;
    width: 160px; 
  }
  
  .filter-search svg { 
    position: absolute; 
    inset-inline-start: 1rem; 
    width: 1.25rem; 
    fill: none; 
    stroke: var(--tj-text-muted); 
    stroke-width: 2; 
    pointer-events: none; 
  }
  
  .filter-form :global(input), .filter-form :global(select) { 
    flex: 0 0 auto; 
    width: 160px;
    min-height: 3.25rem; 
    padding-inline: 1rem; 
    color: var(--tj-text-primary); 
    background: var(--tj-bg-surface-soft); 
    border: 1px solid var(--tj-border-default); 
    border-radius: var(--tj-radius-md); 
    font: inherit; 
    transition: border-color var(--tj-transition-smooth), box-shadow var(--tj-transition-smooth);
  }
  
  .filter-search input { 
    width: 100% !important;
    padding-inline-start: 3rem !important; 
  }
  
  .filter-form :global(input:focus), .filter-form :global(select:focus) { 
    border-color: var(--tj-action-primary); 
    outline: none; 
    box-shadow: 0 0 0 3px var(--tj-focus-ring); 
  }

  .filter-submit { 
    flex: 0 0 auto; 
    min-height: 3.25rem; 
    padding-inline: 1.75rem; 
    border: 0; 
    border-radius: var(--tj-radius-md); 
    color: var(--tj-text-on-brand); 
    background: var(--tj-action-primary); 
    font: inherit; 
    font-weight: var(--tj-font-bold); 
    cursor: pointer; 
    transition: transform 0.2s ease, opacity 0.2s ease;
    white-space: nowrap;
  }
  
  .filter-submit:hover { 
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .filter-summary { 
    display: flex; 
    flex-wrap: wrap; 
    align-items: center; 
    justify-content: space-between; 
    gap: 1.25rem; 
    color: var(--tj-text-secondary); 
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--tj-border-subtle);
  }
  
  .active-filters { 
    display: flex; 
    flex-wrap: wrap; 
    gap: 0.5rem; 
    align-items: center; 
  }
  
  .filter-chip, .filter-clear { 
    display: inline-flex; 
    align-items: center; 
    gap: 0.5rem; 
    min-height: 2.25rem; 
    padding-inline: 1rem; 
    border-radius: var(--tj-radius-pill); 
    text-decoration: none; 
    font-size: var(--tj-type-caption); 
    transition: all var(--tj-transition-smooth);
  }
  
  .filter-chip { 
    color: var(--tj-text-primary); 
    background: var(--tj-bg-surface-soft); 
    border: 1px solid var(--tj-border-default); 
  }
  
  .filter-chip:hover { 
    background: var(--tj-action-soft); 
    border-color: var(--tj-border-strong);
  }

  .filter-clear { 
    color: var(--tj-text-accent); 
    font-weight: var(--tj-font-bold); 
    background: transparent;
  }
  
  .filter-clear:hover { 
    text-decoration: underline; 
  }

  :is(.filter-tab, .filter-chip, .filter-clear, .filter-submit, .filter-form input, .filter-form select):focus-visible { 
    outline: 3px solid var(--tj-focus-ring); 
    outline-offset: 2px; 
  }

  /* Mobile & Tablet Optimizations */
  @media (max-width: 600px) {
    .filter-bar { 
      padding: 1.25rem; 
      gap: 1.25rem;
      border-radius: var(--tj-radius-lg); 
    }
    .filter-summary { 
      flex-direction: column; 
      align-items: flex-start; 
    }
    .filter-search { 
      width: 140px; 
    }
    .filter-form :global(input), .filter-form :global(select) {
      width: 140px;
    }
  }
</style>
