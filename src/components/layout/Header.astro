---
import type { Locale } from '../../lib/api/types';
import { alternatePath, localePath } from '../../lib/content';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const isEn = locale === 'en';
const home = localePath(locale, '/');
const navigation = [
  { label: isEn ? 'About' : 'من نحن', href: `${home}#about` },
  { label: isEn ? 'Brands' : 'العلامات', href: `${home}#brands` },
  { label: isEn ? 'Projects' : 'المشاريع', href: localePath(locale, '/projects') },
  { label: isEn ? 'Achievements' : 'الإنجازات', href: `${home}#achievements` },
  { label: isEn ? 'News' : 'الأخبار', href: localePath(locale, '/news') },
  { label: isEn ? 'Contact' : 'تواصل معنا', href: `${home}#contact` },
];
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand-lockup" href={home} aria-label={isEn ? 'Tajaddod - Home' : 'تجدد - العودة للرئيسية'}>
      <img src="/logos/tajaddod-logo.svg" alt={isEn ? 'Tajaddod logo' : 'شعار تجدد'} width="164" height="58" />
    </a>
    <nav class="desktop-nav" aria-label={isEn ? 'Main navigation' : 'التنقل الرئيسي'}>
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-language" href={alternatePath(pathname, locale)} hreflang={isEn ? 'ar' : 'en'}>
      {isEn ? 'العربية' : 'EN'}
    </a>
    <a class="header-cta" href={`${home}#contact`}>{isEn ? 'Business inquiry' : 'تواصل تجاري'}</a>
    <button class="menu-toggle" type="button" aria-label={isEn ? 'Open menu' : 'فتح القائمة'} aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>
  </div>
  <button class="mobile-nav-backdrop" type="button" aria-label={isEn ? 'Close menu' : 'إغلاق القائمة'} data-mobile-nav-backdrop></button>
  <nav class="mobile-nav" id="mobile-nav" aria-label={isEn ? 'Mobile navigation' : 'قائمة الجوال'} data-mobile-nav>
    <div class="mobile-nav__head">
      <img src="/logos/tajaddod-logo-white.svg" alt={isEn ? 'Tajaddod logo' : 'شعار تجدد'} width="142" height="52" loading="lazy" />
      <span>{isEn ? 'Energy & electricity ecosystem' : 'منظومة الكهرباء والطاقة'}</span>
    </div>

    <div class="mobile-nav__links">
      {navigation.map((item, index) => (
        <a href={item.href} data-mobile-nav-link>
          <span class="mobile-nav__index">{String(index + 1).padStart(2, '0')}</span>
          <span class="mobile-nav__label">{item.label}</span>
        </a>
      ))}
      <a href={alternatePath(pathname, locale)} hreflang={isEn ? 'ar' : 'en'} data-mobile-nav-link>
        <span class="mobile-nav__index">{String(navigation.length + 1).padStart(2, '0')}</span>
        <span class="mobile-nav__label">{isEn ? 'العربية' : 'English'}</span>
      </a>
    </div>

    <a class="mobile-nav__cta" href={`${home}#contact`} data-mobile-nav-link>{isEn ? 'Business inquiry' : 'تواصل تجاري'}</a>
  </nav>
</header>

<style>
  .header-language {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 34px;
    padding: 0 10px;
    border: 1px solid rgba(255,255,255,.22);
    border-radius: 999px;
    color: rgba(255,255,255,.9);
    font-size: .78rem;
    font-weight: var(--tj-font-semibold);
    backdrop-filter: blur(10px);
    transition: border-color 180ms ease, background 180ms ease, color 180ms ease;
  }
  .header-language:hover { border-color: rgba(155,232,255,.55); background: rgba(255,255,255,.08); color: #fff; }
  @media (max-width: 820px) {
    .header-language { justify-self: end; margin-inline-start: auto; }
  }
</style>
