---
import type { Locale } from '../../lib/api/types';
import { alternatePath, localePath } from '../../lib/content';
import { dictionary } from '../../i18n';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const copy = dictionary(locale);
const navigation = [
  { label: copy.nav.home, href: localePath(locale, '/') },
  { label: copy.nav.projects, href: localePath(locale, '/projects') },
  { label: copy.nav.news, href: localePath(locale, '/news') },
  { label: copy.nav.brands, href: `${localePath(locale, '/')}#brands` },
];
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand-lockup" href={localePath(locale, '/')} aria-label={copy.brand}>
      <img src="/logos/tajaddod-logo.svg" alt={copy.brand} width="164" height="58" />
    </a>
    <nav class="desktop-nav" aria-label={copy.nav.home}>
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="language-link" href={alternatePath(pathname, locale)} hreflang={locale === 'ar' ? 'en' : 'ar'}>
        {copy.common.language}
      </a>
      <a class="header-cta" href={`${localePath(locale, '/')}#contact`}>{copy.nav.contact}</a>
      <button class="menu-toggle" type="button" aria-label={copy.nav.home} aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <button class="mobile-nav-backdrop" type="button" aria-label="Close" data-mobile-nav-backdrop></button>
  <nav class="mobile-nav" id="mobile-nav" aria-label={copy.nav.home} data-mobile-nav>
    {navigation.map((item) => <a href={item.href} data-mobile-nav-link>{item.label}</a>)}
    <a href={alternatePath(pathname, locale)} data-mobile-nav-link>{copy.common.language}</a>
    <a class="mobile-nav__cta" href={`${localePath(locale, '/')}#contact`} data-mobile-nav-link>{copy.nav.contact}</a>
  </nav>
</header>

<style>
  .site-header{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.92);backdrop-filter:blur(18px);border-bottom:1px solid rgba(5,50,62,.08)}
  .header-inner{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:28px}
  .brand-lockup img{display:block;width:148px;height:auto}
  .desktop-nav,.header-actions{display:flex;align-items:center;gap:22px}
  .desktop-nav a,.language-link{color:#12313a;text-decoration:none;font-weight:700;font-size:.94rem}
  .desktop-nav a:hover,.language-link:hover{color:var(--tj-blue)}
  .header-cta,.mobile-nav__cta{padding:12px 20px;border-radius:999px;color:#fff;text-decoration:none;font-weight:800;background:linear-gradient(135deg,var(--tj-blue),var(--tj-green))}
  .menu-toggle{display:none;width:42px;height:42px;border:0;background:transparent}
  .menu-toggle span{display:block;width:24px;height:2px;background:#12313a;margin:5px auto}
  .mobile-nav,.mobile-nav-backdrop{display:none}
  @media(max-width:860px){
    .desktop-nav,.header-cta{display:none}.menu-toggle{display:block}.header-actions{gap:12px}.language-link{font-size:.84rem}
    .mobile-nav-backdrop{position:fixed;inset:78px 0 0;border:0;background:rgba(3,14,20,.54);z-index:98}
    .mobile-nav{position:fixed;z-index:99;top:78px;inset-inline:0;background:#fff;padding:24px;box-shadow:0 24px 60px rgba(5,28,37,.18);flex-direction:column;gap:8px}
    .mobile-nav a{display:block;padding:14px;border-radius:12px;text-decoration:none;color:#12313a;font-weight:800}
    .mobile-nav.is-open{display:flex}.mobile-nav-backdrop.is-open{display:block}
  }
</style>

<script>
  const toggle = document.querySelector<HTMLElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const backdrop = document.querySelector<HTMLElement>('[data-mobile-nav-backdrop]');
  const close = () => {
    nav?.classList.remove('is-open');
    backdrop?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
  };
  toggle?.addEventListener('click', () => {
    const open = !nav?.classList.contains('is-open');
    nav?.classList.toggle('is-open', open);
    backdrop?.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  });
  backdrop?.addEventListener('click', close);
  document.querySelectorAll('[data-mobile-nav-link]').forEach((link) => link.addEventListener('click', close));
</script>
