---
import { siteCopy } from '../../data/site-copy';
import { site, contactLinks } from '../../data/site';

const { navigation, brands, brand } = siteCopy;
---

<footer class="site-footer">
  <div class="footer-bg" aria-hidden="true">
    <div class="footer-bg__grid"></div>
    <div class="footer-bg__glow"></div>
  </div>

  <div class="container footer-container">
    <div class="footer-top">
      
      <!-- Brand Column -->
      <div class="footer-col footer-col--brand footer-accordion-item" data-footer-accordion-item>
        <button class="footer-accordion-trigger" type="button" aria-expanded="false" data-footer-accordion-trigger>
          <span>عن تجدد</span>
          <span class="footer-accordion-trigger__icon" aria-hidden="true"></span>
        </button>
        <div class="footer-panel" data-footer-panel>
          <a href="#hero" class="footer-logo">
            <img src="/logos/tajaddod-logo-white.svg" alt="شعار تجدد" width="160" height="58" loading="lazy" />
          </a>
          <p class="footer-desc">
            {brand.centralMessage}
          </p>
          <span class="footer-disclaimer">
            هذه الصفحة مخصصة لتعريف التجار والمقاولين بالوكالات، وليست متجراً إلكترونياً.
          </span>
        </div>
      </div>

      <!-- Navigation Column -->
      <div class="footer-col footer-accordion-item" data-footer-accordion-item>
        <button class="footer-accordion-trigger" type="button" aria-expanded="false" data-footer-accordion-trigger>
          <span>خريطة الموقع</span>
          <span class="footer-accordion-trigger__icon" aria-hidden="true"></span>
        </button>
        <h3 class="footer-title">خريطة الموقع</h3>
        <div class="footer-panel" data-footer-panel>
          <nav class="footer-nav" aria-label="روابط الفوتر">
            {navigation.map((item) => (
              <a href={item.href} class="footer-link">
                <span class="footer-link__icon">›</span>
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>

      <!-- Brands Column -->
      <div class="footer-col footer-accordion-item" data-footer-accordion-item>
        <button class="footer-accordion-trigger" type="button" aria-expanded="false" data-footer-accordion-trigger>
          <span>علاماتنا</span>
          <span class="footer-accordion-trigger__icon" aria-hidden="true"></span>
        </button>
        <h3 class="footer-title">علاماتنا</h3>
        <div class="footer-panel" data-footer-panel>
          <ul class="footer-list">
            {brands.map((b) => (
              <li class="footer-list__item">
                <strong>{b.displayName}</strong>
                <span>{b.roleTitle}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Contact Column -->
      <div class="footer-col footer-accordion-item is-open" data-footer-accordion-item>
        <button class="footer-accordion-trigger" type="button" aria-expanded="true" data-footer-accordion-trigger>
          <span>تواصل معنا</span>
          <span class="footer-accordion-trigger__icon" aria-hidden="true"></span>
        </button>
        <h3 class="footer-title">تواصل معنا</h3>
        <div class="footer-panel" data-footer-panel>
          <ul class="footer-contact">
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <a href={contactLinks.email} class="footer-link" dir="ltr">{site.email}</a>
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <a href={contactLinks.whatsapp} class="footer-link" dir="ltr">{(site as any).whatsappDisplay || site.whatsapp}</a>
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>{site.location}</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom__inner">
      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} تجدد للطاقة والكهرباء. جميع الحقوق محفوظة.
      </p>
      <a href="#top" class="footer-back-top" aria-label="العودة للأعلى">
        <span>العودة للأعلى</span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
      </a>
    </div>
  </div>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('[data-footer-accordion-item]');

    items.forEach((item) => {
      const trigger = item.querySelector('[data-footer-accordion-trigger]');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const isOpen = item.classList.toggle('is-open');
        trigger.setAttribute('aria-expanded', String(isOpen));
      });
    });
  });
</script>

<style>
/* ────────────────────────────────────────────────────────────────────────
   Footer Section
   ──────────────────────────────────────────────────────────────────────── */

.site-footer {
  position: relative;
  background: #020609;
  color: #fff;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  overflow: hidden;
}

/* Background Effects */
.footer-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.footer-bg__grid {
  position: absolute;
  inset: 0;
  opacity: 0.02;
  background-image:
    linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
  background-size: 32px 32px;
}

.footer-bg__glow {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 800px;
  height: 200px;
  background: var(--tj-blue);
  filter: blur(150px);
  opacity: 0.1;
  border-radius: 50%;
}

.footer-container {
  position: relative;
  z-index: 1;
  padding: 80px 0 60px;
}

/* Top Grid Layout */
.footer-top {
  display: grid;
  grid-template-columns: 1fr;
  gap: 60px;
}

@media (min-width: 640px) {
  .footer-top {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .footer-top {
    grid-template-columns: 2fr 1fr 1.5fr 1.5fr;
    gap: 40px;
  }
}

/* Columns */
.footer-col {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.footer-accordion-trigger {
  display: none;
}

.footer-panel {
  display: contents;
}

.footer-col--brand {
  padding-inline-end: 20px;
}

.footer-logo {
  display: inline-block;
  margin-bottom: 8px;
  transition: opacity 0.3s ease;
}

.footer-logo:hover {
  opacity: 0.8;
}

.footer-desc {
  font-size: var(--tj-text-body);
  color: rgba(255,255,255,0.6);
  line-height: 1.7;
}

.footer-disclaimer {
  display: inline-block;
  font-size: var(--tj-text-micro);
  color: var(--tj-blue-light);
  background: rgba(30, 153, 211, 0.1);
  border: 1px solid rgba(30, 153, 211, 0.2);
  padding: 8px 12px;
  border-radius: 8px;
  margin-top: auto;
}

.footer-title {
  font-size: var(--tj-text-body-lg);
  font-weight: var(--tj-font-bold);
  color: #fff;
  margin-bottom: 8px;
  position: relative;
}

/* Navigation Links */
.footer-nav {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.footer-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: rgba(255,255,255,0.6);
  text-decoration: none;
  font-size: var(--tj-text-body);
  transition: all 0.3s ease;
}

.footer-link__icon {
  font-size: 1.2rem;
  color: var(--tj-blue);
  transform: translateX(4px);
  opacity: 0;
  transition: all 0.3s ease;
}

.footer-link:hover {
  color: #fff;
  transform: translateX(-4px);
}

.footer-link:hover .footer-link__icon {
  opacity: 1;
  transform: translateX(0);
}

/* Brands List */
.footer-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-list__item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.footer-list__item strong {
  color: #fff;
  font-size: var(--tj-text-body);
}

.footer-list__item span {
  color: rgba(255,255,255,0.5);
  font-size: var(--tj-text-nano);
}

/* Contact Info */
.footer-contact {
  display: flex;
  flex-direction: column;
  gap: 20px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-contact li {
  display: flex;
  align-items: center;
  gap: 12px;
  color: rgba(255,255,255,0.6);
  font-size: var(--tj-text-body);
}

.footer-contact svg {
  color: var(--tj-green);
  flex-shrink: 0;
}

/* Bottom Bar */
.footer-bottom {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.02);
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  padding: 24px 0;
}

.footer-bottom__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

@media (min-width: 768px) {
  .footer-bottom__inner {
    flex-direction: row;
  }
}

.footer-copyright {
  color: rgba(255,255,255,0.4);
  font-size: var(--tj-text-small);
}

.footer-back-top {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: rgba(255,255,255,0.7);
  text-decoration: none;
  font-size: var(--tj-text-small);
  font-weight: var(--tj-font-semibold);
  transition: color 0.3s ease;
}

.footer-back-top svg {
  background: rgba(255,255,255,0.05);
  border-radius: 50%;
  padding: 4px;
  width: 32px;
  height: 32px;
  border: 1px solid rgba(255,255,255,0.1);
  transition: all 0.3s ease;
}

.footer-back-top:hover {
  color: #fff;
}

.footer-back-top:hover svg {
  background: var(--tj-blue);
  border-color: var(--tj-blue);
  transform: translateY(-4px);
  color: #fff;
}

@media (max-width: 820px) {
  .footer-container {
    padding: 48px 0 34px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .footer-col {
    gap: 0;
  }

  .footer-col--brand {
    padding-inline-end: 0;
  }

  .footer-title {
    display: none;
  }

  .footer-accordion-item {
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 20px;
    background: rgba(255,255,255,.025);
    overflow: hidden;
  }

  .footer-accordion-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 54px;
    padding: 14px 16px;
    border: 0;
    color: #fff;
    background: transparent;
    text-align: start;
    font-size: .98rem;
    font-weight: var(--tj-font-bold);
  }

  .footer-accordion-trigger__icon {
    position: relative;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .footer-accordion-trigger__icon::before,
  .footer-accordion-trigger__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--tj-blue-light);
    transform: translate(-50%, -50%);
    transition: transform .2s ease;
  }

  .footer-accordion-trigger__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .footer-accordion-item.is-open .footer-accordion-trigger__icon::after {
    transform: translate(-50%, -50%) rotate(0);
  }

  .footer-panel {
    display: block;
    max-height: 0;
    overflow: hidden;
    padding: 0 16px;
    transition: max-height .26s ease, padding-bottom .26s ease;
  }

  .footer-accordion-item.is-open .footer-panel {
    max-height: 560px;
    padding-bottom: 18px;
  }

  .footer-logo {
    margin-bottom: 12px;
  }

  .footer-logo img {
    width: 132px;
  }

  .footer-desc {
    font-size: .9rem;
    line-height: 1.75;
  }

  .footer-disclaimer {
    margin-top: 14px;
    font-size: .72rem;
  }

  .footer-nav,
  .footer-list,
  .footer-contact {
    gap: 12px;
  }

  .footer-link {
    min-height: 34px;
  }

  .footer-contact li {
    align-items: flex-start;
    font-size: .9rem;
  }

  .footer-bottom {
    padding-bottom: calc(24px + env(safe-area-inset-bottom));
  }
}
</style>
