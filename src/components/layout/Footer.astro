---
import type { Locale } from '../../lib/api/types';
import { localePath } from '../../lib/content';
import { site, contactLinks as buildContactLinks } from '../../data/site';
import { dictionary } from '../../i18n';
import Icon from '../ui/Icon.astro';

const { locale } = Astro.props as { locale: Locale };
const copy = dictionary(locale);
const footer = copy.footer;
const home = localePath(locale, '/');
const navigation = [
  { label: copy.nav.about, href: `${home}#about` },
  { label: copy.nav.brands, href: `${home}#brands` },
  { label: copy.nav.projects, href: localePath(locale, '/projects') },
  { label: copy.nav.achievements, href: `${home}#achievements` },
  { label: copy.nav.news, href: localePath(locale, '/news') },
  { label: copy.nav.contact, href: `${home}#contact` },
];
const contactLinks = buildContactLinks({
  whatsapp: copy.home.contact.whatsappMessage,
  emailSubject: copy.home.contact.emailSubject,
});
---

<footer class="site-footer theme-inverse" id="contact">
  <div class="footer-bg" aria-hidden="true">
    <div class="footer-bg__grid"></div>
    <div class="footer-bg__glow"></div>
  </div>

  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-col footer-col--brand footer-accordion-item is-open" data-footer-accordion-item>
        <button class="footer-accordion-trigger" type="button" aria-expanded="true" data-footer-accordion-trigger>
          <span>{footer.aboutTitle}</span>
          <span class="footer-accordion-trigger__icon" aria-hidden="true"></span>
        </button>
        <div class="footer-panel" data-footer-panel>
          <a href={`${home}#hero`} class="footer-logo">
            <img src="/logos/tajaddod-logo-white.svg" alt={footer.logoAlt} width="160" height="58" loading="lazy" />
          </a>
          <p class="footer-desc">{footer.about}</p>
          <span class="footer-disclaimer">{footer.note}</span>
        </div>
      </div>

      <div class="footer-col footer-accordion-item" data-footer-accordion-item>
        <button class="footer-accordion-trigger" type="button" aria-expanded="false" data-footer-accordion-trigger>
          <span>{footer.sitemap}</span>
          <span class="footer-accordion-trigger__icon" aria-hidden="true"></span>
        </button>
        <h3 class="footer-title">{footer.sitemap}</h3>
        <div class="footer-panel" data-footer-panel>
          <nav class="footer-nav" aria-label={footer.sitemapLabel}>
            {navigation.map((item) => (
              <a href={item.href} class="footer-link">
                <Icon name="arrow" class="footer-link__icon" />
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>

      <div class="footer-col footer-accordion-item" data-footer-accordion-item>
        <button class="footer-accordion-trigger" type="button" aria-expanded="false" data-footer-accordion-trigger>
          <span>{footer.brandsProjects}</span>
          <span class="footer-accordion-trigger__icon" aria-hidden="true"></span>
        </button>
        <h3 class="footer-title">{footer.brandsProjects}</h3>
        <div class="footer-panel" data-footer-panel>
          <div class="footer-links-group">
            <h4 class="footer-subtitle">{footer.brands}</h4>
            <nav class="footer-nav">
              <a href={localePath(locale, '/brands/cnc')} class="footer-link"><Icon name="arrow" class="footer-link__icon" /> CNC</a>
              <a href={localePath(locale, '/brands/liper')} class="footer-link"><Icon name="arrow" class="footer-link__icon" /> Liper</a>
            </nav>
          </div>
          <div class="footer-links-group" style="margin-top: 20px;">
            <h4 class="footer-subtitle">{footer.projects}</h4>
            <nav class="footer-nav">
              <a href={localePath(locale, '/projects')} class="footer-link"><Icon name="arrow" class="footer-link__icon" /> {footer.allProjects}</a>
              <a href={`${localePath(locale, '/projects')}?category=solar_pv`} class="footer-link"><Icon name="arrow" class="footer-link__icon" /> {footer.solarProjects}</a>
              <a href={`${localePath(locale, '/projects')}?category=solar_street_lighting`} class="footer-link"><Icon name="arrow" class="footer-link__icon" /> {footer.lightingProjects}</a>
            </nav>
          </div>
        </div>
      </div>

      <div class="footer-col footer-accordion-item" data-footer-accordion-item>
        <button class="footer-accordion-trigger" type="button" aria-expanded="false" data-footer-accordion-trigger>
          <span>{footer.news}</span>
          <span class="footer-accordion-trigger__icon" aria-hidden="true"></span>
        </button>
        <h3 class="footer-title">{footer.news}</h3>
        <div class="footer-panel" data-footer-panel>
          <nav class="footer-nav">
            <a href={localePath(locale, '/news')} class="footer-link"><Icon name="arrow" class="footer-link__icon" /> {footer.companyNews}</a>
            <a href={localePath(locale, '/news')} class="footer-link"><Icon name="arrow" class="footer-link__icon" /> {footer.events}</a>
            <a href={localePath(locale, '/news')} class="footer-link"><Icon name="arrow" class="footer-link__icon" /> {footer.training}</a>
          </nav>
        </div>
      </div>

      <div class="footer-col footer-accordion-item" data-footer-accordion-item>
        <button class="footer-accordion-trigger" type="button" aria-expanded="false" data-footer-accordion-trigger>
          <span>{footer.contact}</span>
          <span class="footer-accordion-trigger__icon" aria-hidden="true"></span>
        </button>
        <h3 class="footer-title">{footer.contact}</h3>
        <div class="footer-panel" data-footer-panel>
          <ul class="footer-contact">
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <a href={contactLinks.email} class="footer-link" dir="ltr">{site.email}</a>
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <a href={contactLinks.whatsapp} class="footer-link" dir="ltr">{site.whatsappDisplay}</a>
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span>{footer.location}</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom__inner">
      <p class="footer-copyright">&copy; {new Date().getFullYear()} {footer.copyright}</p>
      <a href={`${home}#hero`} class="footer-back-top" aria-label={footer.backTop}>
        <span>{footer.backTop}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
      </a>
    </div>
  </div>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('[data-footer-accordion-item]');
    items.forEach((item) => {
      const trigger = item.querySelector('[data-footer-accordion-trigger]');
      if (!trigger) return;
      trigger.addEventListener('click', () => {
        const isOpen = !item.classList.contains('is-open');
        if (window.matchMedia('(max-width: 767px)').matches) {
          items.forEach((candidate) => {
            candidate.classList.remove('is-open');
            candidate.querySelector('[data-footer-accordion-trigger]')?.setAttribute('aria-expanded', 'false');
          });
        }
        item.classList.toggle('is-open', isOpen);
        trigger.setAttribute('aria-expanded', String(isOpen));
      });
    });
  });
</script>

<style>
/* ────────────────────────────────────────────────────────────────────────
   Footer Section
   ──────────────────────────────────────────────────────────────────────── */

.site-footer {
  position: relative;
  background: var(--tj-footer-surface);
  color: var(--tj-text-inverse);
  border-top: 1px solid var(--tj-inverse-alpha-05);
  overflow: hidden;
}

/* Background Effects */
.footer-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.footer-bg__grid {
  position: absolute;
  inset: 0;
  opacity: 0.02;
  background-image:
    linear-gradient(var(--tj-inverse-alpha-08) 1px, transparent 1px),
    linear-gradient(90deg, var(--tj-inverse-alpha-08) 1px, transparent 1px);
  background-size: 32px 32px;
}

.footer-bg__glow {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 800px;
  height: 200px;
  background: var(--tj-blue);
  filter: blur(150px);
  opacity: 0.1;
  border-radius: 50%;
}

.footer-container {
  position: relative;
  z-index: 1;
  padding: 80px 0 60px;
}

/* Top Grid Layout */
.footer-top {
  display: grid;
  grid-template-columns: 1fr;
  gap: 60px;
}

@media (min-width: 640px) {
  .footer-top {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .footer-top {
    grid-template-columns: 2fr 1fr 1.2fr 1fr 1.5fr;
    gap: 30px;
  }
}

/* Columns */
.footer-col {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.footer-accordion-trigger {
  display: none;
}

.footer-panel {
  display: contents;
}

.footer-col--brand {
  padding-inline-end: 20px;
}

.footer-logo {
  display: inline-block;
  margin-bottom: 8px;
  transition: opacity 0.3s ease;
}

.footer-logo:hover {
  opacity: 0.8;
}

.footer-desc {
  font-size: var(--tj-text-body);
  color: var(--tj-inverse-alpha-60);
  line-height: 1.7;
}

.footer-disclaimer {
  display: inline-block;
  font-size: var(--tj-text-micro);
  color: var(--tj-blue-light);
  background: var(--tj-blue-surface);
  border: 1px solid rgba(var(--tj-blue-rgb), 0.2);
  padding: 8px 12px;
  border-radius: 8px;
  margin-top: auto;
}

.footer-title {
  font-size: var(--tj-text-body-lg);
  font-weight: var(--tj-font-bold);
  color: var(--tj-text-inverse);
  margin-bottom: 16px;
  position: relative;
}

.footer-subtitle {
  font-size: 0.9rem;
  color: var(--tj-inverse-alpha-40);
  margin-bottom: 12px;
  font-weight: var(--tj-font-semibold);
}

/* Navigation Links */
.footer-nav {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.footer-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--tj-inverse-alpha-60);
  text-decoration: none;
  font-size: var(--tj-text-body);
  transition: color var(--tj-transition-smooth), transform var(--tj-transition-smooth);
}

.footer-link__icon {
  font-size: 1.2rem;
  color: var(--tj-blue);
  transform: translateX(calc(var(--tj-inline-direction) * -4px)) scaleX(calc(var(--tj-inline-direction) * -1));
  opacity: 0;
  transition: opacity var(--tj-transition-smooth), transform var(--tj-transition-smooth);
}

.footer-link:hover {
  color: var(--tj-text-inverse);
  transform: translateX(calc(var(--tj-inline-direction) * 4px));
}

.footer-link:hover .footer-link__icon {
  opacity: 1;
  transform: translateX(0) scaleX(calc(var(--tj-inline-direction) * -1));
}

/* Brands List */
.footer-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-list__item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.footer-list__item strong {
  color: var(--tj-text-inverse);
  font-size: var(--tj-text-body);
}

.footer-list__item span {
  color: var(--tj-inverse-alpha-50);
  font-size: var(--tj-text-nano);
}

/* Contact Info */
.footer-contact {
  display: flex;
  flex-direction: column;
  gap: 20px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-contact li {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--tj-inverse-alpha-60);
  font-size: var(--tj-text-body);
}

.footer-contact svg {
  color: var(--tj-green);
  flex-shrink: 0;
}

/* Bottom Bar */
.footer-bottom {
  position: relative;
  z-index: 1;
  background: var(--tj-inverse-alpha-02);
  border-top: 1px solid var(--tj-inverse-alpha-05);
  padding: 24px 0;
}

.footer-bottom__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

@media (min-width: 768px) {
  .footer-bottom__inner {
    flex-direction: row;
  }
}

.footer-copyright {
  color: var(--tj-inverse-alpha-40);
  font-size: var(--tj-text-small);
}

.footer-back-top {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--tj-inverse-alpha-70);
  text-decoration: none;
  font-size: var(--tj-text-small);
  font-weight: var(--tj-font-semibold);
  transition: color 0.3s ease;
}

.footer-back-top svg {
  background: var(--tj-inverse-alpha-05);
  border-radius: 50%;
  padding: 4px;
  width: 32px;
  height: 32px;
  border: 1px solid var(--tj-inverse-alpha-10);
  transition: color var(--tj-transition-smooth), background-color var(--tj-transition-smooth), border-color var(--tj-transition-smooth), transform var(--tj-transition-smooth);
}

.footer-back-top:hover {
  color: var(--tj-text-inverse);
}

.footer-back-top:hover svg {
  background: var(--tj-blue);
  border-color: var(--tj-blue);
  transform: translateY(-4px);
  color: var(--tj-text-on-brand);
}

@media (max-width: 767px) {
  .footer-container {
    padding: 48px 0 34px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .footer-col {
    gap: 0;
  }

  .footer-col--brand {
    padding-inline-end: 0;
  }

  .footer-title {
    display: none;
  }

  .footer-accordion-item {
    border: 1px solid var(--tj-inverse-alpha-07);
    border-radius: 20px;
    background: var(--tj-inverse-alpha-03);
    overflow: hidden;
  }

  .footer-accordion-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 54px;
    padding: 14px 16px;
    border: 0;
    color: var(--tj-text-inverse);
    background: transparent;
    text-align: start;
    font-size: .98rem;
    font-weight: var(--tj-font-bold);
  }

  .footer-accordion-trigger__icon {
    position: relative;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .footer-accordion-trigger__icon::before,
  .footer-accordion-trigger__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--tj-blue-light);
    transform: translate(-50%, -50%);
    transition: transform .2s ease;
  }

  .footer-accordion-trigger__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .footer-accordion-item.is-open .footer-accordion-trigger__icon::after {
    transform: translate(-50%, -50%) rotate(0);
  }

  .footer-panel {
    display: block;
    max-height: 0;
    overflow: hidden;
    padding: 0 16px;
    transition: max-height .26s ease, padding-bottom .26s ease;
  }

  .footer-accordion-item.is-open .footer-panel {
    max-height: 560px;
    padding-bottom: 18px;
  }

  .footer-logo {
    margin-bottom: 12px;
  }

  .footer-logo img {
    width: 132px;
  }

  .footer-desc {
    font-size: .9rem;
    line-height: 1.75;
  }

  .footer-disclaimer {
    margin-top: 14px;
    font-size: .72rem;
  }

  .footer-nav,
  .footer-list,
  .footer-contact {
    gap: 12px;
  }

  .footer-link {
    min-height: 34px;
  }

  .footer-contact li {
    align-items: flex-start;
    font-size: .9rem;
  }

  .footer-bottom {
    padding-bottom: calc(24px + env(safe-area-inset-bottom));
  }
}
</style>
