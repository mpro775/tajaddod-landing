---
import type { Locale } from '../../lib/api/types';
import { localePath } from '../../lib/content';
import { dictionary } from '../../i18n';
import { site, contactLinks } from '../../data/site';

const { locale } = Astro.props as { locale: Locale };
const copy = dictionary(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="container footer-grid">
    <div>
      <img src="/logos/tajaddod-logo-white.svg" alt={copy.brand} width="160" height="58" loading="lazy" />
      <p>{copy.footer.about}</p>
    </div>
    <nav aria-label={copy.nav.home}>
      <strong>{copy.nav.home}</strong>
      <a href={localePath(locale, '/projects')}>{copy.nav.projects}</a>
      <a href={localePath(locale, '/news')}>{copy.nav.news}</a>
      <a href={`${localePath(locale, '/')}#brands`}>{copy.nav.brands}</a>
    </nav>
    <div class="footer-contact">
      <strong>{copy.nav.contact}</strong>
      <a dir="ltr" href={contactLinks.email}>{site.email}</a>
      <a dir="ltr" href={contactLinks.whatsapp}>{site.whatsappDisplay}</a>
      <span>{locale === 'en' ? 'Sana’a, Yemen' : 'صنعاء، اليمن'}</span>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">© {year} {copy.brand}. {copy.footer.rights}</div>
  </div>
</footer>

<style>
  .site-footer{background:#04161d;color:#fff;padding-top:72px;margin-top:80px}
  .footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:60px;padding-bottom:56px}
  .footer-grid img{margin-bottom:18px}.footer-grid p{max-width:540px;color:rgba(255,255,255,.65);line-height:1.9}
  .footer-grid nav,.footer-contact{display:flex;flex-direction:column;gap:13px}
  .footer-grid strong{margin-bottom:8px}.footer-grid a,.footer-grid span{color:rgba(255,255,255,.7);text-decoration:none}
  .footer-grid a:hover{color:#fff}.footer-bottom{padding:22px 0;border-top:1px solid rgba(255,255,255,.09);color:rgba(255,255,255,.55)}
  @media(max-width:760px){.footer-grid{grid-template-columns:1fr;gap:34px}.site-footer{padding-top:52px}}
</style>
