---
import Layout from '../../../layouts/Layout.astro';
import NewsPage from '../../../components/pages/NewsPage.astro';
import { getArticles } from '../../../lib/api';
import { dictionary } from '../../../i18n';
const locale = 'en' as const;
const copy = dictionary(locale);
const query = {
  search: Astro.url.searchParams.get('search') || '',
  type: Astro.url.searchParams.get('type') || '',
  page: Astro.url.searchParams.get('page') || '1',
};
let collection;
let error: string | undefined;
try {
  collection = await getArticles(locale, { ...query, limit: 12 });
} catch (cause) {
  Astro.response.status = 503;
  error = cause instanceof Error ? cause.message : copy.common.unavailable;
}
---
<Layout locale={locale} title={`${copy.news.title} | ${copy.brand}`} description={copy.news.intro} canonicalPath="/en/news">
  <NewsPage locale={locale} collection={collection} error={error} query={query} />
</Layout>
