---
import Layout from '../../../layouts/Layout.astro';
import ArticleDetailPage from '../../../components/pages/ArticleDetailPage.astro';
import NotFound from '../../../components/pages/NotFound.astro';
import { ApiError, getArticle, getArticles } from '../../../lib/api';
import type { ArticleSummary } from '../../../lib/api';
import { dictionary } from '../../../i18n';
import { text } from '../../../lib/content';
const locale = 'en' as const;
const copy = dictionary(locale);
const slug = Astro.params.slug || '';
let article;
let related: ArticleSummary[] = [];
let error: string | undefined;
try {
  article = await getArticle(slug, locale);
} catch (cause) {
  Astro.response.status = cause instanceof ApiError && cause.status === 404 ? 404 : 503;
  error = cause instanceof Error ? cause.message : copy.common.unavailable;
}
if (article) {
  try {
    const collection = await getArticles(locale, {
      category: article.category || undefined,
      limit: 4,
    });
    related = collection.articles.filter((item) => item.slug !== article.slug).slice(0, 3);
  } catch (cause) {
    console.warn(
      `[landing] Related articles unavailable for "${slug}": ${
        cause instanceof Error ? cause.message : String(cause)
      }`,
    );
  }
}
const source = article;
const title = source ? text(source, 'metaTitle', locale) || text(source, 'title', locale) : copy.notFound.title;
const description = source ? text(source, 'metaDescription', locale) || text(source, 'excerpt', locale) : error || copy.notFound.description;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || Astro.url.origin).replace(/\/+$/, '');
const canonicalUrl = `${siteUrl}/en/news/${encodeURIComponent(slug)}`;
const structuredData = article ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: text(article, 'title', locale),
  description,
  url: canonicalUrl,
  inLanguage: 'en',
  image: article.cover?.url ? new URL(article.cover.url, `${siteUrl}/`).toString() : undefined,
  datePublished: article.publishDate || undefined,
  author: article.authorName ? { '@type': 'Person', name: article.authorName } : undefined,
  publisher: { '@type': 'Organization', name: copy.brand },
} : undefined;
---
<Layout locale={locale} title={`${title} | ${copy.brand}`} description={description} image={article?.cover?.url} canonicalPath={`/en/news/${slug}`} type="article" noindex={!article}>
  {structuredData && <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  {article ? <ArticleDetailPage locale={locale} article={article} related={related} /> : <NotFound locale={locale} message={error} />}
</Layout>
