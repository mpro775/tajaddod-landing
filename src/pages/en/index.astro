---
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/pages/HomePage.astro';
import { getWebsiteHome } from '../../lib/api';
import { dictionary } from '../../i18n';

const locale = 'en' as const;
const copy = dictionary(locale);
let home;
let error: string | undefined;
try {
  home = await getWebsiteHome(locale);
} catch (cause) {
  Astro.response.status = 503;
  error = cause instanceof Error ? cause.message : copy.common.unavailable;
}
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: copy.brand,
  url: import.meta.env.PUBLIC_SITE_URL || 'https://tagadodgroup.com/en',
  email: 'info@tagadodgroup.com',
};
---
<Layout locale={locale} title={copy.siteTitle} description={copy.siteDescription} canonicalPath="/en">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <HomePage locale={locale} home={home} error={error} />
</Layout>
