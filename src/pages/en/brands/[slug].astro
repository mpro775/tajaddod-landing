---
import Layout from '../../../layouts/Layout.astro';
import BrandPage from '../../../components/pages/BrandPage.astro';
import NotFound from '../../../components/pages/NotFound.astro';
import type { LandingProduct } from '../../../lib/api';
import { ApiError, getBrand, getWebsiteHome } from '../../../lib/api';
import { dictionary } from '../../../i18n';
import { text } from '../../../lib/content';
const locale = 'en' as const;
const copy = dictionary(locale);
const slug = Astro.params.slug || '';
let brand;
let products: LandingProduct[] = [];
let error: string | undefined;
try {
  const [brandResponse, home] = await Promise.all([getBrand(slug, locale), getWebsiteHome(locale)]);
  brand = brandResponse;
  products = home.products.filter((product) => product.brand?.slug === slug);
} catch (cause) {
  Astro.response.status = cause instanceof ApiError && cause.status === 404 ? 404 : 503;
  error = cause instanceof Error ? cause.message : copy.common.unavailable;
}
const source = brand;
const name = source ? text(source, 'name', locale, slug) : copy.notFound.title;
const description = source ? text(source, 'description', locale, copy.siteDescription) : error || copy.notFound.description;
---
<Layout locale={locale} title={`${name} | ${copy.brand}`} description={description} canonicalPath={`/en/brands/${slug}`} noindex={!brand}>
  {brand ? <BrandPage locale={locale} brand={brand} products={products} /> : <NotFound locale={locale} message={error} />}
</Layout>
