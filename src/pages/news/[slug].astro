---
import Layout from '../../layouts/Layout.astro';
import { news } from '../../data/news';
import { site } from '../../data/site';

export function getStaticPaths() {
  return news.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const siteUrl = site.url || 'https://tagadodgroup.com';
const imageUrl = `${siteUrl}${item.coverImage}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": item.title,
  "image": [imageUrl],
  "datePublished": item.date,
  "author": [{
      "@type": "Person",
      "name": item.author
  }],
  "publisher": {
    "@type": "Organization",
    "name": "تجدد",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/logos/tajaddod-icon.svg`
    }
  },
  "description": item.excerpt
};

// Get related news (excluding current one)
const relatedNews = news.filter(n => n.slug !== item.slug).slice(0, 2);
---

<Layout 
  title={`${item.title} | أخبار تجدد`} 
  description={item.excerpt}
  image={item.coverImage}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={item.date} />
    <meta property="article:section" content={item.category} />
  </Fragment>

  <main class="news-details-page">
    <article class="article-container">
      <header class="article-header">
        <div class="container">
          <div class="header-content">
            <span class="article-category">{item.category}</span>
            <h1 class="article-title">{item.title}</h1>
            <div class="article-meta">
              <span class="meta-item">
                <i class="icon-calendar"></i> {item.date}
              </span>
              <span class="meta-item">
                <i class="icon-user"></i> {item.author}
              </span>
            </div>
          </div>
        </div>
      </header>

      <div class="container article-body-container">
        <div class="article-cover">
          <img src={item.coverImage} alt={item.title} />
        </div>

        <div class="article-content-wrapper">
          <div class="article-text">
            {item.content.map(paragraph => (
              <p>{paragraph}</p>
            ))}
          </div>
          
          {item.gallery && item.gallery.length > 0 && (
            <div class="article-gallery">
              <h3>صور إضافية</h3>
              <div class="gallery-grid">
                {item.gallery.map(img => (
                  <div class="gallery-item">
                    <img src={img} alt="صورة توضيحية للخبر" loading="lazy" />
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </article>

    {relatedNews.length > 0 && (
      <section class="related-news section">
        <div class="container">
          <h2 class="section-title">أخبار ذات صلة</h2>
          <div class="news-grid">
            {relatedNews.map((related) => (
              <a href={`/news/${related.slug}`} class="news-card">
                <div class="news-card__image-wrap">
                  <img src={related.coverImage} alt={related.title} loading="lazy" />
                  <span class="news-card__category">{related.category}</span>
                </div>
                <div class="news-card__content">
                  <h3 class="news-card__title">{related.title}</h3>
                  <span class="news-card__date">{related.date}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .news-details-page {
    background: #040d12;
    min-height: 100vh;
    color: #fff;
    padding-bottom: 100px;
  }
  .article-header {
    padding: clamp(120px, 15vw, 160px) 0 clamp(40px, 6vw, 60px);
    text-align: center;
    background: linear-gradient(180deg, rgba(30,153,211,0.1) 0%, transparent 100%);
  }
  .header-content {
    max-width: 800px;
    margin: 0 auto;
  }
  .article-category {
    display: inline-block;
    padding: 6px 16px;
    background: var(--tj-primary);
    color: #fff;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: var(--tj-font-medium);
    margin-bottom: 24px;
  }
  .article-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: var(--tj-font-bold);
    line-height: 1.3;
    margin-bottom: 24px;
  }
  .article-meta {
    display: flex;
    justify-content: center;
    gap: 24px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 1rem;
  }
  .article-cover {
    width: 100%;
    max-height: 600px;
    border-radius: 24px;
    overflow: hidden;
    margin-bottom: 48px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }
  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-content-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }
  .article-text {
    font-size: 1.15rem;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.85);
  }
  .article-text p {
    margin-bottom: 24px;
  }
  
  .article-gallery {
    margin-top: 48px;
    padding-top: 48px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .article-gallery h3 {
    font-size: 1.5rem;
    margin-bottom: 24px;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .gallery-item {
    aspect-ratio: 16/9;
    border-radius: 12px;
    overflow: hidden;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-news {
    margin-top: 80px;
    padding-top: 80px;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  .section-title {
    font-size: 2rem;
    margin-bottom: 32px;
    text-align: center;
  }
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .news-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    transition: all 0.3s ease;
  }
  .news-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255,255,255,0.1);
  }
  .news-card__image-wrap {
    position: relative;
    aspect-ratio: 16/10;
  }
  .news-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .news-card__category {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--tj-primary);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
  }
  .news-card__content {
    padding: 20px;
  }
  .news-card__title {
    font-size: 1.2rem;
    margin-bottom: 8px;
    line-height: 1.4;
  }
  .news-card__date {
    color: rgba(255,255,255,0.5);
    font-size: 0.85rem;
  }
</style>
