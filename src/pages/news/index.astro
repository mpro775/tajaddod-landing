---
import Layout from '../../layouts/Layout.astro';
import { news } from '../../data/news';

// Categories for filter
const categories = ['الكل', 'أخبار الشركة', 'مشاريع', 'فعاليات', 'تدريب'];
---

<Layout title="أخبار تجدد | آخر المستجدات" description="تابع آخر مستجدات شركة تجدد في عالم الكهرباء والطاقة، وتعرف على أحدث مشاريعنا وفعالياتنا.">
  <main class="news-index">
    <div class="page-header">
      <div class="container">
        <h1 class="page-title">الأخبار والفعاليات</h1>
        <p class="page-desc">تابع مستجدات تجدد، المشاريع، الأنشطة التدريبية، والشراكات في مجال الكهرباء والطاقة.</p>
      </div>
    </div>

    <div class="container">
      <!-- Static filter UI -->
      <div class="filters">
        {categories.map((cat, index) => (
          <button class={`filter-btn ${index === 0 ? 'active' : ''}`} data-filter={cat === 'الكل' ? 'all' : cat}>
            {cat}
          </button>
        ))}
      </div>

      <div class="news-grid">
        {news.map((item) => (
          <a href={`/news/${item.slug}`} class="news-card" data-category={item.category}>
            <div class="news-card__image-wrap">
              <img src={item.coverImage} alt={item.title} loading="lazy" />
              <span class="news-card__category">{item.category}</span>
            </div>
            <div class="news-card__content">
              <div class="news-card__meta">
                <span class="meta-date">{item.date}</span>
              </div>
              <h2 class="news-card__title">{item.title}</h2>
              <p class="news-card__excerpt">{item.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const newsCards = document.querySelectorAll('.news-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filterValue = btn.getAttribute('data-filter');

      newsCards.forEach(card => {
        const cardCategory = card.getAttribute('data-category');
        if (filterValue === 'all' || filterValue === cardCategory) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .news-index {
    background: #040d12;
    min-height: 100vh;
    padding-bottom: 100px;
    color: #fff;
  }
  .page-header {
    padding: clamp(120px, 15vw, 160px) 0 clamp(60px, 8vw, 80px);
    text-align: center;
    background: linear-gradient(180deg, rgba(30,153,211,0.1) 0%, transparent 100%);
  }
  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: var(--tj-font-bold);
    margin-bottom: 24px;
  }
  .page-desc {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.8;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 48px;
  }
  .filter-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    padding: 10px 24px;
    border-radius: 999px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s ease;
  }
  .filter-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .filter-btn.active {
    background: var(--tj-primary);
    color: #fff;
    border-color: var(--tj-primary);
  }
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
  }
  .news-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    display: flex;
    flex-direction: column;
    transition: all 0.4s ease;
  }
  .news-card:hover {
    transform: translateY(-8px);
    border-color: rgba(30,153,211,0.3);
    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
  }
  .news-card__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16/10;
    overflow: hidden;
  }
  .news-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .news-card:hover .news-card__image-wrap img {
    transform: scale(1.05);
  }
  .news-card__category {
    position: absolute;
    top: 16px;
    right: 16px;
    background: var(--tj-primary);
    color: #fff;
    font-size: 0.8rem;
    font-weight: var(--tj-font-medium);
    padding: 6px 14px;
    border-radius: 999px;
  }
  .news-card__content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .news-card__meta {
    margin-bottom: 12px;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
  }
  .news-card__title {
    font-size: 1.4rem;
    font-weight: var(--tj-font-bold);
    margin-bottom: 12px;
    line-height: 1.4;
  }
  .news-card__excerpt {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
</style>
