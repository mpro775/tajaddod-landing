---
import Layout from '../../layouts/Layout.astro';
import NewsPage from '../../components/pages/NewsPage.astro';
import { getArticles } from '../../lib/api';
import { dictionary } from '../../i18n';
import { apiQuery, parseFilterQuery } from '../../lib/filters';

const locale = 'ar' as const;
const copy = dictionary(locale);
const query = parseFilterQuery(Astro.url.searchParams, ['search', 'type', 'category', 'page']);
let collection;
let error: string | undefined;
try {
  collection = await getArticles(locale, { ...apiQuery(query, ['search', 'type', 'category', 'page']), limit: 100 });
} catch (cause) {
  Astro.response.status = 503;
  error = cause instanceof Error ? cause.message : copy.common.unavailable;
}
---

<Layout locale={locale} title={`${copy.news.title} | ${copy.brand}`} description={copy.news.intro} canonicalPath="/news">
  <NewsPage locale={locale} collection={collection} error={error} query={query} />
</Layout>
