---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const siteUrl = site.url || 'https://tagadodgroup.com';

// Status badge color
const statusMap: Record<string, { color: string; bg: string }> = {
  'منجز': { color: '#8bc543', bg: 'rgba(139,197,67,0.12)' },
  'قيد التنفيذ': { color: '#ffb340', bg: 'rgba(255,179,64,0.12)' },
};
const statusStyle = statusMap[project.status] || statusMap['منجز'];

// Get related projects (same category, excluding current)
const relatedProjects = projects.filter(p => p.slug !== project.slug && p.category === project.category).slice(0, 2);
// If not enough from same category, add from other categories
const extraProjects = relatedProjects.length < 2 
  ? projects.filter(p => p.slug !== project.slug && p.category !== project.category).slice(0, 2 - relatedProjects.length) 
  : [];
const related = [...relatedProjects, ...extraProjects];

// Brand logo map
const brandLogos: Record<string, string> = {
  'CNC': '/assets/brands/cnc-logo.png',
  'Liper': '/assets/brands/liper-logo.png',
};
---

<Layout title={`${project.title} | مشاريع تجدد`} description={project.summary}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="og:image" content={`${siteUrl}${project.coverImage}`} />
  </Fragment>

  <main class="pd-page" id="project-detail-page">
    
    <!-- ═══ Cinematic Hero ═══ -->
    <section class="pd-hero">
      <div class="pd-hero__bg">
        <img src={project.coverImage} alt={project.title} />
        <div class="pd-hero__overlay"></div>
      </div>
      <!-- Animated grid pattern -->
      <div class="pd-hero__grid-pattern"></div>
      <!-- Energy lines -->
      <div class="pd-hero__lines">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <div class="container pd-hero__inner">
        <!-- Breadcrumb -->
        <nav class="pd-breadcrumb" aria-label="التنقل التفصيلي">
          <a href="/" class="pd-breadcrumb__link">الرئيسية</a>
          <svg class="pd-breadcrumb__sep" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          <a href="/projects" class="pd-breadcrumb__link">المشاريع</a>
          <svg class="pd-breadcrumb__sep" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          <span class="pd-breadcrumb__current">{project.title.length > 35 ? project.title.slice(0, 35) + '...' : project.title}</span>
        </nav>

        <!-- Category + Status -->
        <div class="pd-hero__badges">
          <span class="pd-badge pd-badge--category">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            {project.category}
          </span>
          <span class="pd-badge pd-badge--status" style={`--status-color: ${statusStyle.color}; --status-bg: ${statusStyle.bg}`}>
            <span class="pd-badge__dot"></span>
            {project.status}
          </span>
        </div>

        <h1 class="pd-hero__title">{project.title}</h1>
        <p class="pd-hero__summary">{project.summary}</p>

        <!-- Quick Stats Bar -->
        <div class="pd-stats-bar">
          <div class="pd-stat">
            <div class="pd-stat__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="pd-stat__text">
              <span class="pd-stat__label">الموقع</span>
              <span class="pd-stat__value">{project.location}</span>
            </div>
          </div>
          <div class="pd-stat__sep"></div>
          <div class="pd-stat">
            <div class="pd-stat__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div class="pd-stat__text">
              <span class="pd-stat__label">السنة</span>
              <span class="pd-stat__value">{project.year}</span>
            </div>
          </div>
          {project.stats && project.stats.map(stat => (
            <>
              <div class="pd-stat__sep"></div>
              <div class="pd-stat">
                <div class="pd-stat__icon pd-stat__icon--accent">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                </div>
                <div class="pd-stat__text">
                  <span class="pd-stat__label">{stat.label}</span>
                  <span class="pd-stat__value pd-stat__value--highlight">{stat.value}</span>
                </div>
              </div>
            </>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ Project Details Content ═══ -->
    <section class="pd-content">
      <div class="container">
        <div class="pd-content__layout">
          
          <!-- Main Content Column -->
          <div class="pd-main">
            <!-- Challenge Section -->
            {project.challenge && (
              <div class="pd-block pd-block--challenge">
                <div class="pd-block__header">
                  <div class="pd-block__icon pd-block__icon--red">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  </div>
                  <h2 class="pd-block__title">التحدي</h2>
                </div>
                <p class="pd-block__text">{project.challenge}</p>
              </div>
            )}

            <!-- Solution Section -->
            {project.solution && (
              <div class="pd-block pd-block--solution">
                <div class="pd-block__header">
                  <div class="pd-block__icon pd-block__icon--green">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  </div>
                  <h2 class="pd-block__title">الحل المقدم</h2>
                </div>
                <p class="pd-block__text">{project.solution}</p>
              </div>
            )}

            <!-- Gallery Section -->
            {project.gallery && project.gallery.length > 0 && (
              <div class="pd-block pd-block--gallery">
                <div class="pd-block__header">
                  <div class="pd-block__icon pd-block__icon--blue">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  </div>
                  <h2 class="pd-block__title">معرض الصور</h2>
                </div>
                <div class="pd-gallery-grid">
                  {project.gallery.map((img: string) => (
                    <div class="pd-gallery-item">
                      <img src={img} alt="صورة من المشروع" loading="lazy" />
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Sidebar Column -->
          <aside class="pd-sidebar">
            
            <!-- Scope Widget -->
            {project.scope && project.scope.length > 0 && (
              <div class="pd-widget" id="scope-widget">
                <h3 class="pd-widget__title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                  نطاق العمل
                </h3>
                <ul class="pd-scope-list">
                  {project.scope.map((item: string, i: number) => (
                    <li class="pd-scope-item" style={`--i: ${i}`}>
                      <span class="pd-scope-num">{String(i + 1).padStart(2, '0')}</span>
                      <span class="pd-scope-text">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Brands Widget -->
            {project.brands && project.brands.length > 0 && (
              <div class="pd-widget" id="brands-widget">
                <h3 class="pd-widget__title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                  العلامات التجارية المستخدمة
                </h3>
                <div class="pd-brands-grid">
                  {project.brands.map((brand: string) => (
                    <a href={`/brands/${brand.toLowerCase()}`} class="pd-brand-card" id={`brand-${brand.toLowerCase()}`}>
                      <div class="pd-brand-card__logo">
                        {brandLogos[brand] ? (
                          <img src={brandLogos[brand]} alt={brand} />
                        ) : (
                          <span class="pd-brand-card__fallback">{brand}</span>
                        )}
                      </div>
                      <span class="pd-brand-card__name">{brand}</span>
                      <svg class="pd-brand-card__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- Project Info Widget -->
            <div class="pd-widget" id="info-widget">
              <h3 class="pd-widget__title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                ملخص المشروع
              </h3>
              <ul class="pd-info-list">
                <li class="pd-info-item">
                  <span class="pd-info-label">التصنيف</span>
                  <span class="pd-info-value">{project.category}</span>
                </li>
                <li class="pd-info-item">
                  <span class="pd-info-label">الموقع</span>
                  <span class="pd-info-value">{project.location}</span>
                </li>
                <li class="pd-info-item">
                  <span class="pd-info-label">السنة</span>
                  <span class="pd-info-value">{project.year}</span>
                </li>
                <li class="pd-info-item">
                  <span class="pd-info-label">الحالة</span>
                  <span class="pd-info-value" style={`color: ${statusStyle.color}`}>{project.status}</span>
                </li>
                {project.stats && project.stats.map(stat => (
                  <li class="pd-info-item">
                    <span class="pd-info-label">{stat.label}</span>
                    <span class="pd-info-value pd-info-value--accent">{stat.value}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Contact CTA -->
            <div class="pd-widget pd-widget--cta" id="sidebar-cta">
              <div class="pd-widget-cta__glow"></div>
              <h3 class="pd-widget-cta__title">هل تريد مشروعاً مشابهاً؟</h3>
              <p class="pd-widget-cta__desc">فريقنا جاهز لتقديم دراسة مجانية لمشروعك</p>
              <a href="/#contact" class="button button-primary pd-widget-cta__btn">تواصل معنا</a>
            </div>

            <!-- Back to Projects -->
            <a href="/projects" class="pd-back-link" id="back-to-projects">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              العودة إلى المشاريع
            </a>
          </aside>
        </div>
      </div>
    </section>

    <!-- ═══ Related Projects ═══ -->
    {related.length > 0 && (
      <section class="pd-related" id="related-projects">
        <div class="container">
          <div class="pd-related__header">
            <span class="pd-related__eyebrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              مشاريع مشابهة
            </span>
            <h2 class="pd-related__title">اكتشف المزيد من أعمالنا</h2>
          </div>
          <div class="pd-related__grid">
            {related.map((rp) => (
              <a href={`/projects/${rp.slug}`} class="pd-related-card" id={`related-${rp.slug}`}>
                <div class="pd-related-card__img">
                  <img src={rp.coverImage} alt={rp.title} loading="lazy" />
                  <div class="pd-related-card__img-overlay"></div>
                  <div class="pd-related-card__badges">
                    <span class="pd-related-card__cat">{rp.category}</span>
                    <span class="pd-related-card__year">{rp.year}</span>
                  </div>
                </div>
                <div class="pd-related-card__body">
                  <h3 class="pd-related-card__title">{rp.title}</h3>
                  <div class="pd-related-card__meta">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span>{rp.location}</span>
                  </div>
                  <p class="pd-related-card__summary">{rp.summary}</p>
                  <span class="pd-related-card__cta">
                    عرض التفاصيل
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ═══ CTA Section ═══ -->
    <section class="pd-cta">
      <div class="container">
        <div class="pd-cta__box">
          <div class="pd-cta__glow-1"></div>
          <div class="pd-cta__glow-2"></div>
          <div class="pd-cta__content">
            <span class="pd-cta__eyebrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              ابدأ مشروعك معنا
            </span>
            <h2 class="pd-cta__title">هل تخطط لمشروع مشابه؟</h2>
            <p class="pd-cta__desc">فريقنا من المهندسين والخبراء مستعد لدراسة مشروعك وتقديم أفضل الحلول المتكاملة بأعلى معايير الجودة.</p>
          </div>
          <div class="pd-cta__actions">
            <a href="/#contact" class="button button-primary" id="cta-contact">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              تواصل معنا الآن
            </a>
            <a href="/projects" class="button pd-cta__ghost" id="cta-all-projects">جميع المشاريع</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════════════════
     Project Detail Page — Premium Cinematic Design
     ═══════════════════════════════════════════════════════════════════════ */

  .pd-page {
    background: #040d12;
    color: #fff;
    min-height: 100vh;
  }

  /* ─── Hero ──────────────────────────────────────────────────────────── */
  .pd-hero {
    position: relative;
    padding: clamp(130px, 18vw, 200px) 0 clamp(50px, 7vw, 80px);
    min-height: 65vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .pd-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .pd-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.6) brightness(0.45);
  }

  .pd-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(4,13,18,0.5) 0%, rgba(4,13,18,0.2) 25%, rgba(4,13,18,0.7) 60%, #040d12 100%),
      radial-gradient(ellipse at 10% 90%, rgba(30,153,211,0.2), transparent 50%),
      radial-gradient(ellipse at 90% 10%, rgba(139,197,67,0.1), transparent 50%);
  }

  .pd-hero__grid-pattern {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.04;
    background-image:
      linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 50% 60%, #000, transparent 70%);
    pointer-events: none;
  }

  .pd-hero__lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .pd-hero__lines span {
    position: absolute;
    height: 1.5px;
    width: 35vw;
    background: linear-gradient(90deg, transparent, rgba(30,153,211,0.5), rgba(139,197,67,0.3), transparent);
    animation: pdLineFlow 9s linear infinite;
    opacity: 0.35;
  }

  .pd-hero__lines span:nth-child(1) { top: 25%; right: -18vw; }
  .pd-hero__lines span:nth-child(2) { top: 55%; left: -20vw; animation-delay: -3s; }
  .pd-hero__lines span:nth-child(3) { top: 80%; right: 10vw; animation-delay: -6s; opacity: 0.2; }

  @keyframes pdLineFlow {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100vw); }
  }

  .pd-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  /* Breadcrumb */
  .pd-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
    font-size: 0.85rem;
  }

  .pd-breadcrumb__link {
    color: rgba(255,255,255,0.5);
    transition: color 200ms ease;
  }

  .pd-breadcrumb__link:hover {
    color: var(--tj-blue-light);
  }

  .pd-breadcrumb__sep {
    color: rgba(255,255,255,0.2);
    flex-shrink: 0;
  }

  .pd-breadcrumb__current {
    color: rgba(255,255,255,0.75);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 280px;
  }

  /* Badges */
  .pd-hero__badges {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .pd-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    border-radius: var(--tj-radius-pill);
    font-size: 0.85rem;
    font-weight: var(--tj-font-semibold);
  }

  .pd-badge--category {
    background: var(--tj-gradient-brand);
    color: #fff;
  }

  .pd-badge--category svg {
    opacity: 0.8;
  }

  .pd-badge--status {
    background: var(--status-bg);
    color: var(--status-color);
    border: 1px solid color-mix(in srgb, var(--status-color) 30%, transparent);
  }

  .pd-badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--status-color);
    animation: pdPulse 2s ease-in-out infinite;
  }

  @keyframes pdPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* Title */
  .pd-hero__title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: var(--tj-font-bold);
    line-height: 1.25;
    margin-bottom: 18px;
    letter-spacing: var(--tj-tracking-tight);
    max-width: 900px;
  }

  .pd-hero__summary {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.9;
    color: rgba(255,255,255,0.6);
    max-width: 750px;
    margin-bottom: 36px;
  }

  /* Stats Bar */
  .pd-stats-bar {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0;
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: var(--tj-radius-2xl);
    overflow: hidden;
    flex-wrap: wrap;
  }

  .pd-stat {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    flex: 1 1 auto;
    min-width: 160px;
  }

  .pd-stat__sep {
    width: 1px;
    height: 40px;
    background: rgba(255,255,255,0.08);
    flex-shrink: 0;
  }

  .pd-stat__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--tj-radius-md);
    background: rgba(30,153,211,0.1);
    color: var(--tj-blue);
    flex-shrink: 0;
  }

  .pd-stat__icon--accent {
    background: rgba(139,197,67,0.1);
    color: var(--tj-green-light);
  }

  .pd-stat__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pd-stat__label {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.4);
